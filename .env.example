# Production settings for `docker compose up -d` (compose.yaml). cp .env.example .env, then fill in POSTGRES_PASSWORD.
# .env is gitignored. Developers need no .env: make run / dev / demo use compose.dev.yaml and built-in defaults.

# REQUIRED. Letters and digits only (it goes into a URL):  openssl rand -hex 24
# compose refuses to start without it; there is no default. Changing it later does not change the password inside an existing database volume.
POSTGRES_PASSWORD=

# Only POSTGRES_PASSWORD, APP_BIND, APP_PORT and SECURE_COOKIES reach the app as they are; the other app settings below are
# read by compose.yaml once the matching commented line in its app `environment:` is uncommented.

# Set by compose.yaml itself (the database is the compose one, the mode is production); listed so nothing is undocumented:
# DATABASE_URL=postgres://bcm:<POSTGRES_PASSWORD>@postgres:5432/bcm?sslmode=disable
# APP_ENV=production

# Where the app listens on the host. Default 127.0.0.1:8080, for a reverse proxy on the same machine; 0.0.0.0 to listen on every interface.
# APP_BIND=127.0.0.1
# APP_PORT=8080

# Session, theme and glossary cookies are Secure and HSTS is sent: serve over HTTPS (a TLS-terminating reverse proxy). Behind one, true is the setting.
# The server refuses to start in production with SECURE_COOKIES=false unless ALLOW_INSECURE_COOKIES=true (plain http on a private network, a try-out).
SECURE_COOKIES=true
# ALLOW_INSECURE_COOKIES=false

# true only behind a reverse proxy that sets X-Forwarded-For itself (login attempts are then counted per client, not per proxy).
TRUST_PROXY=false

# off | report | enforce: Content-Security-Policy, see docs/operations.md, "Content-Security-Policy". Report-only for now.
CSP_MODE=report

# How many parsed rule sets (a few MB each) stay in memory, least recently used dropped first. Default 16, at least 1.
# MAX_CACHED_RULESETS=16

# A request that works longer than this is cancelled (its queries stop, the answer is 503). 0 = no limit. The live stream is exempt. Default 30s.
# REQUEST_TIMEOUT=30s

# Deadline of building a parsed rule set from its three files; a build that exceeds it fails (not cached), see docs/operations.md. Default 60s, at least 1s.
# RULES_BUILD_TIMEOUT=60s

# false: the server refuses to start on a database that is behind; run `docker compose run --rm app migrate` first.
# MIGRATE_ON_START=true

# Port inside the container (leave it; APP_PORT is the host side), and the static files' Cache-Control lifetime.
# PORT=8080
# Address the server listens on: empty is every interface, which the container needs (leave it; APP_BIND is the host side).
# make run, dev and demo default it to 127.0.0.1; LISTEN_HOST= here opens them to the network.
# LISTEN_HOST=
# STATIC_MAX_AGE=0s

# /styleguide and the development marks; development only.
# STYLEGUIDE=false

# Server-Timing header with time and database statements per answer, for tests/e2e/perf.mjs (development only; docs/performance.md).
# PERF_TRACE=false

# IANA zone for visitors with no account zone and no browser zone (UTC when empty).
# APP_TIMEZONE=Europe/Madrid
