# Caddy in front of the app: automatic HTTPS (Let's Encrypt), HTTP redirected to HTTPS, HTTP/2 and HTTP/3.
{
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Uploads of rules files are capped by the app at 16 MiB; nothing larger is forwarded.
	request_body {
		max_size 17MB
	}

	header {
		-Server
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
	}

	# The probes (and a future /metrics) are for the container network and the host only: the internet gets a 404, as for any unknown path.
	# The updater asks the app itself (docker compose exec app /app/server healthcheck), never through here.
	@ops path /healthz /readyz /metrics /metrics/*
	handle @ops {
		respond "Not Found" 404
	}

	# The app counts login attempts per client address: hand it the real peer, never what the client claims.
	handle {
		reverse_proxy app:8080 {
			header_up X-Forwarded-For {remote_host}
			# Live match streams (server-sent events) must not be buffered.
			flush_interval -1
		}
	}

	# The access log: JSON on stdout. The path of an invitation or recovery link is a secret. It is cut to /register/REDACTED wherever it
	# shows: the request line (also as the encoded ?next= of the login page a signed-out visitor is sent to), the Referer a page sends when
	# it loads its own assets, and the Location of that redirect. The app's own log does the same (logPath in middleware.go).
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp "(?i)(/|%2F)(register|recover|join)(/|%2F)[^/?#&%]*" "$1$2$3REDACTED"
			request>headers>Referer regexp "(?i)(/|%2F)(register|recover|join)(/|%2F)[^/?#&%]*" "$1$2$3REDACTED"
			resp_headers>Location regexp "(?i)(/|%2F)(register|recover|join)(/|%2F)[^/?#&%]*" "$1$2$3REDACTED"
		}
	}
}
