# /opt/bcm/.env of a server running the published image (mode 0600, owned by root). deploy/install.sh creates it with a generated
# POSTGRES_PASSWORD; bcm-update.sh keeps APP_IMAGE. It is never committed anywhere.

# The public host name Caddy serves and gets a certificate for. It must resolve to this server before the first start.
SITE_ADDRESS=bcm.example.org

# Generated on the host (openssl rand -hex 24). Letters and digits only: it goes into a URL.
POSTGRES_PASSWORD=

# Written by bcm-update.sh: ghcr.io/iuya/battle-company-manager-ce-v2@sha256:<digest of the release>.
APP_IMAGE=

# off | report | enforce (docs/operations.md, "Content-Security-Policy").
CSP_MODE=report

# 1 = bcm-update.sh verifies the cosign signature of the release image before it starts it and refuses an unsigned one; 0 or absent = no check.
# deploy/oracle/host-setup.sh installs cosign and sets 1. Needs the cosign binary on the host (docs/operations.md, "Signed images").
REQUIRE_SIGNATURE=0
