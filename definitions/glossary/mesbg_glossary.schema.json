{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mesbg_glossary.schema.json",
  "title": "MESBG rules glossary",
  "type": "object",
  "required": [
    "name",
    "version",
    "source",
    "terms"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Version of this glossary (ours, not the rulebook's); bump it when the content changes."
    },
    "source": {
      "type": "string"
    },
    "reference": {
      "type": "object",
      "description": "Structured tables of the rulebook that the terms only describe.",
      "required": ["toWound"],
      "properties": {
        "toWound": {
          "type": "object",
          "required": ["title", "term", "rulebookPage", "strengths", "defences", "cells", "notation", "notes"],
          "properties": {
            "title": {"type": "string"},
            "term": {"type": "string", "description": "The glossary term that describes the chart."},
            "rulebookPage": {"type": "integer"},
            "strengths": {"type": "array", "items": {"type": "integer"}, "minItems": 10, "maxItems": 10, "description": "Row labels: the attacker's Strength."},
            "defences": {"type": "array", "items": {"type": "integer"}, "minItems": 10, "maxItems": 10, "description": "Column labels: the target's Defence."},
            "cells": {
              "type": "array", "minItems": 10, "maxItems": 10,
              "description": "cells[s-1][d-1] is the roll for Strength s against Defence d.",
              "items": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "string", "pattern": "^([3-6]\\+|6\\+/[4-6]\\+|-)$"}}
            },
            "notation": {"type": "object", "additionalProperties": {"type": "string"}},
            "notes": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "category",
          "definition",
          "sources"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "section",
                "rulebookPage"
              ],
              "properties": {
                "section": {
                  "type": "string"
                },
                "rulebookPage": {
                  "type": "integer"
                }
              }
            }
          },
          "see": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Related terms of this file, in a meaningful order where there is one (the turn phases)."
          },
          "summarized": {
            "type": "boolean",
            "description": "True when the definition is a brief summary written by the curator instead of verbatim rulebook text."
          }
        }
      }
    }
  }
}
