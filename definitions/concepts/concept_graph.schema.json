{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "concept_graph.schema.json",
  "title": "Concept graph",
  "description": "The reviewed edges between the concepts of the three rules files (docs/concept-graph.md). Generated by tools/build_concept_graph.py. mentions and see are never stored: the app computes them from the text.",
  "type": "object",
  "required": ["name", "version", "builtFrom", "nodes", "edges", "ambiguous"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "builtFrom": {
      "type": "object",
      "description": "SHA-256 of each file with its insignificant white space removed: the hashes of the ruleset triple this graph describes.",
      "required": ["vanilla", "battleCompanies", "glossary"],
      "additionalProperties": false,
      "properties": {
        "vanilla": {"$ref": "#/$defs/hash"},
        "battleCompanies": {"$ref": "#/$defs/hash"},
        "glossary": {"$ref": "#/$defs/hash"}
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "name", "file", "textHash"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^(rule|term|item|unit|path|power|scenario):.+$", "description": "<kind>:<glossary term id>"},
          "kind": {"enum": ["rule", "term", "item", "unit", "path", "power", "scenario"]},
          "name": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "file": {"enum": ["vanilla", "battleCompanies", "glossary"], "description": "The file the term's text comes from."},
          "textHash": {"type": "string", "pattern": "^[0-9a-f]{16}$", "description": "First 16 hex digits of the SHA-256 of the term's text with white space collapsed (core.ConceptTextHash)."}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "type"],
        "additionalProperties": false,
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "type": {"enum": ["grants", "cancels", "lifts", "requires"]},
          "via": {"type": "string", "minLength": 1, "description": "A quote of the rule text, or a short description of the data field the edge comes from. Required for cancels, lifts and requires."}
        },
        "if": {"properties": {"type": {"enum": ["cancels", "lifts", "requires"]}}},
        "then": {"required": ["via"]}
      }
    },
    "ambiguous": {
      "type": "array",
      "description": "Names or aliases claimed by more than one node: the app never links them.",
      "items": {
        "type": "object",
        "required": ["alias", "candidates"],
        "additionalProperties": false,
        "properties": {
          "alias": {"type": "string"},
          "candidates": {"type": "array", "items": {"type": "string"}, "minItems": 2}
        }
      }
    }
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
