    · <a class="underline" href="https://creativecommons.org/licenses/by-nc-sa/4.0/" rel="noopener">CC BY-NC-SA 4.0</a>
    · <a class="underline" href="https://github.com/iuya/battle-company-manager-ce-v2" rel="noopener">Source</a>
  </p>
</footer>
{{end}}
