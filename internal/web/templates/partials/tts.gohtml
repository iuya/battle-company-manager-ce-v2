{{/* The copy button next to a company's name and its dialog (docs/tabletop-simulator.md). The dialog's content is fetched when it opens
     (htmx, tts_dialog below); static/js/tts.js copies, remembers the two switches and adds them to the requests. Its tooltip is plain CSS
     so it works outside the company component, on hover and on keyboard focus. */}}
{{define "tts_button"}}
<div class="inline-flex" x-data="{ open: false }" x-effect="document.body.classList.toggle('overflow-hidden', open)" @keydown.escape.window="if (open) open = false">
  <span class="group inline-flex">
    <button type="button" id="tts-open" class="btn btn-ghost !min-h-11 !min-w-11 !px-2 text-muted sm:!min-h-8 sm:!min-w-0" aria-label="Copy as an army list for Tabletop Simulator" aria-describedby="tts-tip" aria-haspopup="dialog"
            data-tts-open hx-get="{{.URL}}" hx-target="#tts-body" hx-swap="innerHTML" @click="open = true">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/></svg>
    </button>
    <span id="tts-tip" role="tooltip" class="pointer-events-none absolute left-0 top-full z-30 mt-1 hidden w-[min(22rem,calc(100vw-2rem))] rounded-md border border-line bg-surface p-3 text-sm text-fg shadow-lg group-hover:block group-focus-within:block">{{.Tip}}</span>
  </span>
  <div x-show="open" x-cloak x-transition.opacity class="fixed inset-0 z-[55] flex items-start justify-center overflow-y-auto bg-black/60 p-3 sm:p-6" @click.self="open = false">
    <div class="card relative my-4 w-full max-w-2xl !p-4 sm:!p-6" role="dialog" aria-modal="true" aria-labelledby="tts-title">
      <button type="button" class="absolute right-1 top-1 flex h-11 w-11 items-center justify-center rounded-md text-muted hover:bg-raised hover:text-fg" @click="open = false" aria-label="Close">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <div id="tts-body"><p class="text-muted" id="tts-title">Loading…</p></div>
    </div>
  </div>
</div>
{{end}}

{{define "tts_switch"}}
<label class="flex min-h-11 cursor-pointer items-start gap-3 py-1 text-sm">
  <input type="checkbox" role="switch" name="{{.Name}}" value="1" class="peer sr-only" {{if .On}}checked{{end}}>
  <span class="relative mt-0.5 h-6 w-11 shrink-0 rounded-full border border-line bg-raised transition-colors peer-checked:bg-accent peer-checked:[&>span]:translate-x-5 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent" aria-hidden="true">
    <span class="absolute left-0.5 top-0.5 h-4.5 w-4.5 rounded-full bg-surface shadow transition-transform"></span>
  </span>
  <span><span class="font-medium">{{.Label}}</span><span class="block text-xs text-muted">{{.Hint}}</span></span>
</label>
{{end}}

{{define "tts_dialog"}}
<h3 class="!text-2xl" id="tts-title" tabindex="-1">Army list for Tabletop Simulator</h3>
<p class="mt-1 text-sm text-muted">{{.Name}}{{if .Live}}, as it is in the match now{{end}}. The closest standard models, not Battle Companies profiles.</p>

<ol class="mt-3 list-decimal space-y-1 pl-5 text-sm" aria-label="How to use it in Tabletop Simulator">
  <li>In the MESBG FTC - Version 0.4 game, open the Notebook and add a tab titled <code class="font-mono">ArmyList</code>.</li>
  <li>Copy the list below and paste it into that tab, replacing its text.</li>
  <li>Press <strong>Spawn Army</strong> on the table.</li>
</ol>

{{if .Custom}}<div class="alert alert-warn mt-3" role="status"><strong>Changed rules file.</strong> This campaign uses a changed rules file, so some unit names may not exist in the mod.</div>{{end}}

<form class="mt-3 border-t border-line pt-2" hx-get="{{.URL}}" hx-trigger="change" hx-target="#tts-result" hx-select="#tts-result" hx-select-oob="#tts-names-result:outerHTML" hx-swap="outerHTML" data-tts-form aria-label="What the list contains">
  {{template "tts_switch" (dict "Name" "foot" "On" .Foot "Label" "Riders on foot" "Hint" "Add the on-foot figure of a rider whose model cannot dismount by changing its state.")}}
  {{template "tts_switch" (dict "Name" "mounts" "On" .Mounts "Label" "Mounts that fight as figures of their own" "Hint" "Add a figure for a mount with Attacks of its own, such as a Warg shown as a Fell Warg.")}}
</form>

<div id="tts-result" class="mt-2 space-y-3">
  {{if .HasList}}
  <div>
    <label for="tts-text" class="text-sm font-medium">The list</label>
    <textarea id="tts-text" readonly rows="{{.Rows}}" spellcheck="false" wrap="off" class="input mt-1 w-full font-mono text-sm leading-snug">{{.Export.Text}}</textarea>
  </div>
  <div class="flex flex-wrap items-center gap-3">
    <button type="button" class="btn btn-primary" data-tts-copy="tts-text" data-tts-status="tts-status" data-tts-models="{{.Reported}}">Copy to clipboard</button>
    <span id="tts-status" class="text-sm text-muted" role="status" aria-live="polite"></span>
  </div>
  {{else}}
  <p class="alert alert-info" role="status">None of these units has a standard model, so there is nothing to copy.</p>
  {{end}}

  <p class="text-sm" id="tts-count">
    <strong>{{.Export.Models}} model{{if ne .Export.Models 1}}s{{end}}</strong>{{if .Export.ExtraFigures}} + {{.Export.ExtraFigures}} extra figure{{if ne .Export.ExtraFigures 1}}s{{end}}{{end}}.
    Break Point: <strong>{{.Export.BreakPoint}}</strong> ({{.Export.BreakPercent}}% of {{.Export.Models}}).
    <span class="text-muted">The mod's own message counts every figure it spawns: it will report <strong class="text-fg">{{.Reported}} models</strong>{{if .Export.ExtraFigures}}, {{.Export.ExtraFigures}} more than the company has{{end}}.</span>
  </p>

  {{range .Groups}}
  <section class="rounded-md border border-line bg-surface p-3">
    <h4 class="text-sm font-semibold">{{.Title}}</h4>
    <p class="text-xs text-muted">{{.Hint}}</p>
    <ul class="mt-1 list-disc space-y-0.5 pl-5 text-sm">{{range .Notes}}<li>{{.}}</li>{{end}}</ul>
  </section>
  {{end}}
</div>

{{if .HasList}}
<section class="mt-6 border-t border-line pt-4" aria-labelledby="tts-names-title">
  <h4 class="text-lg font-semibold" id="tts-names-title">Name and describe the figures</h4>
  <p class="mt-1 text-sm text-muted">Optional. A small helper object gives each spawned figure the name and description of its card: points, stats, wargear, rules and injuries. Install it once; the list above works without it.</p>

  <form class="mt-2" hx-get="{{.URL}}" hx-trigger="change" hx-target="#tts-names-result" hx-select="#tts-names-result" hx-swap="outerHTML" data-tts-form>
    <fieldset class="text-sm">
      <legend class="font-medium">Rule texts in the descriptions</legend>
      <div class="mt-1 flex flex-wrap gap-x-5">
        {{range $v := list "none" "short" "full"}}
        <label class="flex min-h-11 cursor-pointer items-center gap-2"><input type="radio" name="rules" value="{{$v}}" class="h-4 w-4 accent-[var(--accent)]" {{if $.RulesIs $v}}checked{{end}}> {{if eq $v "none"}}None (names only){{else if eq $v "short"}}Short (first sentence){{else}}Full text{{end}}</label>
        {{end}}
      </div>
    </fieldset>
  </form>

  <div id="tts-names-result" class="mt-2 space-y-3">
    {{if .HasNames}}
    <div>
      <label for="tts-names-text" class="text-sm font-medium">The names (JSON)</label>
      <textarea id="tts-names-text" readonly rows="{{.NamesRows}}" spellcheck="false" wrap="soft" class="input mt-1 w-full break-all font-mono text-xs leading-snug">{{.NamesJSON}}</textarea>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <button type="button" class="btn btn-primary" data-tts-copy="tts-names-text" data-tts-status="tts-names-status" data-tts-what="names">Copy names</button>
      <span id="tts-names-status" class="text-sm text-muted" role="status" aria-live="polite"></span>
    </div>
    <p class="text-sm" id="tts-names-size"><strong>{{len .Names.Figures}} figure{{if ne (len .Names.Figures) 1}}s{{end}}</strong>, {{.NamesSize}} of {{.NamesLimit}} KB, rule texts: <strong>{{.Names.Rules}}</strong>.</p>
    {{range .NameGroups}}
    <section class="alert {{if eq .Title "Too large"}}alert-warn{{else}}alert-info{{end}}" role="status">
      <h5 class="text-sm font-semibold">{{.Title}}</h5>
      <p class="text-xs">{{.Hint}}</p>
      <ul class="mt-1 list-disc space-y-0.5 pl-5 text-sm">{{range .Notes}}<li>{{.}}</li>{{end}}</ul>
    </section>
    {{end}}
    {{end}}
  </div>

  <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm" aria-label="How to use the names in Tabletop Simulator">
    <li><strong>Install the helper once.</strong> <a class="font-medium" href="/tts/helper.zip" download id="tts-helper-link">Download the helper</a> and unzip it into the Saved Objects folder of Tabletop Simulator:
      <ul class="mt-1 list-disc space-y-0.5 pl-5 text-muted">
        <li>macOS: <code class="break-all font-mono text-xs">~/Library/Tabletop Simulator/Saves/Saved Objects</code></li>
        <li>Windows: <code class="break-all font-mono text-xs">Documents\My Games\Tabletop Simulator\Saves\Saved Objects</code></li>
        <li>Linux (not verified): <code class="break-all font-mono text-xs">~/.local/share/Tabletop Simulator/Saves/Saved Objects</code></li>
      </ul>
      In the game, open <strong>Objects &gt; Saved Objects</strong>, pick <em>BC names helper</em> and put the block on the table. It stays in the menu for every game.</li>
    <li>Add a second Notebook tab titled exactly <code class="font-mono">ArmyNames</code> and paste the names there (<strong>Copy names</strong> above). Do not paste them into <code class="font-mono">ArmyList</code>: the mod would spawn the lines as models.</li>
    <li>Spawn the army from <code class="font-mono">ArmyList</code> as above.</li>
    <li>Select your army (drag a box around it) and press <strong>Apply names</strong> on the helper block. A message tells how many figures were named. <strong>Re-apply</strong> sends the names again, also to figures already named, for example after the company changed.</li>
  </ol>

  <details class="mt-3 rounded-md border border-line bg-surface p-3">
    <summary class="cursor-pointer text-sm font-medium">Show the Lua (fallback, unverified)</summary>
    <div class="mt-2 space-y-2">
      <p class="text-xs text-muted">Without the file: put any block on the table, right-click it, Scripting, paste this script and press Save &amp; Play, before you spawn the army.</p>
      <label for="tts-lua-text" class="sr-only">The helper's Lua script</label>
      <textarea id="tts-lua-text" readonly rows="8" spellcheck="false" wrap="off" class="input w-full font-mono text-xs leading-snug">{{.Lua}}</textarea>
      <div class="flex flex-wrap items-center gap-3">
        <button type="button" class="btn btn-ghost" data-tts-copy="tts-lua-text" data-tts-status="tts-lua-status" data-tts-what="the Lua">Copy the Lua</button>
        <span id="tts-lua-status" class="text-sm text-muted" role="status" aria-live="polite"></span>
      </div>
    </div>
  </details>
</section>
{{end}}
{{end}}
