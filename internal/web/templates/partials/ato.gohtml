{{/* The Against the Odds card of the match page (docs/matches.md). Takes atoView. Empty when there is nothing to show. */}}
{{define "ato_card"}}{{$v := .}}
<div id="ato">
{{if .Show}}
<section class="card mt-6 space-y-4" aria-labelledby="ato-title">
  <h2 id="ato-title" class="!text-xl">Against the Odds</h2>
  {{with .Msg}}<div class="alert {{if $v.Error}}alert-danger{{else}}alert-success{{end}}" role="{{if $v.Error}}alert{{else}}status{{end}}">{{.}}</div>{{end}}
  {{if not .Eligible}}
    <p class="text-muted">{{.Why}}</p>
  {{else}}
    <p>{{.CompanyName}} is <strong>{{.Gap}}</strong> below {{.OppName}} ({{.OwnRating}} vs {{.OppRating}}).{{if .Editing}} Take bonuses until nothing else fits.{{else if not .Editor}} Only the lower rated company chooses bonuses.{{end}}</p>
    {{if .Locked}}<p class="text-sm text-muted" role="status">{{.LockedWhy}} The choice can no longer be changed.</p>{{end}}
    {{if .Editing}}{{template "ato_form" .}}
    {{else if .Waiting}}<p class="alert alert-info" role="status" data-ato-waiting>Waiting for {{.CompanyName}} to choose. Nothing can be noted until they confirm.</p>
    {{else if .NothingToBuy}}<p class="text-muted" data-ato-nothing>A gap of {{.Gap}} pays for no bonus: there is nothing to choose.</p>
    {{else}}
      <p data-ato-summary>{{.Summary}}</p>
      {{if .Chosen}}<p class="text-sm text-muted">Spent {{.Spent}} of {{.Gap}}.</p>{{end}}
      {{range .Selection.Items}}{{if .UnitID}}<p class="text-sm text-muted">{{$v.KitName .Kit}}: {{.Item}}{{with .Detail}} ({{.}}){{end}} goes to {{$v.ModelName .UnitID}}.</p>{{end}}{{end}}
      {{if .CanChange}}<form hx-post="/campaigns/{{.Campaign}}/matches/{{.MatchID}}/ato/change" hx-target="#ato" hx-swap="outerHTML" hx-sync="#ato-slot:replace"><input type="hidden" name="revision" value="{{.Revision}}"><button class="btn btn-secondary" data-ato-change>Change</button></form>{{end}}
    {{end}}
  {{end}}
</section>
{{end}}
</div>
{{end}}

{{define "ato_form"}}{{$v := .}}{{$base := printf "/campaigns/%d/matches/%d/ato" .Campaign .MatchID}}
<form hx-post="{{$base}}" hx-target="#ato" hx-swap="outerHTML" hx-sync="#ato-slot:replace" class="space-y-4" novalidate
  x-data="{ ...{{.State}},
    opt(key) { return this.opts.find(o => o.key === key) || { rating: 0 } },
    count(key) { return this.bonus.filter(k => k === key).length },
    get spent() { let n = this.kits.length * this.opt('toolKit').rating + this.wanderers.length * this.opt('wanderer').rating; for (const k of this.bonus) { if (k !== 'toolKit' && k !== 'wanderer') n += this.opt(k).rating } return n },
    get left() { return this.gap - this.spent },
    fits(n) { return n < this.left || (n === this.left && this.inclusive) },
    short(n) { return 'Can\'t pay: ' + (n - Math.max(this.left, 0)) + ' short' },
    get parts() { const p = []; if (this.kits.length) p.push({ name: this.opt('toolKit').name + ' x' + this.kits.length, n: this.kits.length * this.opt('toolKit').rating }); if (this.wanderers.length) p.push({ name: this.opt('wanderer').name + ' x' + this.wanderers.length, n: this.wanderers.length * this.opt('wanderer').rating }); for (const o of this.opts) { const c = this.count(o.key); if (c && o.key !== 'toolKit' && o.key !== 'wanderer') p.push({ name: o.name + (c > 1 ? ' x' + c : ''), n: c * o.rating }) } return p },
    more(o) { if (o.closed) return false; if (o.key === 'toolKit') return this.kits.length < this.maxKits; if (o.key === 'wanderer') return this.wanderers.length < this.maxWanderers; if (o.key === 'ambush') return this.ambushOk && !this.count(o.key); return o.repeatable || !this.count(o.key) },
    get remaining() { return this.opts.filter(o => this.more(o) && this.fits(o.rating)) },
    can(key) { const o = this.opt(key); return !o.closed && (this.bonus.includes(key) || this.fits(o.rating)) },
    canAdd(key) { const o = this.opt(key); return !o.closed && this.fits(o.rating) },
    add(key) { if (this.canAdd(key)) this.bonus.push(key) },
    less(key) { const i = this.bonus.indexOf(key); if (i >= 0) this.bonus.splice(i, 1) },
    row(key) { const o = this.opt(key); if (this.bonus.includes(key)) return 'ato-row-taken'; return !o.closed && this.fits(o.rating) ? 'ato-row-open' : 'ato-row-off' },
    reason(key) { const o = this.opt(key); if (o.closed || this.fits(o.rating)) return ''; if (!this.bonus.includes(key)) return this.short(o.rating); return o.repeatable ? 'No more: ' + (o.rating - Math.max(this.left, 0)) + ' short' : '' },
    canKit(key) { return this.kits.includes(key) || (this.kits.length < this.maxKits && this.fits(this.opt('toolKit').rating)) },
    canWanderer(name) { return this.wanderers.includes(name) || (this.wanderers.length < this.maxWanderers && this.fits(this.opt('wanderer').rating)) },
    get blockers() { const b = []; if (this.left < 0) b.push('The bonuses cost ' + (-this.left) + ' more than the gap: remove some.'); if (this.bonus.includes('toolKit') && !this.kits.length) b.push('Choose a kit or untick ' + this.opt('toolKit').name + '.'); if (this.bonus.includes('wanderer') && !this.wanderers.length) b.push('Choose a Wanderer or untick ' + this.opt('wanderer').name + '.'); if (this.bonus.includes('ambush') && !this.ambush) b.push('Choose the scenario for ' + this.opt('ambush').name + '.'); return b } }"
  x-effect="if (!bonus.includes('toolKit')) kits = []; if (!bonus.includes('wanderer')) wanderers = []; if (!bonus.includes('ambush')) ambush = ''">
  <input type="hidden" name="revision" value="{{.Revision}}">

  <div aria-live="polite">
    <p class="text-sm font-medium">Spent <span x-text="spent"></span> / {{.Gap}}, <span x-text="left"></span> left</p>
    <div class="mt-1 flex h-3 w-full overflow-hidden rounded-full border border-line bg-raised" role="img" :aria-label="'Spent ' + spent + ' of {{.Gap}}'">
      <template x-for="(p, i) in parts" :key="i"><span class="h-full border-r border-surface bg-accent" :style="'width:' + (p.n / {{.Gap}} * 100) + '%'" :title="p.name + ': ' + p.n"></span></template>
    </div>
    <ul class="mt-1 flex flex-wrap gap-x-3 text-xs text-muted"><template x-for="(p, i) in parts" :key="i"><li x-text="p.name + ' ' + p.n"></li></template></ul>
  </div>

  <div class="space-y-3">
    {{range .Options}}{{$o := .}}{{$hard := $v.HardReason .}}
    <div class="ato-row" :class="row({{jsstr .Key}})" data-ato-row="{{.Key}}">
      {{if .Repeatable}}
      {{/* A press adds one more and a "−" takes one away, as the Slain milestone of the sheet. */}}
      <template x-for="i in count({{jsstr .Key}})" :key="i"><input type="hidden" name="bonus" value="{{.Key}}"></template>
      <button type="button" class="ato-press" :disabled="!canAdd({{jsstr .Key}})" @click="add({{jsstr .Key}})" aria-label="{{.Name}}: one more" data-ato-add="{{.Key}}">
        <span class="min-w-0 flex-1"><span class="font-medium">{{.Name}}</span><span class="block text-sm text-muted">{{.Text}}</span></span>
        <span class="ato-price">{{.Rating}} each</span>
      </button>
      <span class="milestone-count" x-show="count({{jsstr .Key}}) > 0" x-cloak x-text="count({{jsstr .Key}})" data-ato-count="{{.Key}}"></span>
      <button type="button" class="milestone-less" aria-label="{{.Name}}: one fewer" x-show="count({{jsstr .Key}}) > 0" x-cloak @click="less({{jsstr .Key}})" data-ato-less="{{.Key}}">−</button>
      {{else}}
      <label class="flex min-h-11 items-start gap-3">
        <input type="checkbox" name="bonus" value="{{.Key}}" x-model="bonus" :disabled="!can({{jsstr .Key}})" class="mt-1 size-5 shrink-0 accent-accent">
        <span class="min-w-0 flex-1"><span class="font-medium">{{.Name}}</span><span class="block text-sm text-muted">{{.Text}}</span></span>
        <span class="ato-price">{{.Rating}}{{if or (eq .Key "toolKit") (eq .Key "wanderer")}} each{{end}}</span>
      </label>
      {{end}}
      {{with $hard}}<p class="ato-short mt-1">{{.}}</p>{{end}}
      <p class="ato-short mt-1" x-show="reason({{jsstr .Key}})" x-text="reason({{jsstr .Key}})" x-cloak data-ato-short></p>
      {{if and .Reason (not .Disabled)}}<p class="mt-1 text-sm text-muted" data-ato-practice>{{.Reason}}. It stays as entered and does nothing.</p>{{end}}

      {{if eq .Key "toolKit"}}
      <div class="mt-2 space-y-3" x-show="bonus.includes('toolKit')" x-cloak>
        <fieldset class="min-w-0 space-y-2"><legend class="text-sm font-medium">Kits ({{$v.ToolKitRating}} Rating each, up to {{$v.MaxKits}} different ones)</legend>
          {{range $v.Kits}}{{$k := .}}
          <label class="ato-row flex min-h-11 items-start gap-3" :class="kits.includes({{jsstr .Key}}) ? 'ato-row-taken' : canKit({{jsstr .Key}}) ? 'ato-row-open' : 'ato-row-off'">
            <input type="checkbox" name="kit" value="{{.Key}}" x-model="kits" :disabled="!bonus.includes('toolKit') || !canKit({{jsstr .Key}})" class="mt-1 size-5 shrink-0 accent-accent">
            <span class="min-w-0 text-sm"><span class="font-medium">{{.Name}}</span><span class="block text-muted">{{range $i, $it := .Items}}{{if $i}}, {{end}}{{$it.Item}}{{if gt $it.Count 1}} x{{$it.Count}}{{end}}{{end}}</span>
              <span class="ato-short mt-1" x-show="!canKit({{jsstr .Key}})" x-text="short(opt('toolKit').rating)" x-cloak></span></span>
          </label>
          {{end}}
        </fieldset>
        {{range $v.Kits}}{{$k := .}}
        <div class="space-y-2 rounded-md border border-line bg-surface p-3" x-show="kits.includes({{jsstr .Key}})" x-cloak>
          <h3 class="!text-base font-medium">{{.Name}}: who carries what</h3>
          {{range $ii, $it := .Items}}{{range $c := $v.Copies $it.Count}}
          {{$id := printf "%s-%d-%d" $k.Key $ii $c}}{{$a := $v.Assigned $k.Key $it.Item $c}}
          <div class="space-y-1" x-data="{ unit: '{{$a.UnitID}}' }">
            <label class="block text-sm font-medium" for="assign-{{$id}}">{{$it.Item}}{{if gt $it.Count 1}} ({{inc $c}} of {{$it.Count}}){{end}}{{if $it.HeroOnly}} <span class="text-muted font-normal">· Heroes only</span>{{end}} <span class="font-normal text-muted" x-show="unit === '0'"><span aria-hidden="true">●</span> not given yet, not in play</span></label>
            <select id="assign-{{$id}}" name="assign-{{$id}}" class="input" x-model="unit" :disabled="!kits.includes({{jsstr $k.Key}})">
              <option value="0">Not given to anybody yet</option>
              {{range $v.Models $it.HeroOnly}}<option value="{{.UnitID}}" {{if eq .UnitID $a.UnitID}}selected{{end}}>{{.Name}} · {{.Type}}</option>{{end}}
            </select>
            {{if $it.Detail}}<div class="field"><label for="detail-{{$id}}">Weapon it goes on</label><input id="detail-{{$id}}" name="detail-{{$id}}" maxlength="40" value="{{$a.Detail}}" class="input" :disabled="unit === '0'" placeholder="For example: Elven blade"></div>{{end}}
          </div>
          {{end}}{{end}}
        </div>
        {{end}}
      </div>
      {{else if eq .Key "wanderer"}}
      <fieldset class="mt-2 min-w-0 space-y-2" x-show="bonus.includes('wanderer')" x-cloak><legend class="text-sm font-medium">{{if gt $v.MaxWanderers 1}}Which Wanderers ({{.Rating}} Rating each whatever they cost alone, each one different){{else}}Which Wanderer ({{.Rating}} Rating here whatever it costs alone){{end}}</legend>
        {{range $v.Wanderers}}
        <label class="ato-row flex min-h-11 items-start gap-3" :class="wanderers.includes({{jsstr .Name}}) ? 'ato-row-taken' : canWanderer({{jsstr .Name}}) ? 'ato-row-open' : 'ato-row-off'">
          <input type="checkbox" name="wanderer" value="{{.Name}}" x-model="wanderers" :disabled="!bonus.includes('wanderer') || !canWanderer({{jsstr .Name}})" class="mt-1 size-5 shrink-0 accent-accent">
          <span class="min-w-0 text-sm"><span class="font-medium">{{.Name}}</span> <span class="text-muted"><s>{{.OwnPrice}}</s> · {{$o.Rating}} here</span>{{with .Summary}}<span class="block text-muted">{{.}}</span>{{end}}
            <span class="ato-short mt-1" x-show="!canWanderer({{jsstr .Name}}) && !fits(opt('wanderer').rating)" x-text="short(opt('wanderer').rating)" x-cloak></span></span>
        </label>
        {{end}}
      </fieldset>
      {{else if eq .Key "ambush"}}
      <div class="field mt-2" x-show="bonus.includes('ambush')" x-cloak>
        <label for="ato-ambush">Choose the scenario</label>
        <select id="ato-ambush" name="ambush" class="input" x-model="ambush" :disabled="!bonus.includes('ambush')">
          <option value="">Choose a scenario…</option>
          {{range $v.Groups}}<optgroup label="{{.Title}}">{{range .Scenarios}}<option value="{{.Name}}">{{.Name}}</option>{{end}}</optgroup>{{end}}
        </select>
        <p class="hint">It replaces the scenario that was rolled. Removing Ambush! brings the old one back.</p>
      </div>
      {{end}}
    </div>
    {{end}}
  </div>

  {{if not .HasScenario}}<p class="text-sm text-muted" data-ato-no-scenario>Choose the scenario first: the bonuses are chosen knowing it.</p>{{end}}
  <div role="status" class="space-y-2">
    <p class="alert alert-info" x-show="remaining.length" x-cloak data-ato-remaining>Still to take: <span x-text="remaining.map(o => o.name + ' (' + o.rating + ')').join(', ')"></span>. Every bonus that fits has to be taken.</p>
    <template x-for="b in blockers" :key="b"><p class="alert alert-info" x-text="b" data-ato-blocker></p></template>
    <p class="alert alert-success" x-show="!remaining.length && !blockers.length" x-cloak data-ato-complete>Nothing else fits.<span x-show="left > 0" x-text="' ' + left + ' Rating stays unspent.'"></span></p>
  </div>
  <div class="flex flex-wrap gap-2">
    <button class="btn btn-primary" data-ato-confirm {{if not .HasScenario}}disabled{{else}}:disabled="remaining.length > 0 || blockers.length > 0"{{end}}>Confirm bonuses</button>
  </div>
</form>
{{end}}
