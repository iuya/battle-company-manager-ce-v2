4.717-4.858-6.438-4.351-6.504zm114.324 20.18a27.478 27.478 0 0 0-3.815.36l8.868 44.189c8.918-3.028 16.653-9.237 16.664-21.704l98.074-16.554-.762-4.977-99.031 11.559c-3.064-7.706-10.268-13.092-19.998-12.873zm-16.016 15.418c-18.216 15.033-25.17 27.556-47.912 40.754-13.412-1.61-28.06-3.171-40.648-1.786-3.579 1.697-7.502 3.1-11.805 4.127l-1.256.301-46.709-2.353-2.342-4.73c-.717-1.45-1.386-2.901-2.027-4.352-24.9 6.797-37.561 21.942-61.703 34.795-17.846 4.527-37.748 4.582-55.336 3.001-17.57.8-38.588 29.853 9.965 27.817 29.17-.372 69.443-8.09 91.82-23.217-20.038 75.026-75.165 100.356-135.348 127.479-21.304 17.147-25.288 27.748-33.503 39.968-3.706 7.228 2.329 5.84 8.851 9.998 17.188-8.115 19.152-15.808 35.762-27.068 45.944-17.999 46.474-8.262 126.17-46.602 24.279-2.54 44.736-.656 67.023-9.173 2.686 38.16 7.697 41.45 5.176 81.3l54.014.776.545-11.078-31.74-8.426c8.77-42.552 8.966-59.96 3.55-97.137-.735-5.044-40.783-6.286-61.496-2.87 21.866-21.678 34.769-39.963 38.416-61.64 18.175 1.599 30.554 2.147 49.207-2.654 24.85-10.837 30.435-16.789 48.074-39.746zM18.12 399.212v18h472v-18z"/>{{else if eq . "hiking"}}<path d="M185 58.59c-15-.38-30 13.1-33.1 33.43-3.3 21.68 8.8 39.98 24.8 42.38 16 2.4 32.9-11.5 36.1-33.2 3.3-21.72-8.7-39.94-24.8-42.35-1-.15-2-.24-3-.26zm113.3 77.21l-17.2 5.2 8.3 28.1 18.9.5zm-144.6 7.6c-2.7 70.5-.4 140.9-3.6 202.5-15.8 35.8-36.7 70.2-50.38 99.2l25.68 12.4c20.8-33.7 42.2-68 55.2-102.9l11.3-63.4 53 45.9 16.2 88.1 29.3-5.8-17.6-100.6-58.1-53.6-9.3-86.4 48.1 31.3c26.7.9 45.1-1.9 69.6-5.7l1-16.3-70.8-2.1-46.5-42c-9.5 6.7-20.9 10-32.8 8.2-7.7-1.2-14.5-4.3-20.3-8.8zm-16.6 13l-40.47 11.7-5.96 85.5c13.53 6.7 31.03 11.6 43.23 3.4zm352.7 65.3l-95.7 78.1-32 51.9L324 222.5c-6.3.9-12.2 1.8-18 2.6l43.5 147.1-22.6 36.7-19.4 3.4 3.7 21.3-64.5 12.8-4.2-22.7-84.3 14.8c-9.5 15.6-17.1 27.9-26 42.2l-49.52-23.9-62.64 34.8H489.8z"/>{{else if eq . "padlock"}}<path d="M254.28 17.313c-81.048 0-146.624 65.484-146.624 146.406V236h49.594v-69.094c0-53.658 43.47-97.187 97.03-97.187 53.563 0 97.032 44.744 97.032 97.186V236h49.594v-72.28c0-78.856-65.717-146.407-146.625-146.407zM85.157 254.688c-14.61 22.827-22.844 49.148-22.844 76.78 0 88.358 84.97 161.5 191.97 161.5 106.998 0 191.968-73.142 191.968-161.5 0-27.635-8.26-53.95-22.875-76.78H85.155zM254 278.625c22.34 0 40.875 17.94 40.875 40.28 0 16.756-10.6 31.23-25.125 37.376l32.72 98.126h-96.376l32.125-98.125c-14.526-6.145-24.532-20.62-24.532-37.374 0-22.338 17.972-40.28 40.312-40.28z"/>{{end}}{{end}}

{{/* A game-icons.net icon. Takes {N: name, C: the svg classes}. */}}
{{define "gi_icon"}}<svg class="{{.C}}" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true">{{template "gi_path" .N}}</svg>{{end}}

{{/* The kind of unit as a filled game-icons.net icon (see static/img/CREDITS.md): a swordwoman (infantry), a cavalry charge
   (cavalry), a wolf head (beast), an orc head (monster) and a dragon head (monstrous cavalry). Takes a core.UnitKind. The
   earlier icons are in static/img/archive. */}}
{{define "kind_icon"}}
<span class="kind-icon flex shrink-0 items-center justify-center rounded-lg bg-raised text-fg" title="{{.Label}}" role="img" aria-label="{{.Label}}">
  {{template "gi_icon" (dict "N" (or (index (dict "cavalry" "cavalry" "beast" "wolf-head" "monster" "orc-head" "monstrous_cavalry" "dragon-head") (printf "%s" .)) "swordwoman") "C" "")}}
</span>
{{end}}

{{/* A military insignia for the unit's place in the company: three chevrons for the leader, two for a sergeant, one for another hero. Takes the role. */}}
{{define "role_insignia"}}
{{if eq (printf "%s" .) "leader"}}<svg class="insignia insignia-leader h-5 w-5 shrink-0" viewBox="0 0 512 512" fill="currentColor" role="img" aria-label="Leader"><title>Leader</title>{{template "gi_path" "rank-3"}}</svg>
{{else if eq (printf "%s" .) "sergeant"}}<svg class="insignia insignia-sergeant h-5 w-5 shrink-0" viewBox="0 0 512 512" fill="currentColor" role="img" aria-label="Sergeant"><title>Sergeant</title>{{template "gi_path" "rank-2"}}</svg>
{{else if eq (printf "%s" .) "hero"}}<svg class="insignia insignia-hero h-5 w-5 shrink-0" viewBox="0 0 512 512" fill="currentColor" role="img" aria-label="Hero"><title>Hero</title>{{template "gi_path" "rank-1"}}</svg>{{end}}
{{end}}

{{/* A class of equipment. Takes a core.EquipmentClass. */}}
{{define "eq_icon"}}
{{$gi := index (dict "mount" "horse-head" "melee" "sword-brandish" "two_handed" "battle-axe" "spear" "spears" "lance" "mounted-knight" "shield" "viking-shield" "armour" "kevlar" "bow" "high-shot" "crossbow" "crossbow" "throwing" "thrown-daggers" "missile" "striking-clamps" "banner" "flying-flag" "instrument" "horn" "consumable" "remedy") (printf "%s" .)}}
{{if $gi}}{{template "gi_icon" (dict "N" $gi "C" (printf "eq-ic eq-ic-%s h-4 w-4 shrink-0" .))}}{{else}}
<svg class="eq-ic eq-ic-{{.}} h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d="M12 4l8 8-8 8-8-8z"/>
</svg>{{end}}
{{end}}

{{/* Icons for specific items (a ring, a scroll, boots...), by key (core.IconFor). "generic-small" and "generic-large" draw any
   piece of equipment that has no icon of its own yet: a bag and a box. Most are game-icons.net icons (gi_path). */}}
{{define "item_icon"}}
{{$gi := index (dict "backpack" "backpack" "barding" "lorc-horse-head" "badge" "medal" "cloak" "cape" "blowpipe" "cannon-shot" "generic-small" "swap-bag" "generic-large" "cardboard-box-closed" "drum" "drum" "talisman" "gem-pendant" "map" "treasure-map" "boots" "boots" "brew" "beer-stein" "rope" "rope-coil" "herbs" "herbs-bundle" "belt" "belt" "torch" "torch" "snare" "wolf-trap" "pelt" "animal-hide" "axe" "magic-axe" "scroll" "tied-scroll" "orb" "dragon-orb" "warg" "wolf-head" "camel" "camel" "goat" "goat" "armoured-horse" "lorc-horse-head" "steed" "horse-head" "pony" "horse-head" "hammer" "warhammer" "hand-and-a-half" "blade-drag" "twin-blades" "crossed-swords" "claws" "claw-slashes" "glaive" "glaive" "halberd" "spears" "thrown-spear" "thrown-spear" "smoke-bomb" "unlit-bomb" "chain" "crossed-chains" "whip" "whip" "light-armour" "leather-vest" "heavy-armour" "breastplate" "small-shield" "round-shield" "pavise" "dragon-shield" "ring" "ring" "cram" "sandwich" "vial" "poison-bottle") .}}
{{if eq . "banner"}}{{template "eq_icon" "banner"}}{{else if or (eq . "horn") (eq . "instrument")}}{{template "eq_icon" "instrument"}}{{else if $gi}}{{template "gi_icon" (dict "N" $gi "C" (printf "eq-ic eq-ic-%s h-4 w-4 shrink-0" .))}}{{else}}
<svg class="eq-ic eq-ic-{{.}} h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d="M3 8l9-4 9 4v10l-9 4-9-4zM3 8l9 4 9-4M12 12v10"/>
</svg>{{end}}
{{end}}

{{/* The icon(s) of an item (core.Equipment or core.ArmouryItem): its own, or one per class (a blade-spear shows two). */}}
{{define "gear_icons"}}{{if .Icon}}{{template "item_icon" .Icon}}{{else}}{{range $i, $c := .Classes}}{{if $i}}<span class="eq-secondary" title="Also {{$c}}">{{template "eq_icon" $c}}</span>{{else}}{{template "eq_icon" $c}}{{end}}{{end}}{{end}}{{end}}

{{define "bolt_icon"}}<svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 2L5 13.5h5.5L9.5 22 19 9.5h-5.8z"/></svg>{{end}}

{{define "spell_icon"}}<svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2 6.5L20.5 10 14 12l-2 8-2-8-6.5-2L10 8.5z"/></svg>{{end}}

{{/* A hero's path as a game-icons.net icon in a round badge, one per path so they tell apart at a glance, coloured by the kind of
   hero it makes (pathLook, see static/img/CREDITS.md). Takes the path's name. */}}
{{define "path_icon"}}{{$l := pathLook .}}<span class="path-icon path-k-{{$l.Kind}}">{{template "gi_icon" (dict "N" $l.Icon "C" "")}}</span>{{end}}

{{/* The heading of a hero's path box: its icon and name, the "Path of the" lead small above the rest, and (with Tip) the path's
   text, limits and level-up chart in the tooltip. Takes {N: the name, Tip: the glossary text, Chart: tipPath's JSON, Short: on a
   unit card, the name alone (no lead) beside a smaller icon}; the box around it carries path-k-{kind} for its colour. */}}
{{define "path_name"}}{{$l := pathLook .N}}<span class="path-name{{if .Short}} path-name-short{{end}}" {{if .Tip}}tabindex="0" data-concept data-tip-title="{{.N}}" data-tip-meta="Hero's path" data-tip-text="{{.Tip}}"{{with .Chart}} data-tip-path="{{.}}"{{end}}{{end}}>{{template "path_icon" .N}}<span class="min-w-0">{{if not .Short}}{{with $l.Lead}}<span class="path-lead">{{.}} </span>{{end}}{{end}}<span class="path-main">{{$l.Main}}</span></span></span>{{end}}

{{/* A description with the glossary terms it mentions as links (previewed on hover). Takes {S: []segView, CID: campaign id}. */}}
{{define "segments"}}{{range .S}}{{if .TermID}}<a href="/campaigns/{{$.CID}}/glossary#t-{{.TermID}}" class="term-link" hx-boost="false" data-concept data-tip-title="{{.TipTitle}}" data-tip-text="{{.TipText}}">{{.Text}}</a>{{else}}{{.Text}}{{end}}{{end}}{{end}}

{{/* ---- The unit card. Takes {U: unitView, CID: campaign id}; the page's `company` component (static/js/company.js) expands it. ---- */}}
{{/* One item of a unit: its icon, name and numbers; the dashed border says it has a tooltip (rules, slot, numbers). */}}
{{/* A paw: the mark of a creature. */}}
{{define "paw"}}<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><ellipse cx="6" cy="10" rx="2" ry="2.6"/><ellipse cx="10.5" cy="6" rx="2" ry="2.6"/><ellipse cx="15.5" cy="6" rx="2" ry="2.6"/><ellipse cx="19" cy="10.5" rx="2" ry="2.6"/><path d="M12.5 12c-3 0-6 3.3-6 5.8 0 1.7 1.4 2.4 3 2.4 1.2 0 2-.5 3-.5s1.8.5 3 .5c1.6 0 3-.7 3-2.4 0-2.5-3-5.8-6-5.8z"/></svg>{{end}}

{{/* A small red cross, the mark of healing. */}}
{{define "cross"}}<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9 3h6v6h6v6h-6v6H9v-6H3V9h6z"/></svg>{{end}}

{{/* An item in the expanded card: takes {I: item, U: unit, CID: campaign id}. */}}
{{define "expanded_item"}}{{$u := .U}}{{$cid := .CID}}{{$co := .CO}}{{$ro := .RO}}{{with .I}}
        <li class="eq-{{.Class}} flex gap-2">
          <span class="mt-1 flex gap-0.5">{{template "gear_icons" .}}</span>
          <div class="min-w-0">
            <p class="font-medium">{{.Name}}{{with .Stats}} <span class="font-normal text-muted">{{.}}</span>{{end}} {{if .Bought}}<span class="badge">Bought</span>{{else}}<span class="badge badge-muted">Starting</span>{{end}}{{with .Size}} <span class="badge badge-muted">{{.}} slot</span>{{end}}</p>
            {{if .Segments}}<p class="text-sm text-muted">{{template "segments" (dict "S" .Segments "CID" $cid)}}</p>{{end}}
            {{if and .Choices (not .Modifies) (not $ro)}}<form data-lock class="mt-1 flex flex-wrap items-end gap-2" method="post" action="/campaigns/{{$cid}}/my-company/{{$co}}/units/{{$u.ID}}/equipment/weapon" hx-post="/campaigns/{{$cid}}/my-company/{{$co}}/units/{{$u.ID}}/equipment/weapon" hx-target="#main" hx-swap="innerHTML show:window:top">
              <input type="hidden" name="item" value="{{.Name}}">{{template "weapon_chooser" (dict "Weapons" .Choices "ID" (printf "weapon-%d-%s" $u.ID .Name) "Chosen" "")}}<button class="btn btn-ghost !min-h-8 !px-2 !text-xs">Choose weapon</button>
            </form>{{else if and .Choices (not .Modifies) $ro}}<p class="text-xs text-muted">No weapon chosen yet.</p>{{end}}
          </div>
          {{if .Drop}}<span class="ml-auto max-w-40 shrink-0 self-start text-right text-xs text-muted">{{if not $ro}}{{.Drop}}{{end}}</span>{{else if not $ro}}
          <form data-lock class="ml-auto shrink-0 self-start" method="post" action="/campaigns/{{$cid}}/my-company/{{$co}}/units/{{$u.ID}}/equipment/drop" hx-post="/campaigns/{{$cid}}/my-company/{{$co}}/units/{{$u.ID}}/equipment/drop" hx-target="#main" hx-swap="innerHTML show:window:top" hx-confirm="Drop {{.Name}}? It is lost for good and nothing is refunded.">
            <input type="hidden" name="item" value="{{.Name}}"><button class="btn btn-ghost !min-h-8 !px-2 !text-xs" title="Drop {{.Name}}">Drop</button>
          </form>{{end}}
        </li>
{{end}}{{end}}

{{define "gear_chip"}}
<li class="eq-chip eq-{{.Class}} {{if and .Bought (not .Size)}}is-bought{{end}} {{if or .Description .Size .MountStats}}has-tip{{end}} {{if or .Disabled .Struck}}text-muted line-through{{end}}" {{if .Disabled}}title="No benefit while the hero has {{.Disabled}}"{{else if .Struck}}title="{{.Struck}}" aria-label="{{.Name}}, {{.Struck}}"{{else if not (or .Description .Size .MountStats)}}title="{{.Name}}{{with .Stats}} · {{.}}{{end}}"{{end}} {{if or .Description .Size .MountStats}}tabindex="0" data-concept data-tip-title="{{.Name}}" data-tip-meta="{{if .Exclusive}}Company-exclusive · {{end}}{{if .MountStats}}Mount{{else if .Bought}}Bought{{else}}Starting equipment{{end}}{{with .Size}} · {{.}} slot{{end}}{{with .Stats}} · {{.}}{{end}}"{{with .TipStats}} data-tip-stats="{{.}}"{{end}} data-tip-text="{{.Description}}{{range $i, $r := .MountRules}}{{if $i}}, {{else}}

Special rules: {{end}}{{$r}}{{end}}"{{end}}>
  {{template "gear_icons" .}}<span>{{if and .Bought (not .Size)}}+ {{end}}{{if .Modifies}}{{.Modifies}} · envenomed{{else}}{{.Name}}{{if .Poisoned}} · poisoned{{end}}{{end}}</span>{{with .Stats}}<span class="text-muted">{{.}}</span>{{end}}
</li>
{{end}}

{{/* ---- Keywords (docs/unit-keywords.md). One chip: a race, faction or unit-type word. Takes {K: core.UnitKeyword, Part: "", Tip: bool}.
   With Tip it is a has-tip element like the rule chips (hover: tooltip, click/Enter: the helper popup); without it (the hover card of a
   unit preview, which cannot be pointed at) it is plain text. The group is in the shape (race solid, faction muted, type outlined) and in the label. ---- */}}
{{define "keyword_chip"}}{{$k := .K}}<li class="kw-chip kw-{{$k.Kind}}{{if .Tip}} has-tip{{end}}" aria-label="{{kwLabel $k .Part}}"{{if .Tip}} tabindex="0" data-concept="{{$k.Concept}}" data-tip-title="{{$k.Name}}" data-tip-meta="{{kwMeta $k .Part}}" data-tip-text="{{$k.Text}}"{{end}}>{{$k.Name}}</li>{{end}}

{{/* "Hatred (Orc) applies": the rules of your units in the live match that name a keyword of this enemy unit. Takes []core.RuleMatch (nil: nothing is
   drawn). Each marker is a has-tip element (hover/focus tooltip, Enter opens the helper popup on the rule); the text is in the badge, so colour is not
   the only signal. */}}
{{define "kw_applies"}}{{with .}}<ul class="mt-1.5 flex flex-wrap gap-1.5" aria-label="Rules of your units that apply to this unit" data-rule-matches>
  {{range .}}<li class="kw-applies has-tip" tabindex="0" data-concept="{{.Rule}}" data-tip-title="{{.Rule}} applies" data-tip-meta="Your {{joinNames .Holders}}" data-tip-text="{{.Text}}" data-rule-match="{{.Rule}}">{{.Label}}</li>{{end}}
</ul>{{end}}{{end}}

{{/* The keywords of an enemy unit in one flat line, no tips and no buttons (it sits inside a label or a one-line card). Takes core.UnitKeywords. */}}
{{define "keyword_flat"}}{{$v := kwRow . 99}}{{with $v.Shown}}<span class="kw-row" role="list" aria-label="Keywords" data-keywords-flat>{{range .}}<span class="kw-chip kw-{{.Kind}}" role="listitem" aria-label="{{kwLabel . ""}}">{{.Name}}</span>{{end}}</span>{{end}}{{end}}

{{/* The keyword row of a unit: at most 5 chips (race, factions, the unit types the kind icon and the insignia do not say: see notShownKeywords) and a +N
   button (the chips past five) that opens the full list in place (groups Race, Faction, Unit type). Takes {K: core.UnitKeywords, Open: an Alpine
   expression that keeps the full list open ("" for never; the expanded card passes "expanded === ID"), Static: true for the hover card (everything
   shown, no buttons, no tips)}. No row for a unit without chips. */}}
{{define "keyword_row"}}{{$v := kwRow .K 5}}{{if or $v.Shown $v.Race $v.Faction $v.Type}}{{$static := .Static}}{{$open := or .Open "false"}}
<div class="kw-block"{{if not $static}} x-data="{ all: false }"{{end}} data-keywords>
  {{if not $static}}<ul class="kw-row" aria-label="Keywords" x-show="!(all || {{$open}})">
    {{range $v.Shown}}{{template "keyword_chip" (dict "K" . "Part" "" "Tip" true)}}{{end}}
    {{if $v.More}}<li class="kw-item"><button type="button" class="kw-chip kw-more" @click.stop="all = true" :aria-expanded="all || {{$open}}">+{{$v.More}}<span class="sr-only"> more keywords, show all</span></button></li>{{end}}
  </ul>{{end}}
  <div class="kw-full" role="group" aria-label="All keywords"{{if not $static}} x-cloak x-show="all || {{$open}}"{{end}}>
    <dl class="kw-groups">
      {{with $v.Race}}<div><dt>Race</dt><dd><ul class="kw-row" aria-label="Race">{{range .}}{{template "keyword_chip" (dict "K" . "Part" "" "Tip" (not $static))}}{{end}}</ul></dd></div>{{end}}
      {{with $v.Faction}}<div><dt>Faction</dt><dd><ul class="kw-row" aria-label="Faction">{{range .}}{{template "keyword_chip" (dict "K" . "Part" "" "Tip" (not $static))}}{{end}}</ul></dd></div>{{end}}
      {{with $v.Type}}<div><dt>Unit type</dt><dd><ul class="kw-row" aria-label="Unit type">{{range .}}{{template "keyword_chip" (dict "K" . "Part" "" "Tip" (not $static))}}{{end}}</ul></dd></div>{{end}}
    </dl>
    {{if not $static}}<button type="button" class="btn btn-ghost !min-h-7 !px-2 !text-xs" x-show="!({{$open}})" @click.stop="all = false" aria-expanded="true">Fewer keywords</button>{{end}}
  </div>
</div>
{{end}}{{end}}

{{/* The aura chips of a unit (docs/aura-ranges.md): one chip per merged aura, like a rule chip. Takes core.Unit.Auras. At most 3 chips and a +N button that opens the rest in
   place (Alpine, no request). A ring the Tabletop Simulator dialog leaves off by default is muted and dashed; its tooltip says so. The kind is the ring's letter and line,
   not only its colour. Each chip is a has-tip element (tooltip, Enter opens the glossary popup of the rule). No row for a unit without an aura. */}}
{{define "aura_chip"}}{{$a := .A}}<li class="aura-chip aura-k-{{$a.Kind}}{{if auraOff $a}} aura-off{{end}} has-tip" {{if .Hide}}x-cloak x-show="more" {{end}}tabindex="0" aria-label="{{auraLabel $a}}"{{with $a.Concept}} data-concept="{{.}}"{{else}} data-concept{{end}} data-tip-title="{{$a.Label}}" data-tip-meta="{{auraMeta $a}}" data-tip-text="{{$a.Tip}}" data-aura="{{$a.ID}}">{{template "aura_ring" (dict "ID" $a.Kind "Letter" (auraLetter $a) "Thick" (auraThick $a))}}<span>{{auraText $a}}</span></li>{{end}}
{{define "aura_row"}}{{with .}}{{$v := auraRow . 3}}
<div class="mt-0.5" x-data="{ more: false }" data-auras>
  <ul class="flex flex-wrap items-center gap-1.5" aria-label="Auras">
    {{range $v.Shown}}{{template "aura_chip" (dict "A" . "Hide" false)}}{{end}}
    {{range $v.Rest}}{{template "aura_chip" (dict "A" . "Hide" true)}}{{end}}
    {{if $v.Rest}}<li x-show="!more"><button type="button" class="aura-more" @click.stop="more = true" :aria-expanded="more">+{{len $v.Rest}}<span class="sr-only"> more auras, show all</span></button></li>
    <li x-show="more" x-cloak><button type="button" class="aura-more" @click.stop="more = false" :aria-expanded="more">Fewer<span class="sr-only"> auras</span></button></li>{{end}}
  </ul>
</div>{{end}}{{end}}

{{define "unit_card"}}{{$ap := .AP}}{{$u := .U}}{{$cid := .CID}}{{$co := .CO}}{{$wcost := .WCost}}{{$lv := .LV}}{{$lu := .LU}}{{$rn := .RO}}{{$ro := or .RO $lv}}
<div class="unit-slot {{if $u.Injured}}unit-away{{end}}" data-unit-id="{{$u.ID}}" :style="expanded === {{$u.ID}} ? 'min-height:' + slotH + 'px' : ''">
<div class="unit-handle" x-show="formation" x-cloak>
  <span class="flex min-w-0 items-center gap-1.5"><svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="9" cy="6" r="1.6"/><circle cx="15" cy="6" r="1.6"/><circle cx="9" cy="12" r="1.6"/><circle cx="15" cy="12" r="1.6"/><circle cx="9" cy="18" r="1.6"/><circle cx="15" cy="18" r="1.6"/></svg><span class="truncate font-medium">{{$u.Title}}</span></span>
  <span class="flex shrink-0 gap-1">
    <button type="button" class="btn btn-ghost !min-h-7 !px-2" @click="move($el, -1)" aria-label="Move {{$u.Title}} earlier" title="Earlier">←</button>
    <button type="button" class="btn btn-ghost !min-h-7 !px-2" @click="move($el, 1)" aria-label="Move {{$u.Title}} later" title="Later">→</button>
  </span>
</div>
<article id="unit-{{$u.ID}}" class="card unit unit-{{$u.Role}} {{if $u.Injured}}unit-injured{{end}} flex flex-col gap-2 !p-4" :class="expanded === {{$u.ID}} && 'unit-expanded'">

  {{/* The expand button is part of the frame: a small tab flush in the top-right corner, taking no room from the content. */}}
  <button type="button" class="unit-corner" @click.stop="toggle({{$u.ID}}, $el)" :aria-expanded="expanded === {{$u.ID}}" :aria-label="expanded === {{$u.ID}} ? 'Close' : 'Expand unit'" :title="expanded === {{$u.ID}} ? 'Close' : 'Expand'">
    <svg x-show="expanded !== {{$u.ID}}" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>
    <svg x-show="expanded === {{$u.ID}}" x-cloak class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>

  {{/* Promotions waiting: the card's headline, not a footnote. The roll itself is not built yet. */}}
  {{if $ro}}{{else if $u.PathPending}}
  <button type="button" class="promo" hx-get="/campaigns/{{$cid}}/my-company/{{$co}}/units/{{$u.ID}}/path" hx-target="#modal-body" hx-swap="innerHTML" @click="openModal()">
    <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21v-8M12 13L6 7M12 13l6-6M6 11.5V7h4.5M18 11.5V7h-4.5"/></svg>
    <span class="min-w-0 flex-1 whitespace-nowrap">Choose a path</span>
    <span class="rounded-full bg-page px-2 py-0.5 text-xs text-fg">Required</span>
  </button>
  {{else if $u.PendingLevelUps}}
  <button type="button" class="promo" hx-get="/campaigns/{{$cid}}/my-company/{{$co}}/units/{{$u.ID}}/levelup" hx-target="#modal-body" hx-swap="innerHTML" @click="openModal()">
    <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 1.5l2.4 5.6 6.1.6-4.6 4 1.4 6-5.3-3.2-5.3 3.2 1.4-6-4.6-4 6.1-.6zM19 15l.9 2.1 2.1.9-2.1.9L19 21l-.9-2.1-2.1-.9 2.1-.9z"/></svg>
    <span class="min-w-0 flex-1 whitespace-nowrap">Level Up ready!{{if gt $u.PendingLevelUps 1}}<span class="ml-2 rounded-full bg-page/25 px-1.5" title="{{$u.PendingLevelUps}} level-ups waiting">×{{$u.PendingLevelUps}}</span>{{end}}</span>
    <span class="rounded-full bg-page px-2 py-0.5 text-xs text-fg">Roll</span>
  </button>
  {{end}}

  {{/* The title plate: what the unit is and its place in the company, tinted by that place. */}}
  <header class="unit-head flex items-start gap-2 [&_.kind-icon]:bg-surface">
    {{template "kind_icon" $u.Kind}}
    <div class="min-w-0 flex-1" {{if not $rn}}:class="editing === {{$u.ID}} && 'hidden'"{{end}}>
      {{/* The name is the way to rename the unit: a click opens the field (see the form below). */}}
      <h3 class="!text-xl leading-tight">{{if $rn}}{{$u.Title}}{{else}}<button type="button" class="unit-name" @click.stop="editName({{$u.ID}})" title="Click to rename" aria-description="Click to rename">{{$u.Title}}</button>{{end}}</h3>
      {{/* Always a second line, so every plate is the kind icon's height: the type (when the unit has its own name) and, against the
         right edge where they are easy to find, the points. */}}
      <p class="unit-sub mt-0.5 flex items-baseline justify-between gap-2 text-sm text-muted"><span class="min-w-0 truncate">{{if $u.Name}}{{$u.Type}}{{end}}</span><span class="shrink-0 whitespace-nowrap"><span class="font-semibold text-fg">{{$u.Points}}</span> pts</span></p>
    </div>
    {{/* The unit's place in the company, a large insignia alone on the right; a warrior has none and its name takes the room. */}}
    {{if ne (printf "%s" $u.Role) "warrior"}}<span class="unit-rank shrink-0 self-center [&>svg]:h-10 [&>svg]:w-10" {{if not $rn}}:class="editing === {{$u.ID}} && 'hidden'"{{end}}>{{template "role_insignia" $u.Role}}</span>{{end}}
    {{/* Renaming takes the plate beside the icon, the field across all of it: Enter or Save keeps the name, Escape or Cancel
       gives up, a click elsewhere saves a change. A :class, not x-show, so the field is there to focus at once. */}}
    {{if not $rn}}<form class="min-w-0 flex-1" :class="editing === {{$u.ID}} ? '' : 'hidden'" x-cloak @click.outside="leaveName($el)" method="post" action="/campaigns/{{$cid}}/my-company/{{$co}}/units/{{$u.ID}}/rename" hx-post="/campaigns/{{$cid}}/my-company/{{$co}}/units/{{$u.ID}}/rename" hx-target="#main" hx-swap="innerHTML">
      <input id="rename-{{$u.ID}}" name="name" value="{{$u.Name}}" maxlength="40" placeholder="{{$u.Type}}" autocomplete="off" aria-label="Name of this {{$u.Type}}" aria-describedby="rename-hint-{{$u.ID}}" class="input !min-h-10 w-full !py-1 font-heading !text-lg font-bold sm:!min-h-9" @keydown.escape.stop.prevent="editing = null">
      <p id="rename-hint-{{$u.ID}}" class="sr-only">Left empty, it is called {{$u.Type}}.</p>
      <div class="mt-1.5 flex items-center justify-end gap-1.5">
        <button type="button" class="btn btn-ghost !min-h-10 shrink-0 !px-2.5 !text-sm !text-fg sm:!min-h-8" @click="editing = null" title="Esc">Cancel</button>
        <button class="btn btn-primary !min-h-10 shrink-0 !px-3 !text-sm sm:!min-h-8" title="Enter">Save</button>
      </div>
    </form>{{end}}
  </header>

  <div class="unit-badges min-w-0">
      {{template "kw_applies" $ap}}
      {{if $u.Wanderer}}<p class="mt-1 flex flex-wrap items-center gap-1.5"><span class="badge badge-gold">Wanderer</span>{{if and $lu $lu.Temporary}}<span class="badge badge-gold" title="Taken with Against the Odds for this match only">Temporary</span>{{end}}</p>{{end}}
      {{if and $lu $lu.Temporary $lv.Wanderer}}<p class="mt-1 text-sm">{{$lv.Wanderer.Summary}}</p>{{end}}
      {{if and $lu $lv $lv.Broken}}<p class="mt-1">{{if $lv.CourageDue $lu}}<span class="badge !bg-danger-soft !text-danger" title="This unit tests Courage before it does anything else this turn">Test due</span>{{else}}<span class="badge badge-muted" title="Its courage is resolved for this turn">{{$lv.CourageChip $lu}}</span>{{end}}</p>{{end}}
      {{if and $lu $lu.HasMount (not $lu.Mounted)}}<p class="mt-1"><span class="badge badge-muted" title="The mount is lost: what needs it is struck through">On foot</span></p>{{end}}
      {{$warrior := eq (printf "%s" $u.Role) "warrior"}}
      {{if or $u.Injured $u.Injuries}}<p class="mt-1 flex flex-wrap items-center gap-1.5">
        {{if $u.Injured}}<span class="badge !bg-danger-soft !text-danger" title="Misses the next game and does not count towards the company's rating">Out next match</span>{{end}}
        {{range $u.Injuries}}<span class="badge !bg-danger-soft !text-danger has-tip" tabindex="0" data-concept data-tip-title="{{.Name}}" data-tip-meta="Injury{{if gt .Count 1}} · suffered {{.Count}} times{{end}}" data-tip-text="{{.Text}}">{{.Name}}{{if gt .Count 1}} ×{{.Count}}{{end}}</span>{{end}}
        {{if $ro}}{{else if $warrior}}{{if $u.Injured}}<form data-lock method="post" action="/campaigns/{{$cid}}/my-company/{{$co}}/units/{{$u.ID}}/treat" hx-post="/campaigns/{{$cid}}/my-company/{{$co}}/units/{{$u.ID}}/treat" hx-target="#main" hx-swap="innerHTML show:window:top" hx-confirm="Treat {{$u.Title}}'s injury for {{$wcost}} influence?"><input type="hidden" name="method" value="warrior"><button class="eq-add eq-heal" title="Treat injuries: {{$wcost}} influence, no roll" aria-label="Heal {{$u.Title}} for {{$wcost}} influence">{{template "cross"}}</button></form>{{end}}
        {{else}}<button type="button" data-lock class="eq-add eq-heal" hx-get="/campaigns/{{$cid}}/my-company/{{$co}}/units/{{$u.ID}}/treat" hx-target="#modal-body" hx-swap="innerHTML" @click="openModal()" title="Treat injuries" aria-label="Treat {{$u.Title}}'s injuries">{{template "cross"}}</button>{{end}}
      </p>{{end}}
      {{with $u.LostAbilities}}<p class="mt-1 text-xs text-muted">Lost: {{range $i, $l := .}}{{if $i}}, {{end}}{{if eq $l.Ability "standFast"}}Stand Fast!{{else if eq $l.Ability "heroicActionsOnCompany"}}heroic actions on the company{{else}}{{$l.Ability}}{{end}} ({{$l.Injury}}){{end}}</p>{{end}}
  </div>

  {{/* Attributes: the profile, then (for heroes) Might, Will and Fate. The backend decides which exist. */}}
  <div class="flex flex-wrap justify-center gap-x-3 gap-y-1.5" role="group" aria-label="Attributes">
    <dl class="statline">
      {{range $u.Stats}}{{if and (not .HeroOnly) (not (and $lu (liveStat .Name)))}}<div class="{{if .Gear}}ring-1 ring-inset ring-muted{{end}}" title="{{statTip .Name $u.StatMods}}"><dt>{{.Abbr}}</dt><dd class="{{if and (gt .Boost 0) (ne .Trail "+")}}tone-win{{else if and (lt .Boost 0) (eq .Trail "+")}}tone-win{{else if ne .Boost 0}}tone-loss{{end}}">{{.Value}}{{.Trail}}</dd></div>{{end}}{{end}}
    </dl>
    {{if and $u.HasHeroStats (not $lu)}}
    <dl class="statline statline-hero">
      {{range $u.Stats}}{{if .HeroOnly}}<div title="{{.Name}}"><dt>{{.Name}}</dt><dd class="{{if gt .Boost 0}}tone-win{{end}}">{{.Value}}</dd></div>{{end}}{{end}}
    </dl>
    {{end}}
  </div>
  {{range $u.StatMods}}{{if and (eq .Delta 0) .Note}}<p class="text-center text-xs text-muted" data-stat-note>{{.From}}: {{.Note}}</p>{{end}}{{end}}
  {{if $lu}}{{template "live_trackers" (dict "U" $u "L" $lu "LV" $lv "CID" $cid)}}{{end}}

  <div x-show="expanded !== {{$u.ID}}" class="unit-body">
    {{/* Wargear (what takes no slot: mount, weapons, armour) always in the same order (mount, melee, shield, armour, ranged, rest) so units
       compare at a glance; then the slots, and below them the equipment that takes them. Starting items are plain, bought ones carry a +. */}}
    <p class="flex items-center gap-1.5 text-xs text-muted"><span>Wargear</span>{{if and (not $u.Wanderer) (not $ro)}}<button type="button" data-lock class="eq-add eq-add-sm" hx-get="/campaigns/{{$cid}}/my-company/{{$co}}/units/{{$u.ID}}/armoury?kind=wargear" hx-target="#modal-body" hx-swap="innerHTML" @click="openModal()" aria-label="Buy wargear for {{$u.Title}}" title="Buy wargear">+</button>{{end}}</p>
    <ul class="flex flex-wrap items-center gap-1.5" aria-label="Wargear">
      {{range $u.Items}}{{if and (not .Upgrade) (not .Size)}}{{template "gear_chip" .}}{{end}}{{end}}
      {{with $u.Creature}}<li class="eq-chip has-tip" tabindex="0" data-concept data-tip-title="{{.Name}}" data-tip-meta="Creature · not a unit, no injuries" {{with $u.CreatureStats}}data-tip-stats="{{.}}" {{end}}data-tip-text="{{$u.CreatureTip}}">{{template "paw"}}<span>{{.Name}}</span></li>{{end}}
    </ul>
    {{if and $lu $lu.Loaned}}<ul class="flex flex-wrap items-center gap-1.5" aria-label="Loaned items">
      {{range loanedGroups $lu.Loaned}}<li class="eq-chip {{if .AllUsed}}text-muted line-through{{end}}" {{if .AllUsed}}aria-label="{{.Item}}, used"{{end}}><span>{{.Item}}{{if gt .Count 1}} ×{{.Count}}{{end}}{{with .Detail}} ({{.}}){{end}}</span> <span class="badge badge-gold">Loaned{{with .Kit}} ({{.}}){{end}}</span>{{if .AllUsed}} <span class="text-xs">used</span>{{else if .Used}} <span class="text-xs text-muted">{{.Used}} used</span>{{else if .AfterGame}} <span class="text-xs text-muted">use after the game</span>{{end}}</li>{{end}}
    </ul>{{end}}
    {{/* Named unit upgrades (Helmingas, Hearthguard...) are not gear: badges, not items. */}}
    <ul class="flex flex-wrap gap-1.5" aria-label="Unit upgrades">{{- range $u.Items}}{{if .Upgrade}}<li class="badge badge-gold{{if .Description}} has-tip{{end}}" {{if .Description}}tabindex="0" data-concept data-tip-title="{{.Name}}" data-tip-meta="Unit upgrade" data-tip-text="{{.Description}}"{{else}}title="Unit upgrade"{{end}}>{{.Name}}</li>{{end}}{{end -}}</ul>
    {{$sl := $u.Slots}}
    {{/* In a match nothing can be bought, so a unit with no equipment shows no Equipment line. */}}
    {{$hasEq := false}}{{range $u.Items}}{{if and (not .Upgrade) .Size}}{{$hasEq = true}}{{end}}{{end}}
    {{if or (not $lu) $hasEq}}
    <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted" aria-label="Equipment slots">
      <span class="inline-flex items-center gap-1.5"><span>Equipment</span>{{if and (not $u.Wanderer) (not $ro)}}<button type="button" data-lock class="eq-add eq-add-sm" hx-get="/campaigns/{{$cid}}/my-company/{{$co}}/units/{{$u.ID}}/armoury?kind=equipment" hx-target="#modal-body" hx-swap="innerHTML" @click="openModal()" aria-label="Buy equipment for {{$u.Title}}" title="Buy equipment">+</button>{{end}}</span>
      <span class="inline-flex items-center gap-1" title="Large slots used">Large {{range $i := seq 1 $sl.LargeMax}}<span class="pip {{if le $i $sl.LargeUsed}}pip-on{{end}}"></span>{{end}} <span>{{$sl.LargeUsed}}/{{$sl.LargeMax}}</span></span>
      <span class="inline-flex items-center gap-1" title="Small slots used">Small {{range $i := seq 1 $sl.SmallMax}}<span class="pip {{if le $i $sl.SmallUsed}}pip-on{{end}}"></span>{{end}} <span>{{$sl.SmallUsed}}/{{$sl.SmallMax}}</span></span>
    </p>
    <ul class="flex flex-wrap gap-1.5" aria-label="Equipment">
      {{range $u.Items}}{{if and (not .Upgrade) .Size}}{{template "gear_chip" .}}{{end}}{{end}}
    </ul>
    {{end}}

    {{/* A unit made of several models on one card: its parts, and how many models it counts as. */}}
    {{with $u.Parts}}<p class="flex flex-wrap items-center gap-1.5" aria-label="Made of"><span class="text-xs text-muted">One model, made of</span>{{range .}}<span class="eq-chip" {{if .Wargear}}title="{{join .Wargear ", "}}"{{end}}>{{.Count}}× {{.Name}}{{if .Wargear}} <span class="text-muted">({{join .Wargear ", "}})</span>{{end}}</span>{{end}}<span class="badge badge-muted">counts as {{$u.ModelCount}} models</span></p>{{end}}

    {{/* The hero's path, above the special rules: its icon and name (the tooltip has its chart), the heroic actions unlocked so far
       (also those bought later) and the rules it gave. */}}
    {{with $u.Path}}{{if .Name}}
    <div class="path-box path-k-{{(pathLook .Name).Kind}} space-y-1.5">
      {{template "path_name" (dict "N" .Name "Tip" .TipText "Chart" .TipPath "Short" true)}}
      {{if .Actions}}
      <ul class="flex flex-wrap gap-1.5" aria-label="Heroic actions">
        {{range .Actions}}
        <li class="act-chip act-{{.Source}}" {{if .Summary}}tabindex="0" data-concept data-tip-title="{{.Name}}" data-tip-meta="Heroic action · {{if eq (printf "%s" .Source) "bought"}}bought{{else if eq (printf "%s" .Source) "path"}}unlocked by the path{{else}}of the unit{{end}}" data-tip-text="{{.Summary}}"{{end}}>{{template "bolt_icon"}}<span>{{if eq (printf "%s" .Source) "bought"}}+ {{end}}{{.Name}}</span></li>
        {{end}}
      </ul>
      {{end}}
      {{if or .Rules .Powers}}
      <ul class="flex flex-wrap gap-1.5" aria-label="Rules and magical powers from the path">
        {{range .Rules}}<li class="rule-chip {{if eq (printf "%s" .Source) "company"}}rule-company{{else}}rule-path{{end}}" {{if .Description}}tabindex="0" data-concept data-tip-title="{{.Shown}}" data-tip-meta="{{if eq (printf "%s" .Source) "company"}}Company-exclusive hero upgrade{{else}}From the hero's path{{end}}" data-tip-text="{{.TipText}}"{{with .WorksLine}} data-tip-works="{{.}}"{{end}}{{end}}><span>{{.Shown}}</span></li>{{end}}
        {{range .Powers}}<li class="rule-chip rule-spell" {{if .Description}}tabindex="0" data-concept data-tip-title="{{.Name}}" data-tip-meta="Spell · cast {{.Casting}}+ · {{if .Range}}range {{.Range}}&quot;{{else}}self{{end}} · learned through the path" data-tip-text="{{.Description}}"{{end}}>{{template "spell_icon"}}<span>{{.Name}}</span><span class="font-semibold">{{.Casting}}+ · {{if .Range}}{{.Range}}"{{else}}self{{end}}</span></li>{{end}}
      </ul>
      {{end}}
    </div>
    {{end}}{{end}}

    {{/* Special rules: the unit's own, then its spells, then those from equipment (the path's are in its own box, just above). */}}
    <ul class="flex flex-wrap gap-1.5" aria-label="Special rules">
      {{range $u.Rules}}
      <li class="rule-chip rule-{{.Source}} {{if .Spell}}rule-spell{{end}} {{if .Struck}}text-muted line-through{{end}}" {{if .Struck}}aria-label="{{.Shown}}, {{.Struck}}"{{end}} {{if .Description}}tabindex="0" data-concept data-tip-title="{{.Shown}}" data-tip-meta="{{if .Spell}}Spell · cast {{.Casting}}+ · {{if .Range}}range {{.Range}}&quot;{{else}}self{{end}}{{else if .Mount}}Granted to the {{.Mount}}{{else if eq (printf "%s" .Source) "equipment"}}From {{.From}}{{else if eq (printf "%s" .Source) "company"}}Company-exclusive rule{{else}}Special rule{{end}}" data-tip-text="{{.TipText}}"{{with .WorksLine}} data-tip-works="{{.}}"{{end}}{{end}}>
        {{if .Spell}}{{template "spell_icon"}}{{end}}{{with .Mount}}<span class="text-muted">{{.}}:</span>{{end}}<span>{{.Shown}}</span>{{if .Spell}}<span class="font-semibold">{{.Casting}}+ · {{if .Range}}{{.Range}}"{{else}}self{{end}}</span>{{end}}
      </li>
      {{end}}
    </ul>
    {{template "aura_row" $u.Auras}}
  </div>

  {{/* Expanded: everything in full, no hovering needed (except for glossary terms, which are previewed). */}}
  <div x-show="expanded === {{$u.ID}}" x-cloak class="space-y-4">
    <section>
      <h4 class="!text-lg">Wargear</h4>
      <ul class="mt-1 space-y-2">
        {{range $u.Items}}{{if and (not .Upgrade) (not .Size)}}{{template "expanded_item" (dict "I" . "U" $u "CID" $cid "CO" $co "RO" $ro)}}{{end}}{{end}}
      </ul>
      <ul class="mt-2 flex flex-wrap gap-1.5" aria-label="Unit upgrades">{{- range $u.Items}}{{if .Upgrade}}<li class="badge badge-gold{{if .Description}} has-tip{{end}}" {{if .Description}}tabindex="0" data-concept data-tip-title="{{.Name}}" data-tip-meta="Unit upgrade" data-tip-text="{{.Description}}"{{end}}>{{.Name}} <span class="font-normal">· unit upgrade</span></li>{{end}}{{end -}}</ul>
    </section>
    <section>
      <h4 class="!text-lg">Equipment</h4>
      <ul class="mt-1 space-y-2">
        {{range $u.Items}}{{if and (not .Upgrade) .Size}}{{template "expanded_item" (dict "I" . "U" $u "CID" $cid "CO" $co "RO" $ro)}}{{end}}{{end}}
      </ul>
    </section>
    {{with $u.Path}}{{if .Name}}
    <section class="path-box path-k-{{(pathLook .Name).Kind}} space-y-2">
      <h4>{{template "path_name" (dict "N" .Name "Tip" .TipText "Chart" .TipPath)}}</h4>
      {{if .Actions}}
      <ul class="space-y-1.5">
        {{range .Actions}}
        <li class="act-chip act-{{.Source}} !block !rounded-lg !px-3 !py-2 !text-sm">
          <p class="flex flex-wrap items-center gap-x-2 font-medium">{{template "bolt_icon"}}{{.Name}} {{if eq (printf "%s" .Source) "bought"}}<span class="badge">Bought</span>{{else if eq (printf "%s" .Source) "path"}}<span class="badge badge-muted">Path</span>{{else}}<span class="badge badge-muted">Unit</span>{{end}}</p>
          {{if .Segments}}<p class="mt-1 text-muted">{{range .Segments}}{{.Text}}{{end}}{{if .TermID}} <a href="/campaigns/{{$cid}}/glossary#t-{{.TermID}}" class="term-link" hx-boost="false">Glossary</a>{{end}}</p>{{end}}
        </li>
        {{end}}
      </ul>
      {{end}}
      {{range .Rules}}
      <div class="rule-chip {{if eq (printf "%s" .Source) "company"}}rule-company{{else}}rule-path{{end}} !block !rounded-lg !px-3 !py-2 !text-sm">
        <p class="font-medium">{{.Shown}}{{if eq (printf "%s" .Source) "company"}} <span class="badge badge-gold">Company-exclusive hero upgrade</span>{{end}}</p>
        {{if .Segments}}<p class="mt-1 text-muted">{{template "segments" (dict "S" .Segments "CID" $cid)}}</p>{{end}}
        {{with .WorksLine}}<p class="mt-1 text-xs font-medium" data-works>{{.}}</p>{{end}}
      </div>
      {{end}}
      {{range .Powers}}
      <div class="rule-chip rule-spell !block !rounded-lg !px-3 !py-2 !text-sm">
        <p class="flex flex-wrap items-center gap-x-2 font-medium">{{template "spell_icon"}}{{.Name}} <span class="font-normal">Spell · cast {{.Casting}}+ · {{if .Range}}range {{.Range}}"{{else}}self{{end}}</span></p>
        {{if .Segments}}<p class="mt-1 text-muted">{{template "segments" (dict "S" .Segments "CID" $cid)}}</p>{{end}}
      </div>
      {{end}}
    </section>
    {{end}}{{end}}
    <section>
      <h4 class="!text-lg">Special rules</h4>
      <ul class="mt-1 space-y-2">
        {{range $u.Rules}}
        <li class="rule-chip rule-{{.Source}} {{if .Spell}}rule-spell{{end}} {{if .Struck}}text-muted line-through{{end}} !block !rounded-lg !px-3 !py-2 !text-sm">
          <p class="flex flex-wrap items-center gap-x-2 font-medium">{{if .Spell}}{{template "spell_icon"}}{{end}}{{.Shown}}
            {{if .Spell}}<span class="font-normal">Spell · cast {{.Casting}}+ · {{if .Range}}range {{.Range}}"{{else}}self{{end}}</span>{{else if .Mount}}<span class="badge badge-muted">Mount: {{.Mount}}</span>{{else if eq (printf "%s" .Source) "equipment"}}<span class="badge badge-muted">From {{.From}}</span>{{end}}</p>
          {{if .Segments}}<p class="mt-1 text-muted">{{template "segments" (dict "S" .Segments "CID" $cid)}}</p>{{end}}
          {{with .WorksLine}}<p class="mt-1 text-xs font-medium" data-works>{{.}}</p>{{end}}
        </li>
        {{end}}
      </ul>
    </section>
    {{with $u.Auras}}<section data-auras-full>
      <h4 class="!text-lg">Auras</h4>
      <ul class="mt-1 space-y-2" aria-label="Auras in full">
        {{range .}}
        <li class="aura-chip aura-k-{{.Kind}}{{if auraOff .}} aura-off{{end}} !flex !items-start !gap-2 !rounded-lg !px-3 !py-2 !text-sm" aria-label="{{auraLabel .}}">{{template "aura_ring" (dict "ID" .Kind "Letter" (auraLetter .) "Thick" (auraThick .))}}
          <div class="min-w-0"><p class="font-medium">{{auraText .}}{{with .Label}}: {{.}}{{end}}</p><p class="text-xs text-muted">{{auraMeta .}}</p><p class="mt-1 text-sm">{{.Tip}}</p></div>
        </li>
        {{end}}
      </ul>
    </section>{{end}}
  </div>

  {{/* Level and experience: 5 XP per level-up roll; a unit can have several rolls waiting, and only gains the level when it rolls (the promotion banner at the top). */}}
  <div class="unit-foot">
  {{if and $lv $lu}}{{template "live_actions_menu" (dict "U" $u "LV" $lv "L" $lu)}}{{end}}
  {{if $u.OwnPath}}
  <div class="mt-auto flex items-center justify-between gap-3 border-t border-line pt-2 text-xs"><span class="text-muted">On its own path: no experience</span></div>
  {{else if $u.Wanderer}}
  <div class="mt-auto flex items-center justify-between gap-3 border-t border-line pt-2 text-xs">
    <span class="text-muted">Mercenary: no experience</span>
    {{if and (not $ro) (not $lu)}}<form data-lock method="post" action="/campaigns/{{$cid}}/my-company/{{$co}}/units/{{$u.ID}}/dismiss" hx-post="/campaigns/{{$cid}}/my-company/{{$co}}/units/{{$u.ID}}/dismiss" hx-target="#main" hx-swap="innerHTML show:window:top" hx-confirm="Dismiss {{$u.Title}}? The influence is not returned."><button class="btn btn-ghost !min-h-8 !px-2 !text-xs">Dismiss</button></form>{{end}}
  </div>
  {{else}}
  <div class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-line pt-2 text-xs">
    <span class="level-medal" title="Level {{$u.Level}} · {{$u.XP}} XP in total"><span class="sr-only">Level </span>{{$u.Level}}</span>
    {{/* In a match the experience earned so far follows the bar's fill in the magic path's colour, up to the end of the level; the
       "+N" before the count says how much, also past the level. */}}
    {{$mxp := 0}}{{if $lu}}{{$mxp = $lu.MatchXP}}{{end}}
    <div class="xp-bar" style="--seg: {{$u.LevelEvery}}" role="progressbar" aria-valuemin="0" aria-valuemax="{{$u.LevelEvery}}" aria-valuenow="{{$u.XPInLevel}}"{{if $mxp}} aria-valuetext="{{$u.XPInLevel}} of {{$u.LevelEvery}}, {{$mxp}} more earned this match"{{end}} aria-label="Experience"><div class="h-full {{if $u.PendingLevelUps}}bg-warn{{else}}xp-fill{{end}}" style="width: {{pct $u.XPInLevel $u.LevelEvery}}%"></div>{{if $mxp}}<div class="xp-match h-full" style="width: {{pct (xpAhead $u.XPInLevel $u.LevelEvery $mxp) $u.LevelEvery}}%"></div>{{end}}</div>
    <span class="text-muted">{{if $mxp}}<span class="xp-match-text" title="Earned this match: added in the aftermath">+{{$mxp}}</span> {{end}}{{$u.XPInLevel}} / {{$u.LevelEvery}} XP</span>
  </div>
  {{end}}
  {{/* Keywords: race, factions and the types the icon and insignia do not say; a lost mount changes none of them. Seldom needed at
     the table, so small, in the bottom corner of the card, below the experience. */}}
  <div class="unit-kw">{{template "keyword_row" (dict "K" $u.Keywords "Open" (printf "expanded === %d" $u.ID))}}</div>
  </div>
</article>
</div>
{{end}}


{{/* A unit in the cemetery, as it was when it fell. It only looks: nothing can be bought or rolled for it. Takes {F: core.FallenUnit, Return: bool}; Return tags a fallen Ranger of the North a reinforcement may bring back (the Shire). */}}
{{define "fallen_card"}}{{$u := .F.Unit}}
<div class="unit-slot" data-unit-id="{{$u.ID}}">
<div class="unit-handle" x-show="editing" x-cloak>
  <span class="flex min-w-0 items-center gap-1.5"><svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="9" cy="6" r="1.6"/><circle cx="15" cy="6" r="1.6"/><circle cx="9" cy="12" r="1.6"/><circle cx="15" cy="12" r="1.6"/><circle cx="9" cy="18" r="1.6"/><circle cx="15" cy="18" r="1.6"/></svg><span class="truncate">{{$u.Title}}</span></span>
  <span class="flex shrink-0 gap-1">
    <button type="button" class="btn btn-ghost !min-h-7 !px-2" @click="move($el, -1)" aria-label="Move {{$u.Title}} earlier" title="Earlier">←</button>
    <button type="button" class="btn btn-ghost !min-h-7 !px-2" @click="move($el, 1)" aria-label="Move {{$u.Title}} later" title="Later">→</button>
  </span>
</div>
<article class="card unit unit-fallen flex flex-col gap-3 !p-4">
  <header class="unit-head flex items-start gap-2 [&_.kind-icon]:bg-surface">
    {{template "kind_icon" $u.Kind}}
    <div class="min-w-0 flex-1"><h3 class="flex items-center gap-1.5 !text-xl leading-tight">{{template "role_insignia" $u.Role}}{{$u.Title}}</h3>{{if $u.Name}}<p class="text-sm text-muted">{{$u.Type}}</p>{{end}}</div>
    <span class="shrink-0 text-sm font-semibold">{{$u.Points}} <span class="font-normal text-muted">pts</span></span>
  </header>
  <div>{{template "keyword_row" (dict "K" $u.Keywords)}}</div>
  <p class="rounded-lg border border-line bg-raised px-3 py-1.5 text-sm"><span class="font-semibold">Fell</span> · {{.F.Fate}}{{with .F.Match}} · <span class="text-muted">{{.}}</span>{{end}}{{if .Return}} <span class="badge badge-gold align-middle" title="The company's rule: a reinforcement result may be swapped for a new Ranger of the North, who returns as an officer (Leader to start with)">May return with a reinforcement</span>{{end}}</p>
  <div class="flex flex-wrap justify-center gap-2">
    <dl class="statline">{{range $u.Stats}}{{if not .HeroOnly}}<div><dt>{{.Abbr}}</dt><dd>{{.Value}}{{.Trail}}</dd></div>{{end}}{{end}}</dl>
    {{if $u.HasHeroStats}}<dl class="statline statline-hero">{{range $u.Stats}}{{if .HeroOnly}}<div><dt>{{.Name}}</dt><dd>{{.Value}}</dd></div>{{end}}{{end}}</dl>{{end}}
  </div>
  {{with $u.Equipment}}<p class="flex flex-wrap items-center gap-1.5"><span class="text-xs text-muted">Wargear</span>{{range .}}<span class="eq-chip">{{.Name}}</span>{{end}}</p>{{end}}
  {{with $u.Path}}{{if .Name}}<div class="path-box path-k-{{(pathLook .Name).Kind}} space-y-1.5">{{template "path_name" (dict "N" .Name "Short" true)}}
    <ul class="flex flex-wrap gap-1.5">{{range .HeroicActions}}<li class="act-chip">{{template "bolt_icon"}}<span>{{.Name}}</span></li>{{end}}{{range .Rules}}<li class="rule-chip rule-path" {{if .Description}}tabindex="0" data-concept data-tip-title="{{.Shown}}" data-tip-text="{{.TipText}}"{{with .WorksLine}} data-tip-works="{{.}}"{{end}}{{end}}>{{.Shown}}</li>{{end}}</ul></div>{{end}}{{end}}
  {{with $u.Rules}}<ul class="flex flex-wrap gap-1.5" aria-label="Special rules">{{range .}}<li class="rule-chip rule-{{.Source}}" {{if .Description}}tabindex="0" data-concept data-tip-title="{{.Shown}}" data-tip-text="{{.TipText}}"{{with .WorksLine}} data-tip-works="{{.}}"{{end}}{{end}}>{{.Shown}}</li>{{end}}</ul>{{end}}
  <p class="mt-auto flex items-center gap-3 border-t border-line pt-3 text-xs text-muted"><span class="level-medal" title="Level {{$u.Level}}"><span class="sr-only">Level </span>{{$u.Level}}</span>{{$u.XP}} XP</p>
</article>
</div>
{{end}}


{{/* The trackers of a unit in a running match, as segmented bars like the experience one (`.tracker*`, `.seg-hit` in tailwind.css), each led by
   the stat's full name: Might, Will and Fate for heroes, always in that order, then Wounds, the model's life, as hearts on a row of the same height; one stat per row, left-aligned so the bars line up and the counts form a column after the longest bar, each
   in its own colour in every theme (gold, blue, green, red). Wounds is always shown, also at 1 (a plain warrior): taking it to 0 is how
   the model falls (a Field casualty, like Died). The owner taps a segment: the last full one takes one off, the first empty one adds one, any other sets the value to that
   segment; everybody else only reads. Every tap is one entry in the match log, answered by the zones (htmx). Takes {U, L: core.LiveUnit, LV, CID}. */}}
{{define "live_trackers"}}{{$u := .U}}{{$l := .L}}{{$lv := .LV}}
{{$hero := and $u.HasHeroStats (or $l.Might.Start $l.Will.Start $l.Fate.Start)}}{{$wounds := gt $l.Wounds.Start 0}}
{{if or $hero $wounds}}
<div class="live-trackers" role="group" aria-label="Match trackers">
  {{if $hero}}
  {{template "live_tracker" (dict "S" "might" "N" "Might" "A" "Might" "T" $l.Might "U" $u "LV" $lv)}}
  {{template "live_tracker" (dict "S" "will" "N" "Will" "A" "Will" "T" $l.Will "U" $u "LV" $lv)}}
  {{template "live_tracker" (dict "S" "fate" "N" "Fate" "A" "Fate" "T" $l.Fate "U" $u "LV" $lv)}}
  {{end}}
  {{if $wounds}}{{template "live_tracker" (dict "S" "wounds" "N" "Wounds" "A" "Wounds" "T" $l.Wounds "U" $u "LV" $lv "Heart" true)}}{{end}}
</div>
{{end}}
{{end}}

{{/* One tracker: its name, a segment per point of the start value (a heart for Wounds) and the count. Above 10 segments it falls back to the number between
   - and +. */}}
{{define "live_tracker"}}{{$t := .T}}{{$lv := .LV}}{{$u := .U}}
{{if $t.Start}}
{{$base := printf "/campaigns/%d/matches/%d/live/%d/actions" .LV.CampaignID .LV.MatchID .LV.CompanyID}}
<div class="tracker" role="group" data-tracker="{{.S}}" aria-label="{{.N}} of {{$u.Title}}: {{$t.Current}} of {{$t.Start}}">
  <span class="tracker-label" title="{{.N}}" aria-hidden="true">{{.A}}</span>
  {{if le $t.Start 10}}
  <span class="tracker-bar">
  {{range $n := seq 1 $t.Start}}{{$on := le $n $t.Current}}
  {{if $lv.Edit}}<button type="button" class="seg-hit" {{if eq $n $t.Current}}aria-label="{{$.N}} of {{$u.Title}} down by one" hx-vals='{"kind":"stat","unit":"{{$u.ID}}","stat":"{{$.S}}","delta":"-1"}'{{else if eq $n (inc $t.Current)}}aria-label="{{$.N}} of {{$u.Title}} up by one" hx-vals='{"kind":"stat","unit":"{{$u.ID}}","stat":"{{$.S}}","delta":"1"}'{{else}}aria-label="Set {{$.N}} of {{$u.Title}} to {{$n}}" hx-vals='{"kind":"stat","unit":"{{$u.ID}}","stat":"{{$.S}}","set":"{{$n}}"}'{{end}} hx-post="{{$base}}" hx-target="#live-zones" hx-swap="outerHTML" hx-sync="#live-zones:queue all">{{template "tracker_seg" (dict "On" $on "Heart" $.Heart)}}</button>
  {{else}}<span class="seg-hit">{{template "tracker_seg" (dict "On" $on "Heart" $.Heart)}}</span>{{end}}
  {{end}}
  </span>
  <span class="tracker-count" aria-hidden="true">{{$t.Current}}/{{$t.Start}}</span>
  {{else}}
  <span class="tracker-bar items-center">
  {{if $lv.Edit}}<button type="button" class="btn btn-secondary !min-h-7 !min-w-7 !px-0" aria-label="{{.N}} of {{$u.Title}} down by one" hx-post="{{$base}}" hx-vals='{"kind":"stat","unit":"{{$u.ID}}","stat":"{{.S}}","delta":"-1"}' hx-target="#live-zones" hx-swap="outerHTML" hx-sync="#live-zones:queue all" {{if le $t.Current 0}}disabled{{end}}>−</button>{{end}}
  <span class="px-2 font-semibold {{if eq $t.Current 0}}text-danger{{end}}">{{$t.Current}}<span class="text-sm font-normal text-muted"> / {{$t.Start}}</span></span>
  {{if $lv.Edit}}<button type="button" class="btn btn-secondary !min-h-7 !min-w-7 !px-0" aria-label="{{.N}} of {{$u.Title}} up by one" hx-post="{{$base}}" hx-vals='{"kind":"stat","unit":"{{$u.ID}}","stat":"{{.S}}","delta":"1"}' hx-target="#live-zones" hx-swap="outerHTML" hx-sync="#live-zones:queue all" {{if ge $t.Current $t.Start}}disabled{{end}}>+</button>{{end}}
  </span>
  {{end}}
</div>
{{end}}
{{end}}

{{/* One segment of a tracker bar, or a heart for Wounds; full when On. */}}
{{define "tracker_seg"}}{{if .Heart}}<svg class="tracker-heart{{if .On}} is-on{{end}}" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.5s-7.6-4.6-9.5-9.3C1 7.6 3.2 4 6.8 4c2.1 0 3.8 1.2 5.2 3 1.4-1.8 3.1-3 5.2-3 3.6 0 5.8 3.6 4.3 7.2-1.9 4.7-9.5 9.3-9.5 9.3z"/></svg>{{else}}<span class="tracker-seg{{if .On}} is-on{{end}}"></span>{{end}}{{end}}

{{/* The weapon a rule with a weapon parameter (Poisoned Attacks) is given to: one of the unit's eligible weapons. Takes {Weapons, ID, Chosen}. */}}
{{define "weapon_chooser"}}<div class="field !mb-0"><label for="{{.ID}}" class="text-xs">Weapon</label><select id="{{.ID}}" name="weapon" class="input !min-h-9" required>{{if not .Chosen}}<option value="" disabled selected>Choose a weapon</option>{{end}}{{range .Weapons}}<option value="{{.}}" {{if eq . $.Chosen}}selected{{end}}>{{.}}</option>{{end}}</select></div>{{end}}

{{/* Why a weapon modifier (Envenom Weapon) cannot be bought: the unit has no weapon left it could be for. */}}
{{define "no_weapon_reason"}}No weapon left for {{.}}: every weapon of this unit is poisoned already or cannot be.{{end}}
