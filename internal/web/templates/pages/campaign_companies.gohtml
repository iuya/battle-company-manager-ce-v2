{{define "title"}}Companies · {{.Campaign.Name}} · Battle Companies 2nd CE Manager{{end}}
{{define "content"}}
{{template "campaign_header" .}}
{{if not .Mine}}
<div class="alert alert-info mt-6 flex flex-wrap items-center justify-between gap-3" role="status">
  <span>You have no company in this campaign yet.</span>
  <a href="/campaigns/{{.Campaign.ID}}/company/new" class="btn btn-primary">Create my company</a>
</div>
{{end}}
<ul class="mt-6 grid gap-3 sm:grid-cols-2">
  {{range .Companies}}
  <li>
    <a href="/campaigns/{{$.Campaign.ID}}/companies/{{.ID}}" class="card block !p-4 text-fg no-underline hover:bg-raised hover:no-underline">
      <div class="flex items-start justify-between gap-2">
        <h2 class="!text-xl">{{.Name}}</h2>
        {{if $.Campaign.Owns .ID}}<span class="badge shrink-0">Yours</span>{{end}}
      </div>
      <p class="text-sm text-muted">{{.FactionName}} · {{.Owner}}</p>
      <p class="mt-2 text-sm">{{template "points" .}} pts · {{.Units}} units · {{template "wdl" .}}</p>
    </a>
  </li>
  {{else}}<li class="text-muted">No companies have joined yet.</li>{{end}}
</ul>
{{end}}
