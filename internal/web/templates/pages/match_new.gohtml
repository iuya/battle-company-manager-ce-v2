{{define "title"}}New match · {{.Campaign.Name}} · Battle Companies 2nd CE Manager{{end}}
{{define "content"}}
<div class="max-w-3xl">
  <p class="text-sm"><a href="/campaigns/{{.Campaign.ID}}/matches">← {{.Campaign.Name}} · Matches</a></p>
  <h1 class="mt-2">New match</h1>
  {{if .TooFew}}
  <div class="card mt-6 space-y-2">
    <p>A match needs at least two companies and this campaign has {{.Companies}}.</p>
    <p class="text-sm text-muted">Each player creates at least one company from <strong>My Company</strong>; the organiser can invite players from the Overview. Come back when two companies exist.</p>
    <a href="/campaigns/{{.Campaign.ID}}/matches" class="btn btn-secondary">Back to the matches</a>
  </div>
  {{else}}
  <form method="post" action="/campaigns/{{.Campaign.ID}}/matches" hx-boost="false" class="mt-6 space-y-5"
        x-data="matchForm" data-companies="{{.CompaniesJSON}}" data-sides="{{.SidesJSON}}" data-ffa="{{.FFA}}" data-campaign="{{.Campaign.ID}}" data-max-sides="{{.MaxSides}}" data-practice="{{.Practice}}">
    {{with .Error}}<div class="alert alert-danger" role="alert">{{.}}{{with $.Busy}} <a href="/campaigns/{{$.Campaign.ID}}/matches/{{.MatchID}}" class="font-medium">Go to Match {{.Number}}</a>{{end}}</div>{{end}}
    <input type="hidden" name="sides" :value="visible.length">
    <input type="hidden" name="mode" :value="ffa ? 'ffa' : 'sides'">

    <div class="grid gap-4" :class="!ffa && 'md:grid-cols-2'">
      <template x-for="(side, i) in visible" :key="i">
        <section class="card space-y-3 !border-2 !border-t-8 !border-accent !p-4 !shadow-md" data-side-card @click.outside="side.open = false" :aria-label="ffa ? 'Everyone in the match' : 'Side ' + (i + 1)">
          <div class="flex items-center justify-between gap-2">
            <h2 class="!text-2xl text-accent-text" x-text="ffa ? 'Everyone in the match' : (side.ids.length ? sideLabel(side) : 'Side ' + (i + 1))"></h2>
            <button type="button" class="btn btn-ghost !min-h-11 !px-3 text-sm" x-show="!ffa && i >= 2" x-cloak @click="removeSide(i)" :aria-label="'Remove side ' + (i + 1)">Remove</button>
          </div>

          <ul class="flex flex-wrap gap-2" x-show="side.ids.length" aria-label="Companies on this side">
            <template x-for="id in side.ids" :key="id">
              <li class="flex items-center gap-1 rounded-full bg-accent-soft py-1 pl-3 pr-1 text-sm">
                <input type="hidden" :name="'side-' + (i + 1)" :value="id">
                <span class="font-medium" x-text="company(id).name"></span><span class="text-xs text-muted" x-text="company(id).owner"></span>
                <button type="button" class="flex h-7 w-7 items-center justify-center rounded-full hover:bg-raised" @click="remove(side, id)" :aria-label="'Remove ' + company(id).name">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
                </button>
              </li>
            </template>
          </ul>

          <p class="alert alert-info !py-2 text-sm" role="status" x-show="sameOnSide(side).length" x-cloak data-same-player><span x-text="sameOnSide(side).join('. ') + '.'"></span> Allowed: they stay two companies, each with its own aftermath.</p>

          <div class="relative" @keydown.escape="side.open = false">
            <input type="search" x-model="side.query" @focus="side.open = true" @input="side.open = true"
                   @keydown.enter="if (side.query.trim() && free(side, i).length) { $event.preventDefault(); add(side, free(side, i)[0].id); side.open = false }" placeholder="Search companies to add…" autocomplete="off"
                   class="input" role="combobox" :aria-label="'Search companies for ' + (ffa ? 'the match' : 'side ' + (i + 1))" :aria-expanded="side.open" aria-autocomplete="list">
            <ul x-show="side.open" x-cloak class="card absolute inset-x-0 z-10 mt-1 max-h-56 overflow-y-auto !p-1 shadow-lg" role="listbox">
              <template x-for="c in results(side, i)" :key="c.id">
                <li role="option" :aria-disabled="!!c.unavailable"><button type="button" class="flex w-full flex-col rounded-md border-l-4 px-3 py-2 text-left enabled:hover:bg-raised disabled:cursor-not-allowed" :class="c.mine ? 'border-accent' : 'border-transparent'" :disabled="!!c.unavailable" @click="add(side, c.id); side.open = false" :data-own="c.mine" :data-unavailable="!!c.unavailable">
                  <span class="flex flex-wrap items-center gap-2"><span class="font-medium" :class="c.unavailable && 'text-muted line-through'" x-text="c.name"></span><span class="badge" x-show="c.mine">Yours</span></span><span class="text-xs text-muted" :class="c.unavailable && 'line-through'" x-text="c.owner + ' · ' + c.faction"></span>
                  <span class="text-xs font-medium" x-show="c.unavailable" x-text="c.unavailable"></span>
                </button></li>
              </template>
              <li class="px-3 py-2 text-sm text-muted" x-show="results(side, i).length === 0">No matching companies left.</li>
            </ul>
            <button type="button" class="btn btn-secondary mt-2" x-show="ffa" @click="addAll(side)">Add every company</button>
          </div>
        </section>
      </template>
    </div>

    {{template "new_scenario" .Scenario}}

    <div class="card space-y-2" id="match-options">
      <div>
      <label class="flex items-start gap-3 py-2.5 text-sm sm:py-1">
        <input type="checkbox" name="practice" value="1" x-model="practice" class="h-5 w-5 shrink-0 accent-[var(--accent)]" data-practice-box>
        <span><span class="font-medium">Practice match</span> <span class="text-muted">· No experience, influence, rewards or injuries. The result is only recorded.</span></span>
      </label>
      <label class="flex items-start gap-3 py-2.5 text-sm sm:py-1">
        <input type="checkbox" class="h-5 w-5 shrink-0 accent-[var(--accent)]" :checked="ffa" @change="setFFA($event.target.checked)" data-ffa-box>
        <span><span class="font-medium">All vs all</span> <span class="text-muted">· every company fights on its own side (at least two)</span></span>
      </label>
      </div>
      <p class="alert alert-info !py-2 text-sm" role="status" x-show="practice" x-cloak>Nothing is rolled afterwards and no company is locked when it ends. The flag cannot be changed later: to change course, end the match and start a new one.</p>
      <button type="button" class="btn btn-secondary" x-show="!ffa" :disabled="sides.length >= maxSides" @click="addSide()" data-add-side>+ Add side</button>
      <p class="alert alert-info text-sm" role="status" x-show="sameAcross().length" x-cloak data-same-player><span x-text="sameAcross().join('. ') + '.'"></span> Allowed: <span x-show="!practice">it counts like any other match. </span><span x-show="!practice"><button type="button" class="underline" @click="practice = true" data-make-practice>Make it a practice match</button>.</span><span x-show="practice">it is a practice match.</span></p>
    </div>

    <div class="flex flex-wrap gap-2">
      <button class="btn btn-primary">Create match</button>
      <a href="/campaigns/{{.Campaign.ID}}/matches" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
  {{end}}
</div>
{{end}}

{{/* The scenario card of the new match form. Its hidden inputs (or the one-off fields) carry the scenario to Create match; every button
   answers the card again. Takes newScenarioView. */}}
{{define "new_scenario"}}{{$base := printf "/campaigns/%d/matches/new" .CampaignID}}
<section class="card space-y-3" id="new-scenario" aria-labelledby="new-scenario-title">
  <h2 id="new-scenario-title" class="!text-xl">Scenario</h2>
  {{if eq .Mode "custom"}}
    {{$e := .Err}}
    <input type="hidden" name="scenario-kind" value="custom">
    {{with index $e ""}}<div class="alert alert-danger" role="alert">{{.}}</div>{{end}}
    <div class="field">
      <label for="new-scenario-name">Name of the one-off scenario</label>
      <input id="new-scenario-name" name="scenario-name" value="{{.Custom.Name}}" maxlength="60" autocomplete="off" class="input" {{with index $e "name"}}aria-invalid="true"{{end}}>
      {{with index $e "name"}}<p class="error" role="alert">{{.}}</p>{{end}}
    </div>
    <div class="field">
      <label for="new-scenario-description">Description <span class="text-muted">(optional)</span></label>
      <textarea id="new-scenario-description" name="scenario-description" rows="3" maxlength="1000" class="input">{{.Custom.Description}}</textarea>
    </div>
    <div class="field">
      <label for="new-scenario-victory">How it is won <span class="text-muted">(optional)</span></label>
      <textarea id="new-scenario-victory" name="scenario-victory" rows="3" maxlength="1000" class="input">{{.Custom.Victory}}</textarea>
    </div>
    <div class="flex flex-wrap gap-2">
      <button type="button" class="btn btn-secondary" hx-post="{{$base}}/scenario-roll" hx-target="#new-scenario" hx-swap="outerHTML">Roll instead</button>
      <button type="button" class="btn btn-secondary" hx-get="{{$base}}/scenario?mode=pick" hx-target="#new-scenario" hx-swap="outerHTML">Choose from the rulebook</button>
    </div>
  {{else if eq .Mode "pick"}}
    {{with .Info}}<input type="hidden" name="scenario-kind" value="rulebook"><input type="hidden" name="scenario-name" value="{{.Name}}">{{if gt (index $.Dice 0) 0}}<input type="hidden" name="scenario-die" value="{{index $.Dice 0}}">{{end}}
    {{else}}{{with $.Custom.Name}}<input type="hidden" name="scenario-kind" value="custom"><input type="hidden" name="scenario-name" value="{{$.Custom.Name}}"><input type="hidden" name="scenario-description" value="{{$.Custom.Description}}"><input type="hidden" name="scenario-victory" value="{{$.Custom.Victory}}">{{end}}{{end}}
    {{if or .Info .Custom.Name}}<div class="flex items-center justify-between gap-2">
      <p class="min-w-0 break-words text-sm"><span class="text-muted">Now:</span> <span class="font-medium">{{with .Info}}{{.Name}}{{else}}{{.Custom.Name}}{{end}}</span></p>
      <button type="button" class="btn btn-ghost shrink-0" hx-get="{{$base}}/scenario" hx-include="#new-scenario" hx-target="#new-scenario" hx-swap="outerHTML" data-cancel-pick>Cancel</button>
    </div>{{end}}
    <div x-data="listSearch" class="space-y-3">
      <div class="field">
        <label for="new-scenario-search">Search the scenarios</label>
        <input id="new-scenario-search" type="search" x-model="q" placeholder="Name of a scenario…" autocomplete="off" class="input">
      </div>
      <p class="text-sm text-muted" x-show="noMatch()" x-cloak>No scenario matches.</p>
      {{$cur := ""}}{{with .Info}}{{$cur = .Name}}{{end}}
      {{range .Groups}}{{$title := .Title}}
      <div class="space-y-1" x-show="catShows({{jsstr $title}})">
        <p class="text-sm font-semibold text-muted">{{$title}}</p>
        <ul class="grid gap-1 sm:grid-cols-2">
          {{range .Scenarios}}<li data-name="{{.Name}}" data-category="{{$title}}" x-show="shows($el)">
            <button type="button" class="btn btn-secondary w-full !h-auto !min-h-11 !justify-start !whitespace-normal !px-3 !py-2 text-left {{if eq .Name $cur}}!border-accent !bg-accent-soft{{end}}" hx-get="{{$base}}/scenario?name={{.Name}}" hx-target="#new-scenario" hx-swap="outerHTML">
              <span class="min-w-0"><span class="font-medium">{{.Name}}</span>{{if .Roll}} <span class="text-xs font-normal text-muted">(second die {{.Roll}})</span>{{end}}</span>
            </button></li>{{end}}
        </ul>
      </div>
      {{else}}<p class="text-muted">The rules of this campaign list no scenarios.</p>{{end}}
    </div>
    <div class="flex flex-wrap gap-2">
      <button type="button" class="btn btn-secondary" hx-post="{{$base}}/scenario-roll" hx-target="#new-scenario" hx-swap="outerHTML">Roll instead</button>
      <button type="button" class="btn btn-secondary" hx-get="{{$base}}/scenario?mode=custom" hx-target="#new-scenario" hx-swap="outerHTML">One-off scenario</button>
    </div>
  {{else}}
    {{with .Info}}
    <input type="hidden" name="scenario-kind" value="rulebook"><input type="hidden" name="scenario-name" value="{{.Name}}">{{if gt (index $.Dice 0) 0}}<input type="hidden" name="scenario-die" value="{{index $.Dice 0}}">{{end}}
    <p class="text-lg font-medium break-words" data-scenario="{{.Name}}">{{.Name}}</p>
    <p class="text-sm text-muted">{{$.RollText}}</p>
    {{with .Scoring}}<p class="line-clamp-2 text-sm text-muted">{{index . 0}}</p>{{end}}
    {{else}}{{with $.Custom.Name}}
    <input type="hidden" name="scenario-kind" value="custom"><input type="hidden" name="scenario-name" value="{{$.Custom.Name}}"><input type="hidden" name="scenario-description" value="{{$.Custom.Description}}"><input type="hidden" name="scenario-victory" value="{{$.Custom.Victory}}">
    <p class="text-lg font-medium break-words">{{.}} <span class="badge badge-gold align-middle">One-off</span></p>
    {{else}}<p class="text-muted">{{with $.Note}}{{.}}{{else}}No scenario yet.{{end}}</p>{{end}}{{end}}
    <div class="flex flex-wrap gap-2">
      <button type="button" class="btn btn-secondary" hx-post="{{$base}}/scenario-roll" hx-target="#new-scenario" hx-swap="outerHTML" data-roll-again>Roll again</button>
      <button type="button" class="btn btn-secondary" hx-get="{{$base}}/scenario?mode=pick" hx-include="#new-scenario" hx-target="#new-scenario" hx-swap="outerHTML" data-choose-another>Choose another</button>
      <button type="button" class="btn btn-secondary" hx-get="{{$base}}/scenario?mode=custom" hx-target="#new-scenario" hx-swap="outerHTML">One-off scenario</button>
    </div>
  {{end}}
</section>
{{end}}
