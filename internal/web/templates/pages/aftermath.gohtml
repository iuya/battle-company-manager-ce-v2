{{define "title"}}Aftermath · {{.Company.Name}} · Match {{.Match.Number}} · Battle Companies 2nd CE Manager{{end}}
{{define "content"}}
<p class="text-sm"><a href="/campaigns/{{.Campaign.ID}}/matches/{{.Match.ID}}">← Match {{.Match.Number}}</a></p>
{{template "aftermath_body" .}}
{{end}}

{{/* Everything below the back link. Every write answers with this alone and htmx swaps it for #aftermath-page. */}}
{{define "aftermath_body"}}
<div id="aftermath-page">
{{if .Locked}}
  <h1 class="mt-2">Aftermath · {{.Company.Name}}</h1>
  <div class="alert alert-info mt-4" role="status">{{.Locked}}</div>
{{else if .A.Practice}}
{{with .Notice}}<div class="alert {{if $.NoticeErr}}alert-danger{{else}}alert-success{{end}} mt-3" role="{{if $.NoticeErr}}alert{{else}}status{{end}}">{{.}}</div>{{end}}
<div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1">
  <h1 class="break-words">{{.Company.Name}}</h1>
  {{template "practice_badge"}}
</div>
<section class="card mt-4 space-y-2" data-practice-aftermath>
  <p class="font-medium">Practice match: nothing to roll.</p>
  <p class="text-sm text-muted">Nothing was awarded and nobody was injured. {{.Company.Name}} is not locked and can recruit, buy, heal and start a new match.</p>
  <p class="text-sm"><a href="/campaigns/{{.Campaign.ID}}/matches/{{.Match.ID}}">Back to Match {{.Match.Number}}</a></p>
</section>
{{else}}
{{with .Notice}}<div class="alert {{if $.NoticeErr}}alert-danger{{else}}alert-success{{end}} mt-3" role="{{if $.NoticeErr}}alert{{else}}status{{end}}">{{.}}</div>{{end}}
<div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1">
  <h1 class="break-words">{{.Company.Name}}</h1>
  <span class="badge tone-{{.OutcomeTone}} !bg-raised">{{.OutcomeText}}</span>
  {{template "aftermath_badge" .A.Status}}
</div>
<p class="mt-1 text-muted">The War's Aftermath of <a href="/campaigns/{{.Campaign.ID}}/matches/{{.Match.ID}}">Match {{.Match.Number}}</a>{{with .Match.Scenario}} · {{.Name}}{{end}}{{with .Company.Owner}} · {{.}}{{end}}</p>
{{if not .Edit}}<p class="mt-1 text-sm text-muted">You can read this aftermath but not change it.</p>{{end}}

{{/* the stepper, until the aftermath is over: only the steps that apply (an empty one is skipped); the current step is open, earlier ones are summaries */}}
{{if not .Closed}}
{{$step := .Step}}{{$steps := .Steps}}
<ol class="mt-5 flex gap-1 text-center text-xs sm:text-sm" aria-label="Steps">
  {{range $n, $st := $steps}}{{$i := $st.Index}}
  <li class="min-w-0 flex-1 rounded-md border px-1 py-2 {{if eq $i $step}}border-accent bg-accent-soft font-semibold{{else if lt $i $step}}border-line bg-raised{{else}}border-line text-muted{{end}}" {{if eq $i $step}}aria-current="step"{{end}} data-step="{{$st.Name}}">
    <span class="block text-base font-semibold">{{if lt $i $step}}✓{{else}}{{inc $n}}{{end}}</span>{{$st.Name}}
  </li>
  {{end}}
</ol>
{{end}}

<div class="{{if .Closed}}mt-4{{else}}mt-6{{end}} space-y-6" x-effect="document.body.classList.toggle('overflow-hidden', modal)" x-data="{ modal: false, openModal() { this.modal = true }, closeModal() { this.modal = false; htmx.ajax('GET', location.pathname, { target: '#main', swap: 'innerHTML' }) } }" @keydown.escape.window="if (modal) closeModal()">
  {{if .Closed}}{{template "aftermath_done" .}}{{if .HasLevelUps}}{{template "aftermath_levelups_card" .}}{{end}}
  {{else}}{{template "aftermath_sheet" .}}{{end}}
  {{if .HasInjuries}}{{template "aftermath_later" .}}{{end}}
  {{if .OnRewards}}<section class="card space-y-2" id="aftermath-step-3"><h2 class="!text-xl">Rewards</h2>{{template "aftermath_finish" .}}</section>{{end}}
  {{if and .HasLevelUps (not .Closed)}}{{template "aftermath_levelups_card" .}}{{end}}
  {{with .UnitResults}}{{template "aftermath_company" (dict "V" $ "R" .)}}{{end}}
  {{if .Owner}}
  {{/* The level-up window of My Company, opened here (its endpoints and panel are the same). */}}
  <div x-show="modal" x-cloak x-transition.opacity class="fixed inset-0 z-[55] flex items-start justify-center overflow-y-auto bg-black/60 p-3 sm:p-6" @click.self="closeModal()" data-reloads-on-close>
    <div class="card relative my-4 w-full max-w-3xl !p-4 sm:!p-6" role="dialog" aria-modal="true" aria-label="Level-up window">
      <button type="button" class="absolute right-1 top-1 flex h-11 w-11 items-center justify-center rounded-md text-muted hover:bg-raised hover:text-fg" @click="closeModal()" aria-label="Close">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <div id="modal-body" hx-target="#main" hx-swap="innerHTML show:window:top"><p class="text-muted">Loading…</p></div>
    </div>
  </div>
  {{end}}
</div>
{{end}}
</div>
{{end}}

{{/* The Injuries step: open while it is the current step, a summary once it is behind, dimmed before. */}}
{{define "aftermath_later"}}
<section class="card space-y-2 {{if .InjuriesAhead}}border-dashed{{end}}" id="aftermath-step-1">
  <h2 class="!text-xl">Injuries</h2>
  {{if .OnInjuries}}{{template "aftermath_injuries" .}}
  {{else if .InjuriesAhead}}<p class="text-sm text-muted">A casualty roll for every unit marked as a casualty.</p>
  {{else}}{{template "aftermath_injuries_summary" .}}{{end}}
</section>
{{end}}

{{/* Every unit with what the match did to it. While the casualties are being rolled they have their own cards above, so these are the others;
   afterwards it is the whole company, the casualties first. Takes {V: aftermathView, R: []unitResult}. */}}
{{define "aftermath_company"}}
<section class="card space-y-3" id="aftermath-company">
  <h2 class="!text-xl">{{if .V.OnInjuries}}The rest of the company{{else}}The company{{end}}</h2>
  <div class="unit-choices">
    {{range .R}}
    <article class="{{template "unit_frame" .Unit}} flex flex-col gap-2" data-unit-result="{{.Unit.ID}}" aria-label="{{.Unit.Title}}">
      {{template "unit_summary" .Unit}}
      {{template "aftermath_unit_marks" .}}
      {{template "unit_summary_foot" .Foot}}
    </article>
    {{end}}
  </div>
</section>
{{end}}

{{/* What the match did to a unit: fled, a casualty and its result, that it recovers and can play next, and every milestone as on the sheet, those it earned lit
   and none to press. The experience is in the bar of its foot. Takes a unitResult. */}}
{{define "aftermath_unit_marks"}}
<div class="flex flex-wrap items-center gap-1.5" data-unit-outcome>
  <span class="badge {{.Badge}} inline-flex items-center gap-1">{{with .Icon}}{{template "gi_icon" (dict "N" . "C" "h-3.5 w-3.5 shrink-0")}}{{end}}{{.Status}}</span>
  {{with .Next}}<span class="badge badge-success inline-flex items-center gap-1" data-unit-next>{{.}}</span>{{end}}
</div>
{{template "aftermath_unit_milestones" .}}
{{end}}

{{/* Every milestone as on the sheet, those the unit earned lit and none to press. Takes a unitResult. */}}
{{define "aftermath_unit_milestones"}}
<div class="milestones milestones-wrap mt-auto [&+*]:mt-0" role="group" aria-label="Milestones">{{range .Milestones}}{{template "milestone" (dict "M" . "Edit" false "Unit" "")}}{{end}}</div>
{{end}}

{{/* The top of a finished aftermath, with no card: what changed (or that it was waived), the counts of the sheet, the two collapsed details and the way out. */}}
{{define "aftermath_done"}}
<div class="space-y-3" id="aftermath-done">
  <div class="space-y-1">
    {{if eq (printf "%s" .A.Status) "waived"}}<p class="text-lg font-semibold">Waived: nothing was applied.</p>{{with .A.WaivedNote}}<p class="text-sm" data-waived-note>{{.}}</p>{{end}}
    {{else}}<p class="text-lg font-semibold" data-change-summary>{{.ChangeSummary}}</p>{{end}}
    {{if .A.Input.Models}}<p class="text-sm text-muted" data-sheet-counts>{{.Participants}} took part · {{.Casualties}} casualt{{if eq .Casualties 1}}y{{else}}ies{{end}}</p>{{end}}
  </div>
  <div class="divide-y divide-line border-y border-line">
    {{if or .Summary (ne (printf "%s" .A.Status) "waived")}}
    <details class="group" data-done-changes>
      <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 text-sm font-medium"><span>Everything that changed</span><span class="text-muted group-open:hidden">Show</span><span class="hidden text-muted group-open:inline">Hide</span></summary>
      <div class="pb-3">{{template "aftermath_summary" .}}</div>
    </details>
    {{end}}
    <details class="group" data-done-sheet>
      <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 text-sm font-medium"><span>The sheet</span><span class="text-muted group-open:hidden">Show</span><span class="hidden text-muted group-open:inline">Hide</span></summary>
      <div class="pb-3">{{template "aftermath_sheet_readonly" .}}</div>
    </details>
  </div>
  <p class="flex flex-wrap gap-3 text-sm" data-done-links>{{if .Owner}}<a class="btn btn-secondary" href="/campaigns/{{.Campaign.ID}}/my-company/{{.Company.ID}}">My Company</a>{{end}}<a class="btn btn-ghost" href="/campaigns/{{.Campaign.ID}}/matches/{{.Match.ID}}">Back to the match</a></p>
</div>
{{end}}

{{/* The level-up rolls waiting, in a card of their own. */}}
{{define "aftermath_levelups_card"}}<section class="card space-y-2" id="aftermath-step-2"><h2 class="!text-xl">Level-ups</h2>{{template "aftermath_levelups" .}}</section>{{end}}

{{/* The Injuries step: a card per casualty, the questions that are open, Against the Odds re-rolls and the Leader's succession. */}}
{{define "aftermath_injuries"}}
<div class="space-y-2" x-data="aftermathTips" @mouseover="over($event)" @mouseout="out($event)" @focusin="over($event)" @focusout="out($event)" @click="tap($event)" @keydown.escape.window="hideTip()">
{{$cid := .Campaign.ID}}{{$base := printf "/campaigns/%d/matches/%d/aftermath/%d" .Campaign.ID .Match.ID .Company.ID}}
{{if not .A.Casualties}}<p class="text-muted">No casualties: nothing to roll.</p>{{end}}
{{with .ItemBanner}}<p class="alert alert-info" role="status"><strong>{{.}}</strong> (the total stops at 12).</p>{{end}}
{{if .A.Rerolls}}<p class="text-sm"><span class="badge badge-gold">Against the Odds</span> <strong>{{.A.Rerolls}}</strong> re-roll{{if ne .A.Rerolls 1}}s{{end}} left. A result is final when you continue; the re-rolls expire at the end of the aftermath.</p>{{end}}
{{with .Unrolled}}{{if and $.Edit (gt (len .) 1)}}
<form hx-post="{{$base}}/roll" hx-target="#aftermath-page" hx-swap="outerHTML"><input type="hidden" name="unrolled" value="{{$.UnrolledIDs}}"><input type="hidden" name="roll" value="0"><input type="hidden" name="roll2" value="0">
  <button class="btn btn-primary">Roll all {{len .}} casualties</button></form>
{{end}}{{end}}
<div class="unit-choices">
  {{range .A.Casualties}}{{template "aftermath_casualty" (dict "V" $ "C" . "Base" $base)}}{{end}}
</div>
{{with .A.Succession}}{{template "aftermath_succession" (dict "V" $ "S" . "Base" $base)}}{{end}}
{{if .A.NoOneToLead}}<p class="alert alert-info" role="status"><strong>Nobody is left to lead the company.</strong> The Leader fell and no Hero or Warrior remains to take over, so there is no succession to decide.</p>{{end}}
{{if .CanContinue}}
<form hx-post="{{$base}}/decide" hx-target="#aftermath-page" hx-swap="outerHTML" class="space-y-2 rounded-xl border border-line bg-raised p-3">
  <input type="hidden" name="kind" value="continue">
  <p class="text-sm">Happy with the results? Continuing makes them final.</p>
  <button class="btn btn-primary">Continue</button>
</form>
{{end}}
<div x-ref="tip" x-show="tip.show" x-cloak role="tooltip" class="card pointer-events-none fixed z-50 max-h-[calc(100vh-1rem)] w-80 max-w-[calc(100vw-1rem)] overflow-hidden !p-3 text-sm shadow-lg" :style="`left: ${tip.x}px; top: ${tip.y}px`">
  <p class="font-heading text-lg font-bold leading-tight" x-text="tip.title"></p>
  <p class="text-xs text-muted" x-show="tip.meta" x-text="tip.meta"></p>
  <p class="mt-1 whitespace-pre-line" x-show="tip.text" x-text="tip.text"></p>
  <div class="mt-1" x-show="tip.html" x-html="tip.html"></div>
</div>
</div>
{{end}}

{{define "aftermath_casualty"}}
{{$v := .V}}{{$c := .C}}{{$base := .Base}}{{$animate := index $v.Animate $c.UnitID}}{{$u := $v.CasualtyUnit $c}}{{$pending := $v.CasualtyPending $c}}
<article class="{{template "unit_frame" $u}} {{if and $pending (not $animate)}}unit-pending{{end}} flex flex-col gap-3" id="casualty-{{$c.UnitID}}" aria-label="{{$c.Name}}" x-data="rollPanel" {{if and $pending $animate}}:class="revealed && 'unit-pending'"{{end}}
         data-dice="{{$v.DiceCSV $c}}" data-groups="{{$v.Rules.InjuryDice.Count}}" data-per-lane="{{$v.Rules.InjuryDice.Count}}" data-sides="{{$v.Rules.InjuryDice.Sides}}" data-labels="" data-animate="{{$animate}}" data-shake="{{$v.Settings.ShakeTheTable}}" @keydown.space.window="onSpace($event)">
  {{template "unit_summary" $u}}
  {{template "aftermath_injury_chart" (dict "V" $v "C" $c)}}
  <canvas x-ref="canvas" class="dice-tray" x-show="rolling || stopped" x-cloak aria-hidden="true"></canvas>
  {{if not $c.Rolled}}
    {{if $v.Edit}}
    <form x-ref="rollForm" hx-post="{{$base}}/roll" hx-target="#aftermath-page" hx-swap="outerHTML" class="space-y-2">
      <input type="hidden" name="unit" value="{{$c.UnitID}}"><input type="hidden" name="thrown" value="">
      {{template "aftermath_strip_unrolled" (dict "V" $v "C" $c)}}
      {{if $v.Settings.ManualRolls}}
      <div class="injury-typed" x-show="typing" x-cloak>{{template "dice_selects" (dict "ID" "d" "Suffix" (printf "-%d" $c.UnitID) "Count" $v.Rules.InjuryDice.Count "Sides" $v.Rules.InjuryDice.Sides "Class" "w-full")}}</div>
      {{else}}{{template "dice_zeros" (dict "Count" $v.Rules.InjuryDice.Count)}}{{end}}
    </form>
    {{if $v.Settings.ShakeTheTable}}<p class="text-sm text-muted" x-show="rolling && !shaken" x-cloak role="status">Press the space bar to shake the table (once).</p>{{end}}
    {{else}}{{template "aftermath_strip_unrolled" (dict "V" $v "C" $c)}}{{end}}
  {{else}}
  <div {{if $animate}}x-show="revealed" x-cloak{{end}} class="space-y-2" role="status">
    {{if $v.CanReroll $c}}
    <form hx-post="{{$base}}/reroll" hx-target="#aftermath-page" hx-swap="outerHTML" class="space-y-2"><input type="hidden" name="unit" value="{{$c.UnitID}}">
      {{template "aftermath_strip_rolled" (dict "V" $v "C" $c "Reroll" true)}}
      {{if $v.Settings.ManualRolls}}<div class="injury-typed" x-show="typing" x-cloak>{{template "dice_selects" (dict "ID" "rr" "Suffix" (printf "-%d" $c.UnitID) "Count" $v.Rules.InjuryDice.Count "Sides" $v.Rules.InjuryDice.Sides "Class" "w-full")}}</div>{{end}}
    </form>
    {{else}}{{template "aftermath_strip_rolled" (dict "V" $v "C" $c "Reroll" false)}}{{end}}
    {{with $v.BonusText $c}}<p><span class="badge badge-gold">{{.}}</span></p>{{end}}
    {{with $v.BonusLine $c}}<p class="text-sm font-medium">{{.}}</p>{{end}}
    {{with $c.Previous}}<p class="text-xs text-muted">Gave up: {{join . ", "}}</p>{{end}}
    {{if $v.Fallen $c}}<p class="text-sm text-muted">🪦 {{if eq (printf "%s" $c.Kind) "retired"}}Retires{{else}}Has fallen{{end}}: goes to the cemetery.</p>{{end}}
    {{with $c.Decision}}{{if $v.Edit}}{{template "aftermath_decision" (dict "V" $v "C" $c "D" . "Base" $base)}}{{else}}<p class="text-sm text-muted">The owner of the company decides.</p>{{end}}{{end}}
  </div>
  {{end}}
  {{template "aftermath_unit_milestones" ($v.ResultOf $c.UnitID)}}
  {{template "unit_summary_foot" ($v.Foot $u)}}
</article>
{{end}}

{{/* The injuries chart of a casualty, out of sight: the tooltip of its dice shows it (aftermathTips) and a screen reader reads it as their description. Takes {V, C}. */}}
{{define "aftermath_injury_chart"}}{{$v := .V}}{{$c := .C}}
<div id="injury-chart-{{$c.UnitID}}" hidden><table class="w-full text-xs">
  <thead class="text-muted"><tr><th class="w-12 px-1 py-0.5 text-center font-semibold">{{$v.Rules.InjuryDice.Display}}</th><th class="px-1 py-0.5 text-left font-semibold">Result</th></tr></thead>
  <tbody>{{range $v.Chart $c}}<tr {{if .Covers $c.Total}}class="bg-accent-soft font-semibold" aria-current="true"{{end}}><td class="px-1 py-0.5 text-center">{{if eq .Min .Max}}{{.Min}}{{else}}{{.Min}}-{{.Max}}{{end}}</td><td class="px-1 py-0.5">{{.Name}}</td></tr>{{end}}</tbody>
</table></div>
{{end}}

{{/* The strip of a casualty still to roll: empty dice, the Casualty badge, the Roll button and the pencil that opens the typed dice. Takes {V, C}. */}}
{{define "aftermath_strip_unrolled"}}{{$v := .V}}{{$c := .C}}{{$r := $v.ResultOf $c.UnitID}}
<div class="injury-strip" data-unit-outcome>
  <button type="button" class="injury-dice" data-tip-title="{{if $c.Hero}}Hero{{else}}Warrior{{end}} injuries chart" data-tip-chart="injury-chart-{{$c.UnitID}}" aria-label="{{if $c.Hero}}Hero{{else}}Warrior{{end}} injuries chart" aria-describedby="injury-chart-{{$c.UnitID}}">{{range seq 1 $v.Rules.InjuryDice.Count}}<span class="die-face die-blank" aria-hidden="true"></span>{{end}}</button>
  <span class="injury-name"><span class="badge {{$r.Badge}} inline-flex items-center gap-1">{{with $r.Icon}}{{template "gi_icon" (dict "N" . "C" "h-3.5 w-3.5 shrink-0")}}{{end}}{{$r.Status}}</span></span>
  {{if $v.Edit}}
  <span class="injury-actions"><button class="btn btn-primary shrink-0" :disabled="rolling" {{if $v.Settings.ShakeTheTable}}@click="if (!typed()) { $event.preventDefault(); throwCasualty() }"{{end}}>Roll {{$v.Rules.InjuryDice.Display}}</button>
  {{if $v.Settings.ManualRolls}}{{template "aftermath_pencil"}}{{end}}</span>
  {{else}}<span class="text-sm text-muted">Waiting for the roll.</span>{{end}}
</div>
{{end}}

{{/* The strip of a rolled casualty: the dice (or the item that replaced them), with the chart in their tooltip, and the result, with its rule in its tooltip; coloured by how bad it is.
   Takes {V, C, Reroll: inside the re-roll form}. */}}
{{define "aftermath_strip_rolled"}}{{$v := .V}}{{$c := .C}}
<div class="injury-strip" data-tone="{{$v.CasualtyTone $c}}" data-unit-outcome>
  {{if $c.Item}}<span class="badge badge-gold shrink-0">{{$v.ItemName $c.Item}}</span><span class="sr-only">No roll:</span>
  {{else}}<span class="sr-only">{{$v.RollText $c}}:</span>
  <button type="button" class="injury-dice" data-tip-title="{{if $c.Hero}}Hero{{else}}Warrior{{end}} injuries chart" data-tip-meta="{{$v.RollText $c}}" data-tip-chart="injury-chart-{{$c.UnitID}}" aria-label="{{if $c.Hero}}Hero{{else}}Warrior{{end}} injuries chart" aria-describedby="injury-chart-{{$c.UnitID}}">{{range $c.Dice}}{{template "die_face" .}}{{end}}{{if $c.Modifier}}<span class="ml-0.5 text-sm font-bold">{{printf "%+d" $c.Modifier}}</span>{{end}}</button>{{end}}
  <span class="injury-name"><span class="injury-result has-tip" tabindex="0" data-concept data-tip-title="{{$c.ResultTxt}}" data-tip-text="{{$c.Text}}">{{$c.ResultTxt}}<svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg></span>{{with $c.Text}}<span class="sr-only"> {{.}}</span>{{end}}</span>
  {{if $c.Final}}<span class="badge badge-muted shrink-0">Final</span>{{end}}
  {{if .Reroll}}
  <span class="injury-actions"><button class="btn btn-secondary shrink-0 !px-2" aria-label="Re-roll · Against the Odds ({{$v.A.Rerolls}} left)" title="Re-roll · Against the Odds ({{$v.A.Rerolls}} left)"><svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2.3 6.3M20 5v6h-6"/></svg><span class="injury-reroll-label">Re-roll</span> ({{$v.A.Rerolls}})</button>
  {{if $v.Settings.ManualRolls}}{{template "aftermath_pencil"}}{{end}}</span>
  {{end}}
</div>
{{end}}

{{/* The button that shows the typed dice of the roll. */}}
{{define "aftermath_pencil"}}<button type="button" class="btn btn-secondary shrink-0 !px-2" aria-label="Type the dice" title="Type the dice" :aria-expanded="typing" @click="typing = !typing"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20l1-4L16 5l3 3L8 19l-4 1z"/></svg></button>{{end}}

{{/* One die as it fell: its pips, or its number where the die has more faces than pips. Takes the number. */}}
{{define "die_face"}}{{if le . 6}}<span class="die-face" data-n="{{.}}" aria-hidden="true">{{range seq 1 .}}<i></i>{{end}}</span>{{else}}<span class="die-face die-number" aria-hidden="true">{{.}}</span>{{end}}{{end}}

{{define "aftermath_decision"}}
{{$v := .V}}{{$d := .D}}{{$c := .C}}
<form hx-post="{{.Base}}/decide" hx-target="#aftermath-page" hx-swap="outerHTML" class="space-y-2 rounded-xl border border-accent bg-accent-soft p-3">
  <input type="hidden" name="kind" value="{{$d.Kind}}"><input type="hidden" name="unit" value="{{$c.UnitID}}">
  <fieldset class="min-w-0 space-y-2">
    <legend class="text-sm font-semibold">{{if eq $d.Kind "scratch"}}Roll again (the second result stands, even if worse), or miss the next game?{{else if eq $d.Kind "heal"}}Heal one persistent injury?{{else if eq $d.Kind "bonus"}}{{$v.BonusDieText $c}}{{else}}Decide{{end}}</legend>
    <div class="flex flex-wrap items-center gap-2">
    {{if eq $d.Kind "scratch"}}
      <button name="answer" value="reroll" class="btn btn-primary">Roll again</button>
      <button name="answer" value="keep" class="btn btn-secondary">Keep it</button>
    {{else if eq $d.Kind "bonus"}}
      <button name="answer" value="0" class="btn btn-primary">Roll for me</button>
      <span class="text-sm text-muted">or the die you rolled:</span>
      {{range $n := seq 1 ($v.BonusMax $c)}}<button name="answer" value="{{$n}}" class="btn btn-secondary !min-h-11 !min-w-11 !px-2"><span class="sr-only">I rolled a </span>{{$n}}</button>{{end}}
    {{else}}
      {{range $d.Options}}<button name="answer" value="{{.Key}}" class="btn btn-primary">Heal {{.Label}}</button>{{end}}
      <button name="answer" value="" class="btn btn-secondary">Heal nothing</button>
    {{end}}
    </div>
  </fieldset>
</form>
{{end}}

{{/* A unit offered as an answer: its summary, and the button that answers with it across the whole card. Takes {U: the unit, Value: the answer,
   Label: the button's text, Note: a line under the summary, Edit: whether the viewer may answer}. */}}
{{define "aftermath_unit_choice"}}{{$u := .U}}
<article class="{{template "unit_frame" $u}} {{if .Edit}}unit-choice{{end}} flex flex-col gap-2">
  {{template "unit_summary" $u}}
  {{with .Note}}<p class="text-sm text-muted">{{.}}</p>{{end}}
  {{if .Edit}}<button name="answer" value="{{.Value}}" class="btn btn-primary unit-choice-go w-full">{{.Label}}<span class="sr-only">: {{$u.Title}}</span></button>{{end}}
  {{template "unit_summary_foot" (.V.Foot $u)}}
</article>
{{end}}

{{/* The Warriors offered when no hero is left: the most experienced (ties by rating). Takes {V, IDs, Role}. */}}
{{define "aftermath_fallback"}}{{$v := .V}}{{$n := len .IDs}}{{$label := "Make Sergeant"}}{{if eq .Role "leader"}}{{$label = "Make Leader"}}{{end}}
<legend class="text-sm font-semibold">{{if eq .Role "leader"}}The Leader has fallen and the company has no hero left.{{else}}A Sergeant has fallen and the company has no hero left.{{end}} {{if gt $n 1}}{{$n}} Warriors are tied for the most Experience (then the highest rating): choose which one becomes {{if eq .Role "leader"}}the Leader{{else}}a Sergeant{{end}}.{{else}}The Warrior with the most Experience becomes {{if eq .Role "leader"}}the Leader{{else}}a Sergeant{{end}}.{{end}} It is treated as having rolled Hero in the Making: it chooses its path in the company window. This place cannot stay empty.</legend>
<div class="unit-choices">
  {{range $id := .IDs}}{{$u := index $v.Roster $id}}{{template "aftermath_unit_choice" (dict "V" $v "U" $u "Value" $id "Label" $label "Note" (printf "%d Experience" $u.XP) "Edit" $v.Edit)}}{{end}}
</div>
{{end}}

{{define "aftermath_succession"}}
{{$v := .V}}{{$s := .S}}
<form hx-post="{{.Base}}/decide" hx-target="#aftermath-page" hx-swap="outerHTML" class="space-y-2 rounded-xl border border-accent bg-accent-soft p-3">
  {{if $s.NeedLeader}}
  <input type="hidden" name="kind" value="succession">
  <fieldset class="min-w-0 space-y-2">
    {{if $s.Fallback}}{{template "aftermath_fallback" (dict "V" $v "IDs" $s.Fallback "Role" "leader")}}
    {{else}}
    <legend class="text-sm font-semibold">The Leader has fallen. Which one takes over as Leader? A Sergeant place may then need a replacement.</legend>
    <div class="unit-choices">
      {{range $id := $s.LeaderOptions}}{{template "aftermath_unit_choice" (dict "V" $v "U" (index $v.Roster $id) "Value" $id "Label" "Make Leader" "Edit" $v.Edit)}}{{end}}
    </div>
    {{end}}
  </fieldset>
  {{else}}
  <input type="hidden" name="kind" value="sergeant">
  <fieldset class="min-w-0 space-y-2">
    {{if $s.Fallback}}{{template "aftermath_fallback" (dict "V" $v "IDs" $s.Fallback "Role" "sergeant")}}
    {{else}}
    <legend class="text-sm font-semibold">The company has fewer than {{count $s.Sergeants "Sergeant"}}. Which hero becomes a Sergeant? (Optional: a Hero who is not a Leader or Sergeant may take the place.)</legend>
    <div class="unit-choices">
      {{range $id := $s.SergeantOptions}}{{template "aftermath_unit_choice" (dict "V" $v "U" (index $v.Roster $id) "Value" $id "Label" "Make Sergeant" "Edit" $v.Edit)}}{{end}}
    </div>
    {{if $v.Edit}}<button name="answer" value="" class="btn btn-secondary">Nobody for now</button>{{end}}
    {{end}}
  </fieldset>
  {{end}}
  {{if not $v.Edit}}<p class="text-sm text-muted">The owner of the company chooses.</p>{{end}}
</form>
{{end}}

{{/* What the injuries step did: the results and the experience given when it closed. */}}
{{define "aftermath_injuries_summary"}}
{{if .RangerFell}}<p class="alert alert-info text-sm" role="status">The Ranger of the North fell. On a successful Reinforcements roll you may swap the result for a new one (it is free); he returns as an officer, Leader to start with.</p>{{end}}
{{if .A.Casualties}}<ul class="space-y-1 text-sm">{{range .A.Casualties}}<li><span class="font-medium">{{.Name}}</span>: {{.ResultTxt}}{{with $.BonusText .}} ({{.}}){{end}}{{with $.Note .}} <span class="text-muted">· {{.}}</span>{{end}}</li>{{end}}</ul>{{else}}<p class="text-sm text-muted">No casualties.</p>{{end}}
{{$any := false}}{{range .A.Lines}}{{if or (eq .Kind "experience") (eq .Kind "succession")}}{{$any = true}}{{end}}{{end}}
{{if $any}}<ul class="space-y-0.5 text-sm text-muted">{{range .A.Lines}}{{if or (eq .Kind "experience") (eq .Kind "succession")}}<li>{{.Text}}{{if .Amount}} ({{if gt .Amount 0}}+{{end}}{{.Amount}}){{end}}</li>{{end}}{{end}}</ul>{{end}}
{{end}}

{{define "aftermath_levelups"}}
{{$cid := .Campaign.ID}}
<p class="text-sm text-muted">Every {{.LevelEvery}} experience a unit rolls for a level-up. Experience is applied; units that crossed a threshold are listed here.</p>
{{with .Waiting}}
<ul class="unit-choices">
  {{range .}}
  <li class="{{template "unit_frame" .}} flex flex-col gap-2">
    {{template "unit_summary" .}}
    <p class="text-sm text-muted">{{.PendingLevelUps}} roll{{if ne .PendingLevelUps 1}}s{{end}} waiting</p>
    {{if $.Owner}}<button type="button" class="btn btn-primary w-full" hx-get="/campaigns/{{$cid}}/my-company/{{$.Company.ID}}/units/{{.ID}}/levelup" hx-target="#modal-body" hx-swap="innerHTML" @click="openModal()">Level up<span class="sr-only"> {{.Title}}</span></button>{{end}}
    {{template "unit_summary_foot" ($.Foot .)}}
  </li>
  {{end}}
</ul>
{{if not $.Owner}}<p class="text-sm text-muted">The owner of the company rolls these from My Company.</p>{{end}}
<p class="text-sm text-muted">Rolls do not have to be done now: they stay waiting on the unit cards.</p>
{{else}}<p class="text-muted">No level-up roll is waiting.</p>{{end}}
{{end}}

{{/* The Finish step: what will be applied, the decisions the rewards need, and the button. */}}
{{define "aftermath_finish"}}
{{$base := printf "/campaigns/%d/matches/%d/aftermath/%d" .Campaign.ID .Match.ID .Company.ID}}
<div class="space-y-4">
  <div><h3 class="!text-lg">Influence</h3>
    {{if .A.Preview.Influence}}<ul class="mt-1 text-sm">{{range .A.Preview.Influence}}<li class="flex justify-between gap-3 border-b border-line py-1"><span>{{.Text}}</span><span class="font-medium">{{if gt .Amount 0}}+{{end}}{{.Amount}}</span></li>{{end}}
      <li class="flex justify-between gap-3 py-1 font-semibold"><span>Total</span><span>{{if gt .Influence 0}}+{{end}}{{.Influence}}</span></li></ul>
    {{else}}<p class="text-sm text-muted">No influence this time.</p>{{end}}
  </div>
  {{with .A.Preview.Rewards}}
  <div><h3 class="!text-lg">Scenario rewards</h3>
    <ul class="mt-1 space-y-3">
    {{range .}}
      <li class="space-y-1 text-sm">
        <p><span class="font-medium">{{.Name}}</span>{{if eq .Kind "influence"}} <span class="badge badge-gold">+{{.Amount}} Influence</span>{{else if eq .Kind "experience"}} <span class="badge">+{{.Amount}} Experience{{with .UnitID}} · {{$.UnitName .}}{{end}}</span>{{else if eq .Kind "perk"}} <span class="badge badge-muted">Perk</span>{{end}}</p>
        {{with .Text}}<p class="text-muted">{{.}}</p>{{end}}
        {{if .Decision}}
          {{if $.Chosen .Key}}<p class="text-muted">Choice made.</p>
          {{else if $.Edit}}{{template "aftermath_free_equipment" (dict "V" $ "R" . "Base" $base)}}
          {{else}}<p class="text-muted">The owner of the company chooses.</p>{{end}}
        {{end}}
      </li>
    {{end}}
    </ul>
  </div>
  {{end}}
  {{if .Edit}}<p class="text-sm text-muted">The aftermath finishes as soon as the choice is made.</p>{{end}}
</div>
{{end}}

{{define "aftermath_free_equipment"}}
{{$v := .V}}{{$r := .R}}
<form hx-post="{{.Base}}/decide" hx-target="#aftermath-page" hx-swap="outerHTML" class="space-y-2 rounded-xl border border-accent bg-accent-soft p-3" x-data="{ item: '' }">
  <input type="hidden" name="kind" value="reward"><input type="hidden" name="key" value="{{$r.Key}}">
  <fieldset class="min-w-0 space-y-2">
    <legend class="text-sm font-semibold">Choose one item worth at most {{$r.MaxValue}} Influence, then who takes it.</legend>
    {{range $o := index $v.Offers $r.Key}}
    <div class="rounded-lg border border-line bg-surface p-2" :class="item === {{jsstr $o.Name}} && '!border-accent'">
      <label class="flex min-h-11 items-start gap-3"><input type="radio" name="item-{{$r.Key}}" value="{{$o.Name}}" x-model="item" class="mt-1 h-5 w-5 accent-[var(--accent)]"><span><span class="font-medium">{{$o.Name}}</span> <span class="text-xs text-muted">worth {{$o.Cost}}{{if $o.Size}} · {{$o.Size}}{{end}}</span>{{with $o.Segments}}<span class="block text-muted">{{template "segments" (dict "S" . "CID" $v.Campaign.ID)}}</span>{{end}}</span></label>
      <div class="unit-choices mt-2" x-show="item === {{jsstr $o.Name}}" x-cloak>
        {{range $o.Units}}{{template "aftermath_unit_choice" (dict "V" $v "U" (index $v.Roster .ID) "Value" (printf "%s|%d" $o.Name .ID) "Label" "Takes it" "Edit" true)}}{{end}}
      </div>
    </div>
    {{else}}<p class="text-muted">The armory has nothing a unit can take at that value.</p>{{end}}
  </fieldset>
</form>
{{end}}

{{/* A finished aftermath: every line, grouped by unit. Readable by everybody in the campaign. */}}
{{define "aftermath_summary"}}
<div class="space-y-3">
  {{range .Summary}}
  <div><h3 class="!text-lg">{{.Name}}</h3>
    <ul class="mt-1 text-sm">{{range .Lines}}<li class="py-0.5">{{.Text}}{{if .Amount}} <span class="text-muted">({{if gt .Amount 0}}+{{end}}{{.Amount}})</span>{{end}}</li>{{end}}</ul></div>
  {{else}}<p class="text-sm text-muted">Nothing was recorded.</p>{{end}}
</div>
{{end}}

{{/* The Sheet step. */}}
{{define "aftermath_sheet"}}
<section class="card space-y-4" id="aftermath-sheet">
  <h2 class="!text-xl">1. Sheet{{if .A.FromLive}} <span class="badge badge-gold align-middle" title="Outcomes and experience come from the match as it was played (the trackers and the log); change anything that is not right">From the live match</span>{{end}}</h2>
  {{if .A.FromLive}}<p class="text-sm text-muted">Prefilled from the live match: who retreated or fell, and the experience earned by wounding, Fate and Broken courage tests. Change anything that is not right: the sheet saves itself.</p>{{end}}
  {{if .Editing}}{{template "aftermath_sheet_form" .}}
  {{else}}
    <p class="text-sm text-muted">{{.Participants}} took part · {{.Casualties}} casualt{{if eq .Casualties 1}}y{{else}}ies{{end}}{{if .CanReopenSheet}} · the sheet is locked{{end}}</p>
    <details class="group" {{if .OnSheet}}open{{end}}>
      <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 text-sm font-medium"><span>The sheet</span><span class="text-muted group-open:hidden">Show</span><span class="hidden text-muted group-open:inline">Hide</span></summary>
      {{template "aftermath_sheet_readonly" .}}
    </details>
    {{if .CanReopenSheet}}
    <form hx-post="/campaigns/{{.Campaign.ID}}/matches/{{.Match.ID}}/aftermath/{{.Company.ID}}/reopen-sheet" hx-target="#aftermath-page" hx-swap="outerHTML">
      <input type="hidden" name="revision" value="{{.A.Revision}}">
      <button class="btn btn-secondary">Edit the sheet again</button>
    </form>
    {{end}}
  {{end}}
</section>
{{end}}

{{define "aftermath_result"}}
<div class="rounded-xl border border-line bg-raised p-3 text-sm space-y-1">
  <p><span class="font-medium">Match result:</span> {{.OutcomeText}}. <a href="/campaigns/{{.Campaign.ID}}/matches/{{.Match.ID}}">Change it on the match page</a>{{if .Match.Ended}} (administrators only){{end}}.</p>
  {{if .RelicTicked}}<p>The company holds the Relic.</p>{{end}}
</div>
{{end}}

{{define "aftermath_sheet_readonly"}}
<div class="mt-3 space-y-3">
  {{template "aftermath_result" .}}
  {{if .A.Input.AgainstTheOdds}}<p class="text-sm"><span class="font-medium">Against the Odds:</span> {{range $i, $k := .A.Input.AgainstTheOdds}}{{if $i}}, {{end}}{{range $.Rules.Bonuses}}{{if eq .Key $k}}{{.Name}}{{end}}{{end}}{{end}}</p>{{end}}
  <ul class="divide-y divide-line">
    {{range .Units}}
    <li class="space-y-1 py-2">
      <p class="flex flex-wrap items-baseline gap-x-2"><span class="font-medium break-words">{{.Unit.Title}}</span><span class="text-sm text-muted">{{.Unit.Type}}</span> <span class="badge {{$.OutcomeBadge .Sheet.Outcome}}">{{$.OutcomeLabel .Sheet.Outcome}}</span>{{if not .Sheet.Took}} <span class="badge badge-muted">Did not take part</span>{{end}}{{with .Sheet.UsesItem}} <span class="badge badge-gold">Uses {{$.ItemName .}}</span>{{end}}{{if .Sheet.Relic}} <span class="badge badge-gold">Relic</span>{{end}}</p>
      {{with $.GainLabels .Sheet}}<p class="text-sm text-muted">{{join . " · "}}</p>{{end}}
    </li>
    {{end}}
  </ul>
  {{template "aftermath_absent" .}}
</div>
{{end}}

{{define "aftermath_absent"}}{{if .Absent}}
<div class="space-y-1"><h3 class="!text-lg">Missed this game, back next match</h3>
  <ul class="text-sm text-muted">{{range .Absent}}<li>{{.Title}} <span class="text-xs">({{.Type}})</span></li>{{end}}</ul>
  <p class="text-xs text-muted">They recover when the aftermath starts and earn nothing.</p></div>
{{end}}{{end}}

{{/* The form. State: per card outcome and took; on the form the MVP and Relic holder (one each). */}}
{{define "aftermath_sheet_form"}}
<form hx-post="/campaigns/{{.Campaign.ID}}/matches/{{.Match.ID}}/aftermath/{{.Company.ID}}/sheet?auto=1" hx-trigger="change delay:500ms" hx-target="#aftermath-bar" hx-swap="outerHTML" hx-sync="this:replace" class="space-y-5" data-autosave
      x-data="{ mvp: '{{with .MVP}}{{.}}{{end}}', relic: '{{with .Relic}}{{.}}{{end}}', relicNeeded: {{.RelicTicked}}, uses: {{.Elected}},
        names: {{.UnitNames}}, taken(key, id) { const u = Object.keys(this.uses).find(u => u !== String(id) && this.uses[u] === key); return u ? this.names[u] : '' },
        get startReason() { return this.relicNeeded && !this.relic ? 'Choose who holds the Relic.' : ''; } }" novalidate>
  {{template "aftermath_result" .}}
  {{if .Problems}}<div class="alert alert-danger" role="alert"><ul class="list-disc pl-4">{{range .Problems}}<li>{{.}}</li>{{end}}</ul></div>{{end}}

  {{if .Rules.Bonuses}}{{$anyTaken := false}}{{range .Rules.Bonuses}}{{if $.A.Input.Taken .Key}}{{$anyTaken = true}}{{end}}{{end}}
  <fieldset class="min-w-0 space-y-2" id="aftermath-ato">
    <legend class="text-lg font-semibold font-heading">Against the Odds{{if .A.FromMatch}} <span class="badge badge-gold align-middle" title="Ticked from what the company took on the match page; change anything that is not right">From the match</span>{{end}}</legend>
    {{range .Rules.Bonuses}}{{if $.A.Input.Taken .Key}}{{template "aftermath_odds" (dict "B" . "On" true)}}{{end}}{{end}}
    {{if not $anyTaken}}<p class="text-sm text-muted">No bonus taken.</p>{{end}}
    <details class="text-sm"><summary class="flex min-h-11 cursor-pointer items-center font-medium">+ add a bonus</summary>
      <div class="space-y-2">{{range .Rules.Bonuses}}{{if not ($.A.Input.Taken .Key)}}{{template "aftermath_odds" (dict "B" . "On" false)}}{{end}}{{end}}</div>
    </details>
  </fieldset>
  {{end}}

  <div class="space-y-3">
    <h3 class="!text-lg">Units</h3>
    {{with .A.MVP}}{{$mv := .}}
    <div class="alert alert-info space-y-1" role="status" id="mvp-hint">
      <p class="font-medium">MVP votes from the live match</p>
      <ul class="text-sm">{{range .Lines}}<li>{{.Title}} · {{.Votes}} vote{{if ne .Votes 1}}s{{end}}</li>{{end}}</ul>
      {{if .Winner}}<p class="text-sm">{{with index $.Roster .Winner}}{{.Title}}{{end}} is ticked as MVP; you can change it.</p>
      {{else if .Tied}}<p class="text-sm">Tied: {{range $i, $t := .Tied}}{{if $i}}, {{end}}{{with index $.Roster $t}}{{.Title}}{{end}}{{end}}. Choose the MVP among them below (or none).</p>{{end}}
    </div>
    {{end}}
    <div class="unit-choices">
    {{range .Units}}
    {{$id := .Unit.ID}}
    <fieldset class="{{template "unit_frame" .Unit}} flex min-w-0 flex-col gap-3" x-data="{ outcome: '{{.Sheet.Outcome}}', took: {{.Sheet.Took}}, items: JSON.parse($el.dataset.items || '{}'),
        reason(key) { const it = this.items[key]; if (!it) return ''; if (!this.took) return it.reasons.took || ''; return it.outcomes.includes(this.outcome) ? '' : (it.reasons[this.outcome] || ''); } }" data-items="{{.ItemsJSON}}" x-effect="if (outcome === 'casualty' && relic === '{{$id}}') relic = ''; if (uses['{{$id}}'] && reason(uses['{{$id}}'])) delete uses['{{$id}}']">
      <input type="hidden" name="unit" value="{{$id}}">
      <legend class="sr-only">{{.Unit.Title}} {{.Unit.Type}}</legend>
      {{template "unit_summary" .Unit}}
      {{with .Err}}<p class="error text-sm font-medium text-danger" role="alert">{{.}}</p>{{end}}
      <div class="flex flex-wrap gap-1.5" role="group" aria-label="What happened to {{.Unit.Title}}">
        <input type="hidden" name="outcome-{{$id}}" value="{{.Sheet.Outcome}}" :value="outcome">
        <input type="hidden" name="took-{{$id}}" value="{{if .Sheet.Took}}1{{end}}" :value="took ? '1' : ''">
        <button type="button" class="outcome-toggle" data-tone="warn" aria-pressed="{{eq (printf "%s" .Sheet.Outcome) "fled"}}" :aria-pressed="outcome === 'fled'" @click="outcome = outcome === 'fled' ? 'survived' : 'fled'; $nextTick(() => $dispatch('change'))" title="Left the board: no injury roll">{{template "gi_icon" (dict "N" "boot-prints" "C" "h-4 w-4 shrink-0")}}Fled</button>
        <button type="button" class="outcome-toggle" data-tone="danger" aria-pressed="{{eq (printf "%s" .Sheet.Outcome) "casualty"}}" :aria-pressed="outcome === 'casualty'" @click="outcome = outcome === 'casualty' ? 'survived' : 'casualty'; $nextTick(() => $dispatch('change'))" title="Removed as a casualty: rolls on the injuries chart">{{template "gi_icon" (dict "N" "death-skull" "C" "h-4 w-4 shrink-0")}}Casualty</button>
        <button type="button" class="outcome-toggle" aria-pressed="{{not .Sheet.Took}}" :aria-pressed="!took" @click="took = !took; $nextTick(() => $dispatch('change'))" title="Did not take part: earns nothing"><svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M5.6 5.6l12.8 12.8"/></svg>Absent</button>
      </div>
      <div class="milestones milestones-wrap mt-auto" role="group" aria-label="Milestones of {{.Unit.Title}}" :class="!took && 'opacity-50'">
        {{$unit := .Unit.Title}}
        {{range $.SheetMilestones .Unit .Sheet}}
        {{if .Repeatable}}
        <div class="relative flex min-w-0" x-data="{ n: {{.Count}} }">
          <input type="hidden" name="gain-{{$id}}-{{.Key}}" value="{{.Count}}" :value="n" :disabled="!took">
          <button type="button" class="milestone w-full" title="{{.M.Tip}}" aria-label="{{.M.Tip}} ({{$unit}}): one more" aria-pressed="{{gt .Count 0}}" :aria-pressed="n > 0" :disabled="!took || n >= 9" @click="n++; $nextTick(() => $dispatch('change'))">{{template "gi_icon" (dict "N" .M.Icon "C" "h-6 w-6 shrink-0")}}<span class="milestone-label">{{.M.Label}}</span><span class="milestone-count" x-show="n > 0" x-cloak x-text="n">{{.Count}}</span></button>
          <button type="button" class="milestone-less" aria-label="{{.M.Tip}} ({{$unit}}): one fewer" x-show="n > 0" x-cloak :disabled="!took" @click="n--; $nextTick(() => $dispatch('change'))">−</button>
        </div>
        {{else if eq .Key "mvp"}}
        <label class="milestone-check" title="{{.M.Tip}}"><input type="checkbox" class="sr-only" name="gain-{{$id}}-mvp" value="1" aria-label="{{.M.Tip}} ({{$unit}})" :disabled="!took" :checked="mvp === '{{$id}}'" @change="mvp = $event.target.checked ? '{{$id}}' : ''"><span class="milestone">{{template "milestone_face" .M}}</span></label>
        {{else}}
        <label class="milestone-check" title="{{.M.Tip}}"><input type="checkbox" class="sr-only" name="gain-{{$id}}-{{.Key}}" value="1" aria-label="{{.M.Tip}} ({{$unit}})" :disabled="!took" {{if .Count}}checked{{end}}><span class="milestone">{{template "milestone_face" .M}}</span></label>
        {{end}}
        {{end}}
        {{if $.RelicTicked}}
        <label class="milestone-check" title="Holds the Relic" x-show="outcome !== 'casualty'"><input type="checkbox" class="sr-only" name="relic" value="{{$id}}" aria-label="Holds the Relic ({{$unit}})" :checked="relic === '{{$id}}'" @change="relic = $event.target.checked ? '{{$id}}' : ''"><span class="milestone">{{template "milestone_face" $.RelicFace}}</span></label>
        {{end}}
      </div>
      {{range .Items}}
      <div class="rounded-md border border-line px-3 py-1" x-data="{ key: {{jsstr .Key}} }">
        <label class="flex min-h-11 items-start gap-3 py-2 text-sm">
          <input type="checkbox" class="mt-0.5 h-5 w-5 accent-[var(--accent)]" :checked="uses['{{$id}}'] === key" :disabled="reason(key) !== ''{{if not .Stackable}} || taken(key, '{{$id}}') !== ''{{end}}"
                 @change="if ($event.target.checked) uses['{{$id}}'] = key; else delete uses['{{$id}}']; $nextTick(() => $dispatch('change'))">
          <span><span class="font-medium">{{.Label}}</span>{{if .Loaned}} <span class="badge badge-gold">From the Healer's Kit</span>{{end}}</span>
        </label>
        {{with .Text}}<details class="text-sm"><summary class="flex min-h-11 cursor-pointer items-center text-accent-text">What it does</summary><p class="pb-2 text-muted">{{.}}</p></details>{{end}}
        <p class="pb-1 text-sm text-muted" x-show="reason(key)" x-text="reason(key)" x-cloak></p>
        {{if not .Stackable}}<p class="pb-1 text-sm text-muted" x-show="!reason(key) && taken(key, '{{$id}}')" x-text="'Already used by ' + taken(key, '{{$id}}') + ' (they do not stack).'" x-cloak></p>{{end}}
      </div>
      {{end}}
      <input type="hidden" name="item-{{$id}}" :value="uses['{{$id}}'] || ''">
      {{template "aftermath_sheet_foot" (dict "ID" $id "Foot" ($.Foot .Unit))}}
    </fieldset>
    {{end}}
    </div>
  </div>
  {{template "aftermath_absent" .}}

  {{template "aftermath_bar" .}}
</form>
{{end}}

{{/* The foot of a unit on the sheet; a save answers it again, as the experience of the unit may have changed. Takes {ID: the unit's id, Foot, OOB: from a save}. */}}
{{define "aftermath_sheet_foot"}}<div class="[&>*]:!mt-0" id="sheet-xp-{{.ID}}"{{if .OOB}} hx-swap-oob="true"{{end}}>{{template "unit_summary_foot" .Foot}}</div>{{end}}

{{/* What a save of the sheet answers: the bar, and the experience of every unit. Takes aftermathView. */}}
{{define "aftermath_saved"}}{{template "aftermath_bar" .}}{{range .Units}}{{template "aftermath_sheet_foot" (dict "ID" .Unit.ID "Foot" ($.Foot .Unit) "OOB" true)}}{{end}}{{end}}

{{/* The bar under the sheet, sticky on phones: what the saved sheet gives and Start aftermath. The sheet saves itself on every change and
   this is what the save answers (with the new revision). Takes aftermathView. */}}
{{define "aftermath_bar"}}
<div class="sticky bottom-0 z-10 -mx-4 space-y-2 border-t border-line bg-surface px-4 py-3 md:static md:mx-0 md:rounded-xl md:border" id="aftermath-bar">
  <input type="hidden" name="revision" value="{{.A.Revision}}">
  {{if .Problems}}<div class="alert alert-danger" role="alert"><ul class="list-disc pl-4">{{range .Problems}}<li>{{.}}</li>{{end}}</ul></div>{{end}}
  <p class="text-sm" aria-live="polite">Experience <strong>{{.XP}}</strong> across {{len .A.Preview.Experience}} unit{{if ne (len .A.Preview.Experience) 1}}s{{end}} · Influence <strong>{{.Influence}}</strong> · {{.A.Preview.Rolls}} injury roll{{if ne .A.Preview.Rolls 1}}s{{end}}.{{with .A.Preview.Items}} Items: {{range $i, $l := .}}{{if $i}}; {{end}}{{$l.Text}}{{end}}.{{end}} <span class="text-muted" data-saved>{{with .Notice}}{{.}}{{else}}Saved as you go.{{end}}</span></p>
  {{with .A.Preview.Rewards}}<ul class="text-sm text-muted" aria-label="Scenario rewards that will apply">{{range .}}<li>{{$.RewardText .}}</li>{{end}}</ul>{{end}}
  <p class="text-sm font-medium text-danger" x-show="startReason" x-text="startReason" x-cloak></p>
  <button type="button" class="btn btn-primary" hx-post="/campaigns/{{.Campaign.ID}}/matches/{{.Match.ID}}/aftermath/{{.Company.ID}}/start" hx-include="closest form" hx-target="#aftermath-page" hx-swap="outerHTML" hx-sync="closest form:queue last" :disabled="startReason !== ''">Start aftermath</button>
</div>
{{end}}

{{/* One Against the Odds bonus of the sheet. Takes {B: the bonus rule, On: ticked}. */}}
{{define "aftermath_odds"}}{{$b := .B}}
<label class="flex min-h-11 items-start gap-3 rounded-md border border-line px-3 py-2 text-sm">
  <input type="checkbox" name="odds" value="{{$b.Key}}" class="mt-0.5 h-5 w-5 accent-[var(--accent)]" {{if .On}}checked{{end}}>
  <span><span class="font-medium">{{$b.Name}}</span> <span class="text-muted">(rating {{$b.Rating}})</span><br><span class="text-muted">{{if $b.Effective}}{{$b.Text}}{{else}}No effect on the aftermath.{{end}}</span></span>
</label>
{{end}}
