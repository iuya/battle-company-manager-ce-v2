{{define "title"}}Match {{.Match.Number}} · {{.Campaign.Name}} · Battle Companies 2nd CE Manager{{end}}
{{define "content"}}
<p class="text-sm"><a href="/campaigns/{{.Campaign.ID}}/matches">← {{.Campaign.Name}} · Matches</a></p>
{{template "match_body" .}}
{{/* Outside #match, which every write swaps: the windows stay open. */}}
{{template "to_wound_dialog" (dict "CID" .Campaign.ID)}}
{{template "sheet_dialog"}}
{{end}}

{{/* The window of the End match and Confirm sheets on the match page. A button with data-open-modal opens it (dialog.js) and loads the
   sheet into #modal-body, as on a company page; the sheet's Cancel sends close-modal. */}}
{{define "sheet_dialog"}}
<div x-data="{ open: false }" x-effect="document.body.classList.toggle('overflow-hidden', open)" @open-modal.window="open = true" @close-modal.window="open = false" @keydown.escape.window="if (open) open = false">
  <div x-show="open" x-cloak x-transition.opacity class="fixed inset-0 z-[55] flex items-start justify-center overflow-y-auto bg-black/60 p-3 sm:p-6" @click.self="open = false">
    <div class="card relative my-2 w-full max-w-2xl !p-4 sm:!p-6" role="dialog" aria-modal="true" aria-label="End of the match">
      <button type="button" class="absolute right-1 top-1 flex h-11 w-11 items-center justify-center rounded-md text-muted hover:bg-raised hover:text-fg" @click="open = false" aria-label="Close">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <div id="modal-body"><p class="text-muted">Loading…</p></div>
    </div>
  </div>
</div>
{{end}}

{{/* Everything below the back link. A write answers with this alone and htmx swaps it for #match, so the badge, the scenario and the result
   never disagree. Only the current phase is open: Preparing (scenario, Against the Odds), Playing (Go to my company, End match, the scenario
   and the log), Ending (the pending end, the scenario and the log) and Ended (result, aftermath); the rest is folded. */}}
{{define "match_body"}}
{{$m := .Match}}
<div id="match" data-phase="{{.Phase}}">
{{with .Notice}}<div class="alert {{if $.NoticeErr}}alert-danger{{else}}alert-success{{end}} mt-3" role="{{if $.NoticeErr}}alert{{else}}status{{end}}">{{.}}</div>{{end}}
<div class="mt-2 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1"><h1>Match {{$m.Number}}</h1>{{if $m.Practice}}{{template "practice_badge"}}{{end}}{{template "match_result" $m}}</div>
    <p class="mt-1 text-muted break-words">{{fmtDate $m.PlayedOn}}{{with $m.EndedOn}} · Ended {{fmtDate .}}{{end}}{{with $m.Scenario}} · {{.Name}}{{end}}</p>
  </div>
  {{if and .AdminOnEnded $m.Ended (not .AftermathApplied)}}
  <form hx-post="/campaigns/{{.Campaign.ID}}/matches/{{$m.ID}}/reopen" hx-target="#match" hx-swap="outerHTML" class="max-w-sm lg:text-right" x-data>
    <input type="hidden" name="revision" value="{{$m.Revision}}">
    <button class="btn btn-secondary" @click="if (!confirm('Reopen this match? The players will be able to change the scenario and the result again.')) $event.preventDefault()">Reopen match</button>
  </form>
  {{end}}
</div>

{{if $m.Practice}}<p class="alert alert-info mt-4 text-sm" role="note" data-practice-banner>Practice match: no experience, influence, rewards or injuries.</p>{{end}}
{{if and (eq .Campaign.Status "finished") (not $m.Ended)}}<div class="alert alert-info mt-4" role="status">This campaign has ended, so this match is frozen as it was: it stays open, but nothing can be changed until an administrator reactivates the campaign.</div>{{end}}
{{if and (not $m.Ended) (ne .Campaign.Status "finished")}}<div id="end-card-slot" hx-target="this" hx-get="/campaigns/{{.Campaign.ID}}/matches/{{$m.ID}}/end/card" hx-trigger="live:match from:body" hx-swap="innerHTML">{{with $m.EndProposal}}{{template "end_card" $}}{{end}}</div>{{end}}

{{range .SamePlayerNotes}}<p class="alert alert-info mt-4 text-sm" role="status" data-same-player>{{.}}</p>
{{end}}
{{template "scoreboard" .}}
{{if and (not $m.Ended) (ne .Campaign.Status "finished")}}{{template "match_actions" .}}{{end}}

{{if eq .Phase "preparing"}}
  {{template "scenario_card" .}}
  <div id="ato-slot" hx-target="this" hx-sync="this:drop" hx-get="/campaigns/{{.Campaign.ID}}/matches/{{$m.ID}}/ato" hx-trigger="{{if and .Cards .Cards.ATO}}{{else}}load, {{end}}live:match from:body" hx-swap="innerHTML">{{if .Cards}}{{with .Cards.ATO}}{{template "ato_card" .}}{{end}}{{end}}</div>
{{else}}
  {{if $m.Ended}}
  {{template "aftermath_card" .}}
  {{template "result_report" .}}
  {{if .AdminOnEnded}}{{template "result_admin" .}}{{end}}
  {{end}}
  {{if and (not $m.Scenario) .ScenarioOpen}}{{template "scenario_card" .}}{{else}}
  <details class="card mt-6" id="scenario-folded" {{if .InProgress}}open{{end}}>
    <summary class="flex min-h-11 cursor-pointer items-center justify-between gap-3"><span class="font-heading text-xl break-words">Scenario{{with $m.Scenario}} · {{.Name}}{{end}}</span><span class="shrink-0 text-sm text-muted">Details</span></summary>
    <div class="mt-3">{{template "scenario_info" .}}</div>
  </details>{{end}}
{{end}}

{{if .ShowSecret}}<div id="secret-slot" hx-target="this" hx-get="/campaigns/{{.Campaign.ID}}/matches/{{$m.ID}}/secret" hx-trigger="{{if and .Cards .Cards.Secret}}none{{else}}load{{end}}" hx-swap="innerHTML">{{if .Cards}}{{with .Cards.Secret}}{{template "secret_card" .}}{{end}}{{end}}</div>{{end}}

<details class="card mt-6" id="log" {{if .InProgress}}open{{end}}>
  <summary class="flex min-h-11 cursor-pointer items-center justify-between gap-3"><span class="font-heading text-xl">Log</span><span class="text-sm text-muted">History and match log</span></summary>
  {{with $m.History}}
  <div class="mt-3 space-y-2" id="history">
    <h3 class="!text-base font-medium">History</h3>
    <ol class="space-y-1">
      {{range .}}<li class="text-sm"><span class="font-medium">{{if eq .Kind "reopened"}}Reopened{{else}}Ended{{end}}</span> by {{.By}}{{with .Detail}}, {{.}}{{end}} <span class="text-muted">· {{fmtDateTime .On}}</span></li>{{end}}
    </ol>
  </div>
  {{end}}
  {{template "live_log_slot" .}}
</details>
</div>
{{end}}

{{/* One compact row per side: its companies (links) and, once the match has ended, the result. A company that is Broken while the match is
   played is marked. */}}
{{define "scoreboard"}}{{$m := .Match}}
<section class="card mt-6 !p-0" id="scoreboard" aria-label="Sides">
  <ul class="divide-y divide-line">
    {{range $i, $side := $m.Sides}}
    <li class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 px-4 py-3" data-side="{{inc $i}}">
      <span class="min-w-0 break-words">{{range $j, $co := $side.Companies}}{{if $j}} <span class="text-muted">+</span> {{end}}<a href="/campaigns/{{$.Campaign.ID}}/companies/{{.ID}}" class="font-medium {{with $m.Tone $i}}tone-{{.}}{{end}}">{{.Name}}</a> <span class="text-xs text-muted">{{.Owner}}</span>{{with $.Broken .ID}} <span class="badge !bg-danger-soft !text-danger" title="{{.Casualties}} of {{.StartingModels}} casualties">Broken</span>{{end}}{{end}}</span>
      {{with $m.Tone $i}}<span class="badge badge-muted tone-{{.}} shrink-0">{{if eq . "win"}}Won{{else if eq . "loss"}}Lost{{else}}Draw{{end}}</span>{{end}}
    </li>
    {{end}}
  </ul>
</section>
{{end}}

{{/* What a player does next while the match is open: their company page (where the game is played), the To Wound chart and End match. */}}
{{define "match_actions"}}{{$m := .Match}}{{$playing := eq .Phase "playing"}}
<div class="mt-4 flex flex-wrap items-start gap-3" id="match-actions">
  {{range .Mine}}<a href="{{$.SwitchPath .ID}}" class="btn btn-primary {{if $playing}}!min-h-12 !px-6 text-lg{{end}}" data-go-company>Go to {{if gt (len $.Mine) 1}}{{.Name}}{{else}}my company{{end}}</a>{{end}}
  {{template "to_wound_button" (dict "Class" "")}}
  {{if .CanEdit}}{{template "end_propose" (dict "V" . "OOB" false)}}{{end}}
</div>
{{end}}

{{/* The scenario card of the Preparing phase: the scenario and, until the game starts, Change scenario (Roll again, Choose another, One-off). */}}
{{define "scenario_card"}}
{{$m := .Match}}{{$base := printf "/campaigns/%d/matches/%d/scenario" .Campaign.ID $m.ID}}
<section class="card mt-6 space-y-3" id="scenario" {{if .ScenarioOpen}}x-data="{ change: {{if or .Mode (not $m.Scenario)}}true{{else}}false{{end}} }"{{end}}>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 class="!text-xl">Scenario</h2>
    {{if and .ScenarioOpen (not .Mode) $m.Scenario}}<button type="button" class="btn btn-secondary" x-show="!change" @click="change = true" data-change-scenario>Change scenario</button>{{end}}
  </div>
  {{if .ATO.Ambush}}<p class="text-sm text-muted" data-scenario-ambush>Ambush! chose this scenario: change it on the Against the Odds card.</p>{{end}}
  {{with .Roll}}
  <div class="rounded-lg border border-line bg-raised px-3 py-2 text-sm" role="status" id="scenario-roll">
    {{if .First}}<p>Rolled <strong>{{.First}}</strong> (table {{.Table}}) and <strong>{{.Second}}</strong>.</p>{{end}}
    {{with .Line}}<p><span class="badge badge-gold">Vantage Point</span> {{.}}</p>{{end}}
    {{$roll := .}}
    {{range .Vantage}}{{$vo := .}}
    <form hx-post="{{$base}}/roll" hx-target="#match" hx-swap="outerHTML" class="mt-2 flex flex-wrap items-center gap-2">
      <input type="hidden" name="revision" value="{{$m.Revision}}"><input type="hidden" name="roll" value="{{$roll.First}}"><input type="hidden" name="roll2" value="{{$roll.Second}}"><input type="hidden" name="vantage" value="{{$vo.CompanyID}}">
      <span><span class="badge badge-gold">Vantage Point</span> {{$vo.Name}} may move the second die (once):</span>
      <button name="adjust" value="1" class="btn btn-secondary !min-h-9" {{if ge $roll.Second $roll.Sides}}disabled{{end}}>+1</button>
      <button name="adjust" value="-1" class="btn btn-secondary !min-h-9" {{if le $roll.Second 1}}disabled{{end}}>-1</button>
    </form>
    {{end}}
  </div>
  {{end}}
  {{if eq .Mode "pick"}}{{template "scenario_picker" .}}
  {{else if eq .Mode "custom"}}{{template "scenario_custom" .}}
  {{else}}
  {{if .ScenarioOpen}}
  <div class="flex flex-wrap gap-2" x-show="change" {{if $m.Scenario}}x-cloak{{end}} data-scenario-actions>
    <form hx-post="{{$base}}/roll" hx-target="#match" hx-swap="outerHTML"><input type="hidden" name="revision" value="{{$m.Revision}}"><button class="btn btn-primary" data-roll-again>Roll again</button></form>
    <button type="button" class="btn btn-secondary" hx-get="{{$base}}?mode=pick" hx-target="#scenario" hx-swap="outerHTML" data-choose-another>Choose another</button>
    <button type="button" class="btn btn-secondary" hx-get="{{$base}}?mode=custom" hx-target="#scenario" hx-swap="outerHTML">{{if and $m.Scenario (eq $m.Scenario.Kind "custom")}}Edit one-off{{else}}One-off scenario{{end}}</button>
    {{if $m.Scenario}}<button type="button" class="btn btn-ghost" @click="change = false">Keep it</button>{{end}}
  </div>
  {{end}}
  {{template "scenario_info" .}}
  {{end}}
</section>
{{end}}

{{/* What the scenario is: its name and the rulebook text, folded. Takes matchView. */}}
{{define "scenario_info"}}{{$m := .Match}}
  {{with $m.Scenario}}
    <p class="font-medium break-words">{{.Name}}{{if eq .Kind "custom"}} <span class="badge badge-gold align-middle">One-off</span>{{end}}</p>
    {{if eq .Kind "custom"}}
      {{if .Description}}<div><h3 class="text-sm font-medium text-muted">Description</h3><p class="whitespace-pre-line break-words">{{.Description}}</p></div>{{end}}
      {{if .Victory}}<div><h3 class="text-sm font-medium text-muted">How it is won</h3><p class="whitespace-pre-line break-words">{{.Victory}}</p></div>{{end}}
    {{else if $.Info}}
      {{with $.Info.Prizes}}
      <div class="mt-3 space-y-2" aria-label="What the result earns">
        <h3 class="text-sm font-medium text-muted">What the result earns</h3>
        <ul class="grid gap-2 sm:grid-cols-2">
          {{range .}}<li class="rounded-lg border border-line bg-raised px-3 py-2">
            <p class="font-medium">{{.Name}}{{with .Who}} <span class="badge badge-gold align-middle">{{.}}</span>{{end}}</p>
            <p class="mt-1 text-sm text-muted">{{.Text}}</p>
          </li>{{end}}
        </ul>
      </div>
      {{end}}
      {{with $.Info.About}}
      {{if .Roles}}<p class="mt-2 text-sm text-muted">This scenario has an {{index .Roles 0}} and a {{index .Roles 1}}: settle them at the table.</p>{{end}}
      <details class="mt-2 rounded-lg border border-line px-3 py-2" {{if $.InProgress}}open{{end}}><summary class="flex min-h-11 cursor-pointer items-center text-sm font-medium">About this scenario</summary>
        <div class="mt-2 space-y-3 text-sm">
          {{with .Outline}}<p class="font-medium break-words">{{.}}</p>{{end}}
          {{with .Description}}<p class="whitespace-pre-line break-words">{{.}}</p>{{end}}
          {{range .Sections}}<div><h3 class="text-sm font-medium text-muted">{{.Title}}</h3><p class="whitespace-pre-line break-words">{{.Text}}</p></div>{{end}}
        </div>
      </details>
      {{with .Rules}}
      <details class="mt-2 rounded-lg border border-line px-3 py-2" {{if $.InProgress}}open{{end}}><summary class="flex min-h-11 cursor-pointer items-center text-sm font-medium">Special rules</summary>
        <div class="mt-2 space-y-3 text-sm">
          {{range .}}<div><h3 class="text-sm font-medium text-muted">{{.Title}}</h3><p class="whitespace-pre-line break-words">{{.Text}}</p>{{with .Table}}{{template "rule_table" (dict "T" . "Combined" $.Combined)}}{{end}}</div>{{end}}
          {{with $.Info.About.Uses}}<p class="text-muted">Also in play, as the rulebook has them: {{join . ", "}}.</p>{{end}}
        </div>
      </details>
      {{end}}
      {{end}}
      {{if $.Info.Scoring}}
      <details class="mt-2 rounded-lg border border-line px-3 py-2" {{if $.InProgress}}open{{end}}><summary class="flex min-h-11 cursor-pointer items-center text-sm font-medium">How it is scored</summary>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">{{range $.Info.Scoring}}<li>{{.}}</li>{{end}}</ul>
      </details>
      {{end}}
    {{end}}
  {{else}}
    <p class="text-muted">{{if .Editor}}No scenario yet: roll for it, or choose one.{{else}}The players have not chosen a scenario yet.{{end}}</p>
  {{end}}
{{end}}

{{/* The picker: the rules file's scenarios by table, searched in the browser. One press sets the scenario. */}}
{{define "scenario_picker"}}
{{$m := .Match}}{{$base := printf "/campaigns/%d/matches/%d/scenario" .Campaign.ID $m.ID}}{{$cur := ""}}{{with $m.Scenario}}{{if eq .Kind "rulebook"}}{{$cur = .Name}}{{end}}{{end}}
<div x-data="listSearch" class="space-y-4">
  {{with .ScenarioErr}}{{with index . ""}}<div class="alert alert-danger" role="alert">{{.}}</div>{{end}}{{end}}
  <div class="field">
    <label for="scenario-search">Search the scenarios</label>
    <input id="scenario-search" type="search" x-model="q" placeholder="Name of a scenario…" autocomplete="off" class="input">
  </div>
  <p class="text-sm text-muted" x-show="noMatch()" x-cloak>No scenario matches.</p>
  {{range .Groups}}{{$title := .Title}}
  <div class="space-y-1" x-show="catShows({{jsstr $title}})">
    <p class="text-sm font-semibold text-muted">{{$title}}</p>
    <ul class="grid gap-1 sm:grid-cols-2">
      {{range .Scenarios}}<li data-name="{{.Name}}" data-category="{{$title}}" x-show="shows($el)">
        <form hx-post="{{$base}}" hx-target="#match" hx-swap="outerHTML">
          <input type="hidden" name="revision" value="{{$m.Revision}}"><input type="hidden" name="kind" value="rulebook"><input type="hidden" name="name" value="{{.Name}}">
          <button class="btn btn-secondary w-full !h-auto !min-h-11 !justify-start !whitespace-normal !px-3 !py-2 text-left {{if eq .Name $cur}}!border-accent !bg-accent-soft{{end}}">
            <span class="min-w-0"><span class="font-medium">{{.Name}}</span>{{if .Roll}} <span class="text-xs font-normal text-muted">(second die {{.Roll}})</span>{{end}}{{with .Scoring}}<span class="line-clamp-2 block text-sm font-normal text-muted">{{index . 0}}</span>{{end}}</span>
          </button>
        </form></li>{{end}}
    </ul>
  </div>
  {{else}}<p class="text-muted">The rules of this campaign list no scenarios.</p>{{end}}
  <button type="button" class="btn btn-secondary" hx-get="{{$base}}" hx-target="#scenario" hx-swap="outerHTML">Cancel</button>
</div>
{{end}}

{{/* The one-off scenario form: a scenario the players invented. It is kept with this match only. */}}
{{define "scenario_custom"}}
{{$m := .Match}}{{$base := printf "/campaigns/%d/matches/%d/scenario" .Campaign.ID $m.ID}}{{$e := .ScenarioErr}}
<form hx-post="{{$base}}" hx-target="#match" hx-swap="outerHTML" class="space-y-4" x-data="{ n: 0, d: 0, v: 0 }" x-init="n = $refs.n.value.length; d = $refs.d.value.length; v = $refs.v.value.length">
  <input type="hidden" name="revision" value="{{$m.Revision}}">
  <input type="hidden" name="kind" value="custom">
  {{with index $e ""}}<div class="alert alert-danger" role="alert">{{.}}</div>{{end}}
  <p class="text-sm text-muted">Players are trusted: the app does not check the victory conditions. It is kept with this match only and is not offered to other matches.</p>
  <div class="field">
    <label for="scenario-name">Name</label>
    <input id="scenario-name" name="name" value="{{.ScenarioIn.Name}}" x-ref="n" @input="n = $event.target.value.length" maxlength="60" required autocomplete="off" class="input" {{with index $e "name"}}aria-invalid="true" aria-describedby="scenario-name-err"{{end}}>
    {{with index $e "name"}}<p class="error" id="scenario-name-err" role="alert">{{.}}</p>{{end}}
    <p class="hint"><span x-text="n">0</span> / 60</p>
  </div>
  <div class="field">
    <label for="scenario-description">Description <span class="text-muted">(optional)</span></label>
    <textarea id="scenario-description" name="description" rows="4" x-ref="d" @input="d = $event.target.value.length" maxlength="1000" class="input" {{with index $e "description"}}aria-invalid="true" aria-describedby="scenario-description-err"{{end}}>{{.ScenarioIn.Description}}</textarea>
    {{with index $e "description"}}<p class="error" id="scenario-description-err" role="alert">{{.}}</p>{{end}}
    <p class="hint"><span x-text="d">0</span> / 1000</p>
  </div>
  <div class="field">
    <label for="scenario-victory">How it is won <span class="text-muted">(optional)</span></label>
    <textarea id="scenario-victory" name="victory" rows="4" x-ref="v" @input="v = $event.target.value.length" maxlength="1000" class="input" {{with index $e "victory"}}aria-invalid="true" aria-describedby="scenario-victory-err"{{end}}>{{.ScenarioIn.Victory}}</textarea>
    {{with index $e "victory"}}<p class="error" id="scenario-victory-err" role="alert">{{.}}</p>{{end}}
    <p class="hint"><span x-text="v">0</span> / 1000</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <button class="btn btn-primary" :disabled="n === 0">Save one-off scenario</button>
    <button type="button" class="btn btn-secondary" hx-get="{{$base}}" hx-target="#scenario" hx-swap="outerHTML">Cancel</button>
  </div>
</form>
{{end}}

{{/* A table a scenario special rule prints. Takes {T: core.ScenarioRuleTable, Combined: the companies' ratings added}; the row that covers the
   match's combined rating is marked when the table looks that up. */}}
{{define "rule_table"}}{{$t := .T}}{{$hit := -1}}{{if and (eq $t.Lookup "combinedRating") .Combined}}{{$hit = $t.RowFor .Combined}}{{end}}
<table class="mt-2 w-full table-fixed border-collapse overflow-hidden rounded-lg border border-line text-sm">
  <thead class="bg-raised text-left text-muted"><tr>{{range $i, $c := $t.Columns}}<th scope="col" class="px-3 py-1.5 font-medium {{if eq $i 0}}w-2/5 sm:w-1/4{{end}}">{{$c}}</th>{{end}}</tr></thead>
  <tbody>
    {{range $i, $row := $t.Rows}}<tr class="border-t border-line {{if eq $i $hit}}bg-accent-soft font-semibold{{end}}" {{if eq $i $hit}}aria-current="true"{{end}}>{{range $j, $c := $row.Cells}}{{if eq $j 0}}<th scope="row" class="px-3 py-1.5 text-left align-top font-medium">{{$c}}</th>{{else}}<td class="break-words px-3 py-1.5 align-top">{{$c}}</td>{{end}}{{end}}</tr>{{end}}
  </tbody>
</table>
{{if ge $hit 0}}<p class="mt-1 text-xs text-muted">Highlighted: the companies in this match add up to {{.Combined}} rating.</p>{{else if eq $t.Lookup "combinedRating"}}<p class="mt-1 text-xs text-muted">Look up the two companies' ratings added together.</p>{{else if $t.TableDice.Valid}}<p class="mt-1 text-xs text-muted">Roll {{if eq $t.TableDice.Count 1}}a {{end}}{{$t.TableDice.Display}} and read the matching row.</p>{{end}}
{{end}}

{{/* The result of an ended match: who won, the reward ticks and the note. */}}
{{define "result_report"}}
{{$m := .Match}}
<section class="card mt-6 space-y-2" id="result">
  <h2 class="!text-xl">Result</h2>
  {{if $m.Result.Decided}}
    <p class="font-medium">{{with $m.ReportedWinner}}<span class="tone-win">{{.}}</span> won{{else}}<span class="tone-draw">Draw</span>{{end}}</p>
  {{else}}
    <p class="text-muted">Nothing was reported.</p>
  {{end}}
  {{range $m.Sides}}{{range .Companies}}{{$co := $m.Result.Company .ID}}{{if $co.Objectives}}{{$name := .Name}}
    <p class="text-sm"><span class="font-medium">{{$name}}</span> completed: {{range $.Objectives}}{{if index $co.Objectives .Key}}{{.Label}}{{if gt (index $co.Objectives .Key) 1}} (x{{index $co.Objectives .Key}}){{end}}. {{end}}{{end}}</p>
  {{end}}{{end}}{{end}}
  {{with $m.Result.Note}}<p class="whitespace-pre-line break-words">{{.}}</p>{{end}}
</section>
{{end}}

{{/* The organiser's or an administrator's correction of an ended match's result, behind a button. */}}
{{define "result_admin"}}
{{$m := .Match}}{{$d := .Draft}}
<section class="card mt-6 space-y-4" id="result-admin" x-data="{ open: {{if .ResultErr}}true{{else}}false{{end}} }">
  <button type="button" class="btn btn-secondary" x-show="!open" @click="open = true">Edit the result (organiser or administrator)</button>
  <div x-show="open" {{if not .ResultErr}}x-cloak{{end}} class="space-y-4">
    {{if .AftermathApplied}}<div class="alert alert-info" role="note">A company has already played its aftermath; changes here do not redo it.</div>{{else}}<div class="alert alert-info" role="note">No aftermath has started yet, so the new result will be used when the companies start theirs.</div>{{end}}
    <form hx-post="/campaigns/{{.Campaign.ID}}/matches/{{$m.ID}}/result" hx-target="#match" hx-swap="outerHTML" class="space-y-4">
      <input type="hidden" name="revision" value="{{$m.Revision}}">
      {{with .ResultErr}}<div class="alert alert-danger" role="alert">{{.}}</div>{{end}}
      {{template "winner_buttons" (dict "M" $m "Winner" .WinnerValue)}}
      {{range $m.Sides}}{{range .Companies}}{{$co := $d.Result.Company .ID}}{{$cid := .ID}}{{if $.Objectives}}
      <p class="flex flex-wrap items-center gap-2 text-sm"><span class="font-medium">{{.Name}}</span>
        {{range $.Objectives}}{{if le .Max 1}}<label class="inline-flex"><input type="checkbox" class="peer sr-only" name="tick-{{$cid}}-{{.Key}}" value="1" {{if index $co.Objectives .Key}}checked{{end}}><span class="chip cursor-pointer !text-fg peer-checked:border-accent peer-checked:bg-accent-soft peer-checked:before:mr-1 peer-checked:before:content-['✓'] peer-focus-visible:outline-2 peer-focus-visible:outline-accent">{{.Label}}</span></label>
        {{else}}<label class="inline-flex items-center gap-1">{{.Label}} <input type="number" name="tick-{{$cid}}-{{.Key}}" min="0" max="{{.Max}}" value="{{index $co.Objectives .Key}}" class="input !min-h-9 w-16"></label>{{end}}{{end}}</p>
      {{end}}{{end}}{{end}}
      <div class="field">
        <label for="result-note">A word about the game <span class="text-muted">(optional)</span></label>
        <textarea id="result-note" name="note" rows="3" maxlength="500" class="input">{{$d.Result.Note}}</textarea>
      </div>
      <button class="btn btn-primary">Save result</button>
    </form>
  </div>
</section>
{{end}}

{{/* The winner as buttons: each side by its companies, and Draw. Takes {M: core.Match, Winner: "", "draw" or the side}. */}}
{{define "winner_buttons"}}
<fieldset class="space-y-2">
  <legend class="text-sm font-semibold">Who won?</legend>
  <div class="grid gap-2 sm:grid-cols-2">
    {{range $i, $side := .M.Sides}}
    <label class="flex min-h-11 cursor-pointer items-center gap-3 rounded-lg border border-line px-3 py-2 hover:bg-raised has-[:checked]:border-accent has-[:checked]:bg-accent-soft">
      <input type="radio" name="winner" value="{{inc $i}}" {{if eq $.Winner (printf "%d" (inc $i))}}checked{{end}} class="size-4 shrink-0 accent-accent"><span class="min-w-0 break-words font-medium">{{$side.Label}}</span>
    </label>
    {{end}}
    <label class="flex min-h-11 cursor-pointer items-center gap-3 rounded-lg border border-line px-3 py-2 hover:bg-raised has-[:checked]:border-accent has-[:checked]:bg-accent-soft">
      <input type="radio" name="winner" value="draw" {{if eq .Winner "draw"}}checked{{end}} class="size-4 shrink-0 accent-accent"><span>Draw</span>
    </label>
  </div>
</fieldset>
{{end}}

{{/* The Aftermath card of an ended match: each company with its status and the way in (docs/aftermath.md). */}}
{{define "aftermath_card"}}
<section class="card mt-6 space-y-4" id="aftermath">
  <h2 class="!text-xl">Aftermath</h2>
  {{with .AftermathErr}}<div class="alert alert-danger" role="alert">{{.}}</div>
  {{else}}
  {{if not .Aftermath}}<p class="text-muted">No company took part in this match.</p>{{end}}
  <ul class="divide-y divide-line">
    {{range .Aftermath}}
    <li class="space-y-2 py-3 first:pt-0 last:pb-0" {{if .Waive}}x-data="{ waiving: false }"{{end}}>
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
        <div class="min-w-0">
          <p class="flex flex-wrap items-center gap-x-2 gap-y-1"><a href="/campaigns/{{$.Campaign.ID}}/companies/{{.Ref.CompanyID}}" class="font-medium break-words">{{.Ref.CompanyName}}</a> {{if $.Match.Practice}}<span class="text-sm text-muted" data-practice-aftermath>Aftermath: nothing to roll (practice match)</span>{{else}}{{template "aftermath_badge" .Ref.Status}}{{end}}</p>
          {{with .Owner}}<p class="text-sm text-muted">{{.}}</p>{{end}}
        </div>
        <div class="flex flex-wrap items-center gap-2">
          {{if and .Edit (eq (printf "%s" .Ref.Status) "pending")}}
          <form method="post" action="/campaigns/{{$.Campaign.ID}}/matches/{{.Ref.MatchID}}/aftermath/{{.Ref.CompanyID}}/begin" class="contents"><button class="btn btn-primary">Start aftermath<span class="sr-only"> of {{.Ref.CompanyName}}</span></button></form>
          {{else}}
          <a class="btn {{if and .Edit .Ref.Status.Locks (not $.Match.Practice)}}btn-primary{{else}}btn-secondary{{end}}" href="/campaigns/{{$.Campaign.ID}}/matches/{{.Ref.MatchID}}/aftermath/{{.Ref.CompanyID}}">{{if and .Edit .Ref.Status.Locks}}Continue<span class="sr-only"> of {{.Ref.CompanyName}}</span>{{else}}View<span class="sr-only"> the aftermath of {{.Ref.CompanyName}}</span>{{end}}</a>
          {{end}}
          {{if .Waive}}<button type="button" class="btn btn-ghost" x-show="!waiving" @click="waiving = true" :aria-expanded="waiving">Waive<span class="sr-only"> the aftermath of {{.Ref.CompanyName}}</span></button>{{end}}
        </div>
      </div>
      {{with .Summary}}<p class="text-sm text-muted break-words">{{.}}</p>{{end}}
      {{if .Waive}}
      <form hx-post="/campaigns/{{$.Campaign.ID}}/matches/{{.Ref.MatchID}}/aftermath/{{.Ref.CompanyID}}/waive" hx-target="#match" hx-swap="outerHTML" x-show="waiving" x-cloak class="space-y-2 rounded-xl border border-line bg-raised p-3">
        <div class="field"><label for="waive-{{.Ref.CompanyID}}">Why is this aftermath waived? <span class="text-muted">(everybody can read it)</span></label>
          <input id="waive-{{.Ref.CompanyID}}" name="note" class="input" maxlength="200" required autocomplete="off"></div>
        <p class="text-sm text-muted">Nothing is applied: no experience, influence or injuries. The company is unlocked.</p>
        <div class="flex flex-wrap gap-2"><button class="btn btn-danger">Waive aftermath</button><button type="button" class="btn btn-ghost" @click="waiving = false">Cancel</button></div>
      </form>
      {{end}}
    </li>
    {{end}}
  </ul>
  {{end}}
</section>
{{end}}

{{/* The match log: the card of the match page and the rows of an older page. The log is kept for good: after the match it stays here, read
   only. Takes liveLogView. */}}
{{define "live_log_card"}}
<section id="live-log" data-live-log class="card mt-6 space-y-3" aria-labelledby="live-log-title">
  <h2 id="live-log-title" class="!text-2xl">Match log</h2>
  {{if and .Ended (not .Entries)}}<p class="text-muted">This match has no log: it was recorded after the fact.</p>{{else}}{{template "live_log_body" .}}{{end}}
</section>
{{end}}

{{define "live_log_body"}}
{{with .Error}}<div class="alert alert-danger mt-3" role="alert">{{.}}</div>{{end}}
{{if not .Entries}}<p class="mt-3 text-muted">Nothing has happened yet.</p>{{else}}
<ol class="mt-3 divide-y divide-line rounded-lg border border-line" aria-label="Match log">
  {{template "live_log_rows" .}}
</ol>
{{end}}
{{end}}

{{define "live_log_rows"}}{{$v := .}}
{{range .Entries}}
{{if .Heading}}<li class="bg-raised px-3 py-1 text-xs font-semibold text-muted">{{.Heading}}</li>{{end}}
<li class="flex items-start gap-3 px-3 py-2">
  <span class="mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full" style="background: hsl({{.Hue}} 55% 50%)" title="{{.Company}}" aria-hidden="true"></span>
  <div class="min-w-0 flex-1"><p class="break-words text-sm">{{.Text}}</p><p class="text-xs text-muted">{{.Company}}{{with .By}} · {{.}}{{end}}</p></div>
  {{if and .CanUndo (not $v.Ended)}}<button type="button" class="btn btn-secondary !min-h-9 shrink-0 !px-3 !text-xs" hx-post="/campaigns/{{$v.Campaign}}/matches/{{$v.MatchID}}/live/log/{{.ID}}/undo" hx-vals='{"from":"card"}' hx-target="#live-log" hx-swap="outerHTML" hx-sync="this:queue all" aria-label="Undo: {{.Text}}">Undo</button>{{end}}
</li>
{{end}}
{{if .Older}}<li class="px-3 py-2 text-center"><button type="button" class="btn btn-ghost !min-h-9" hx-get="/campaigns/{{$v.Campaign}}/matches/{{$v.MatchID}}/live/log?before={{.Older}}" hx-target="closest li" hx-swap="outerHTML">Show older entries</button></li>{{end}}
{{end}}

{{/* The log card on the match page: loaded after the page, refreshed when the match changes (the sync script fires live:match). */}}
{{define "live_log_slot"}}
<div id="live-log-slot" hx-target="this" hx-get="/campaigns/{{.Campaign.ID}}/matches/{{.Match.ID}}/live/log" {{$lazy := not (and .Cards .Cards.Log)}}hx-trigger="{{if or $lazy (not .Match.Ended)}}{{if $lazy}}load{{end}}{{if not .Match.Ended}}{{if $lazy}}, {{end}}live:match from:body{{end}}{{else}}none{{end}}" hx-swap="innerHTML" {{if not .Match.Ended}}data-live-match="{{.Match.ID}}" data-campaign="{{.Campaign.ID}}"{{with .LiveSince}} data-live-since="{{.}}"{{end}}{{end}}>{{if .Cards}}{{with .Cards.Log}}{{template "live_log_card" .}}{{end}}{{end}}</div>
{{end}}

{{/* The End match button, hidden while an end is pending. The card's slot sends it again out of band when the match changes. Takes V (matchView) and OOB. */}}
{{define "end_propose"}}{{$v := .V}}{{$m := $v.Match}}
<span id="end-propose" class="inline-flex flex-col" {{if .OOB}}hx-swap-oob="true"{{end}}>
  {{if not $m.EndProposal}}
  <button type="button" class="btn {{if eq $v.Phase "playing"}}btn-primary !min-h-12 !px-6 text-lg{{else}}btn-secondary{{end}}" {{if $v.EndReason}}disabled aria-describedby="end-reason"{{end}} hx-get="/campaigns/{{$v.Campaign.ID}}/matches/{{$m.ID}}/end/sheet" hx-target="#modal-body" hx-swap="innerHTML" data-open-modal data-end-match>End match</button>
  {{with $v.EndReason}}<span id="end-reason" class="mt-1 text-sm text-muted">{{.}}</span>{{end}}
  {{end}}
</span>
{{end}}

{{/* What the card's slot answers: the pending end, and the End match button in step with it. Takes matchView. */}}
{{define "end_card_slot"}}{{with .Match.EndProposal}}{{template "end_card" $}}{{end}}{{if .CanEdit}}{{template "end_propose" (dict "V" . "OOB" true)}}{{end}}{{end}}

{{/* The pending end of the match: "Hador proposes to end: Rohan won", who has confirmed, then what the viewer may do. Confirm opens the
   Confirm sheet. Takes matchView. */}}
{{define "end_card"}}{{$m := .Match}}{{$p := $m.EndProposal}}{{$base := printf "/campaigns/%d/matches/%d/end" .Campaign.ID $m.ID}}
<section id="end-card" class="alert alert-info mt-4 space-y-3" aria-labelledby="end-card-title">
  <h2 id="end-card-title" class="!text-xl">{{$p.ProposedBy}} proposes to end: {{.ProposedResult}}</h2>
  <p class="text-sm text-muted">{{fmtDateTime $p.ProposedOn}} · it ends when every company has confirmed.</p>
  {{with $p.Notice}}<p class="text-sm font-medium" role="status">{{.}}</p>{{end}}
  <ul class="flex flex-wrap gap-2" aria-label="Confirmations">
    {{range $p.Companies}}<li class="badge {{if .Confirmed}}badge-gold{{else}}badge-muted{{end}}" title="{{template "end_owner" (dict "M" $m "ID" .CompanyID)}}">{{if .Confirmed}}<span aria-hidden="true">&#10003;</span> {{.CompanyName}}{{if .Override}} (override){{end}}{{else}}<span aria-hidden="true">&#9719;</span> {{.CompanyName}} waiting{{end}}</li>{{end}}
  </ul>
  {{with .End}}
  <div class="flex flex-wrap gap-2">
    {{if .CanConfirm}}<button type="button" class="btn btn-primary" hx-get="/campaigns/{{$.Campaign.ID}}/matches/{{$m.ID}}/end/sheet" hx-target="#modal-body" hx-swap="innerHTML" data-open-modal data-confirm-end>Confirm</button>{{end}}
    {{if .CanWithdraw}}<form hx-post="{{$base}}/withdraw" hx-target="#match" hx-swap="outerHTML"><input type="hidden" name="revision" value="{{$m.Revision}}"><button class="btn btn-secondary">Withdraw my confirmation</button></form>{{end}}
    {{if .CanCancel}}<form hx-post="{{$base}}/cancel" hx-target="#match" hx-swap="outerHTML"><input type="hidden" name="revision" value="{{$m.Revision}}"><button class="btn btn-secondary">Keep playing</button></form>{{end}}
  </div>
  {{if .CanOverride}}{{template "end_override" (dict "Base" $base "Rev" $m.Revision "P" $p "Note" $.OverrideNote "Err" $.OverrideErr "Target" "#match" "Extra" "")}}{{end}}
  {{if and (not .CanConfirm) (not .CanWithdraw) (not .CanCancel) (not .CanOverride)}}<p class="text-sm text-muted">{{with .Reason}}{{.}}{{else}}Waiting for the players.{{end}}</p>{{end}}
  {{end}}
</section>
{{end}}

{{/* The End match sheet (no end pending) and the Confirm sheet: the winner, the MVP of every opposing company, the objective review and the
   reward ticks of the viewer's own companies, and the note. Submitting proposes (or confirms) the end in one request. Takes endSheetView. */}}
{{define "end_sheet"}}{{$v := .}}{{$m := .Match}}
<div id="end-sheet" data-end-sheet>
  <h2 class="!text-2xl pr-10">{{if .Confirm}}Confirm the end{{else}}End match{{end}}</h2>
  {{if .Confirm}}<p class="mt-1">{{$m.EndProposal.ProposedBy}} proposes: <strong>{{.ProposedResult}}</strong>.</p>{{end}}
  {{with .Errors}}<div class="alert alert-danger mt-3" role="alert"><ul class="space-y-1">{{range .}}<li>{{.}}</li>{{end}}</ul></div>{{end}}
  <form hx-post="{{.PostURL}}" hx-target="#end-sheet" hx-swap="outerHTML" class="mt-4 space-y-5" x-data="{ change: {{if and .Confirm (not .Errors)}}false{{else}}true{{end}} }">
    <input type="hidden" name="revision" value="{{$m.Revision}}">
    {{with .Company}}<input type="hidden" name="company" value="{{.}}">{{end}}
    {{if .Confirm}}
    <div>
      <button type="button" class="text-sm underline" x-show="!change" @click="change = true" data-change-result>Change result</button>
      <div x-show="change" x-cloak class="space-y-2">{{template "winner_buttons" (dict "M" $m "Winner" .Winner)}}
        <p class="text-sm text-muted">Changing the result asks the other players to confirm again.</p></div>
    </div>
    {{else}}{{template "winner_buttons" (dict "M" $m "Winner" .Winner)}}{{end}}

    {{range .Ballots}}{{$b := .}}
    <div class="field" x-data="unitPick" data-units="{{$v.UnitsJSON .}}" data-current="{{$v.Vote .CompanyID}}" data-mvp-ballot="{{.Name}}">
      <label for="mvp-q-{{.CompanyID}}">MVP of {{.Name}} <span class="text-muted">{{if $m.Practice}}(recorded only){{else}}· {{$v.MVPXP}} experience{{end}}</span></label>
      <input type="hidden" name="mvp-{{.CompanyID}}" :value="id || ''" value="{{with $v.Vote .CompanyID}}{{.}}{{end}}">
      <div class="relative" @click.outside="open = false" @keydown.escape.stop="open = false">
        <input id="mvp-q-{{.CompanyID}}" type="search" x-model="q" @focus="open = true" @input="open = true; id = 0" value="{{$v.VoteName $b}}" placeholder="Search the units of {{.Name}}…" autocomplete="off" class="input" role="combobox" :aria-expanded="open" aria-autocomplete="list"
               @keydown.enter="if (results().length) { $event.preventDefault(); pick(results()[0]) }">
        <ul x-show="open" x-cloak class="card absolute inset-x-0 z-10 mt-1 max-h-56 overflow-y-auto !p-1 shadow-lg" role="listbox">
          <template x-for="u in results()" :key="u.id">
            <li role="option" :aria-selected="u.id === id"><button type="button" class="flex w-full flex-col rounded-md px-3 py-2 text-left hover:bg-raised" :class="u.id === id && 'bg-accent-soft'" @click="pick(u)">
              <span class="font-medium" x-text="u.title"></span><span class="text-xs text-muted" x-text="u.detail"></span>
            </button></li>
          </template>
          <li class="px-3 py-2 text-sm text-muted" x-show="results().length === 0">No unit matches.</li>
        </ul>
      </div>
    </div>
    {{end}}

    {{range .Objectives}}{{if .Units}}
    <fieldset class="min-w-0 space-y-2">
      <legend class="text-sm font-semibold break-words">Objective · {{.Name}} <span class="font-normal text-muted">{{if $m.Practice}}(recorded only){{else}}· {{$v.ObjectiveXP}} experience each{{end}}</span></legend>
      <p class="text-sm text-muted">Carrying or within range of an Objective at the end of the game (escaping off the board edge counts).</p>
      <div class="flex flex-wrap gap-1.5">
        {{range .Units}}<label class="inline-flex max-w-full"><input type="checkbox" class="peer sr-only" name="objective-{{.UnitID}}" value="1" {{if index $v.Has .UnitID}}checked{{end}}>
          <span class="chip cursor-pointer !text-fg peer-checked:border-accent peer-checked:bg-accent-soft peer-checked:before:mr-1 peer-checked:before:content-['✓'] peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent">{{.Title}}{{if eq (printf "%v" .Zone) "retreated"}} <span class="text-muted">· retreated</span>{{end}}</span></label>{{end}}
      </div>
    </fieldset>
    {{end}}{{end}}

    {{if .Rewards}}{{range .Tickers}}{{$co := .}}
    <p class="flex flex-wrap items-center gap-1.5 text-sm" data-reward-ticks><span class="font-medium">{{.Name}}:</span>
      {{range $v.Rewards}}{{if le .Max 1}}<label class="inline-flex"><input type="checkbox" class="peer sr-only" name="tick-{{$co.ID}}-{{.Key}}" value="1" {{if $v.Tick $co.ID .Key}}checked{{end}}><span class="chip cursor-pointer !text-fg peer-checked:border-accent peer-checked:bg-accent-soft peer-checked:before:mr-1 peer-checked:before:content-['✓'] peer-focus-visible:outline-2 peer-focus-visible:outline-accent" title="{{range .Rewards}}{{.Preview}} {{end}}">{{.Label}}</span></label>
      {{else}}<label class="inline-flex items-center gap-1">{{.Label}} <input type="number" name="tick-{{$co.ID}}-{{.Key}}" min="0" max="{{.Max}}" value="{{$v.Tick $co.ID .Key}}" class="input !min-h-9 w-16"></label>{{end}}{{end}}
    </p>
    {{end}}{{end}}

    <div class="field">
      <label for="end-note">A word about the game <span class="text-muted">(optional)</span></label>
      <textarea id="end-note" name="note" rows="2" maxlength="500" class="input">{{.Note}}</textarea>
    </div>
    <p class="text-sm text-muted">{{if .Confirm}}The match ends when every player has confirmed.{{else}}The match ends when the other players confirm. Afterwards only the organiser or an administrator can change it.{{end}}{{if $m.Practice}} No aftermath will follow.{{end}}</p>
    <div class="flex flex-wrap gap-2">
      <button class="btn btn-primary">{{if .Confirm}}Confirm{{else}}End match{{end}}</button>
      <button type="button" class="btn btn-secondary" @click="$dispatch('close-modal')">Cancel</button>
    </div>
  </form>
</div>
{{end}}

{{define "end_owner"}}{{range .M.Sides}}{{range .Companies}}{{if eq .ID $.ID}}{{.Owner}}{{end}}{{end}}{{end}}{{end}}

{{/* The secret objectives of the scenario (Fog of War): the viewer's own notes while the match is open, everybody's after it. Takes secretView. */}}
{{define "secret_card"}}{{$v := .}}
{{if or .Mine .Revealed .Others}}
<section id="secret-objectives" class="card mt-6 space-y-4" aria-labelledby="secret-title">
  <h2 id="secret-title" class="!text-xl">Secret objectives</h2>
  {{if .Ended}}
    <p class="text-sm text-muted">The match is over: the notes are revealed.</p>
    {{if not .Revealed}}<p class="text-muted">Nobody noted a secret objective.</p>{{end}}
    <ul class="divide-y divide-line">
      {{range .Revealed}}<li class="py-2 text-sm"><span class="font-medium">{{.Company}}</span> · {{if .Label}}{{.Label}}{{else}}{{.Text}}{{end}}{{with .Nominee}}<br><span class="text-muted">Noted: {{.}}</span>{{end}}<br>{{if .Tier}}<span class="badge badge-gold">Scored {{.Points}} VP</span>{{else}}<span class="text-muted">No score reported.</span>{{end}}</li>{{end}}
    </ul>
  {{else}}
  <p class="text-sm text-muted">Note these down at the start and report what you reached at the end. Only you see your entries until the match ends, then everybody does.</p>
  <div aria-live="polite">
  {{with .Msg}}<div class="alert {{if $v.Error}}alert-danger{{else}}alert-success{{end}} flex flex-wrap items-center justify-between gap-2" role="{{if $v.Error}}alert{{else}}status{{end}}"><span>{{.}}</span>
    {{if and (not $v.Error) $v.EntryID}}<button type="button" class="btn btn-secondary !min-h-9" hx-post="/campaigns/{{$v.Campaign}}/matches/{{$v.MatchID}}/live/log/{{$v.EntryID}}/undo" hx-vals='{"from":"secret"}' hx-target="#secret-objectives" hx-swap="outerHTML">Undo</button>{{end}}</div>{{end}}
  </div>
  {{range .Mine}}{{$co := .}}
  <div class="space-y-3">
    <h3 class="!text-base font-medium break-words">{{.Name}}</h3>
    {{range .Objectives}}{{$o := .}}
    <fieldset class="min-w-0 space-y-2 rounded-lg border border-line p-3">
      <legend class="px-1 text-sm font-medium">{{if .Label}}{{.Label}}{{else}}{{.Key}}{{end}}</legend>
      <p class="text-sm break-words">{{.Instruction}}</p>
      {{with .Nomination}}
      <form hx-post="/campaigns/{{$v.Campaign}}/matches/{{$v.MatchID}}/secret/{{$co.ID}}" hx-target="#secret-objectives" hx-swap="outerHTML" class="space-y-2">
        <input type="hidden" name="kind" value="nominate"><input type="hidden" name="key" value="{{$o.Key}}">
        {{if eq .From "terrain"}}
        <div class="field"><label for="n-{{$co.ID}}-{{$o.Key}}">The terrain piece{{if eq .Where "opponentHalf"}} (wholly in the opponent's half){{end}}</label>
          <input id="n-{{$co.ID}}-{{$o.Key}}" name="note" maxlength="120" value="{{$o.Nominee}}" class="input" placeholder="For example: the ruined tower"></div>
        {{else}}
        <div class="field"><label for="n-{{$co.ID}}-{{$o.Key}}">{{if eq .From "ownHeroes"}}One of your Heroes{{else}}A Hero of the opponent{{end}}</label>
          <select id="n-{{$co.ID}}-{{$o.Key}}" name="unit" class="input"><option value="0">None</option>{{range $o.Heroes}}<option value="{{.ID}}" {{if .Selected}}selected{{end}}>{{.Label}}</option>{{end}}</select></div>
        {{end}}
        <button class="btn btn-secondary">Save note</button>
        {{if $o.Nominee}}<span class="ml-2 text-sm text-muted">Noted: {{$o.Nominee}}</span>{{end}}
      </form>
      {{end}}
      <form hx-post="/campaigns/{{$v.Campaign}}/matches/{{$v.MatchID}}/secret/{{$co.ID}}" hx-target="#secret-objectives" hx-swap="outerHTML" class="space-y-2">
        <input type="hidden" name="kind" value="done"><input type="hidden" name="key" value="{{$o.Key}}">
        <p class="text-sm font-medium">What you reached</p>
        <div class="grid gap-2" role="radiogroup" aria-label="Tier reached for {{$o.Label}}">
          <label class="flex min-h-11 cursor-pointer items-start gap-3 rounded-lg border border-line px-3 py-2 hover:bg-raised has-[:checked]:border-accent has-[:checked]:bg-accent-soft"><input type="radio" name="tier" value="0" {{if eq $o.Tier 0}}checked{{end}} class="mt-1 size-4 shrink-0 accent-accent"><span class="text-sm">Not reached yet</span></label>
          {{range $i, $t := .Options}}<label class="flex min-h-11 cursor-pointer items-start gap-3 rounded-lg border border-line px-3 py-2 hover:bg-raised has-[:checked]:border-accent has-[:checked]:bg-accent-soft"><input type="radio" name="tier" value="{{inc $i}}" {{if eq $o.Tier (inc $i)}}checked{{end}} class="mt-1 size-4 shrink-0 accent-accent"><span class="min-w-0 break-words text-sm"><strong>{{$t.Points}} VP</strong> · {{$t.Text}}</span></label>{{end}}
        </div>
        <button class="btn btn-secondary">Save</button>
      </form>
    </fieldset>
    {{end}}
  </div>
  {{end}}
  {{if not .Mine}}<p class="text-sm text-muted">Only the players of the match note secret objectives.</p>{{end}}
  {{with .Others}}<p class="text-sm text-muted">Noted already: {{join . ", "}}. What they noted stays hidden until the match ends.</p>{{end}}
  {{end}}
</section>
{{end}}
{{end}}
