{{define "title"}}Users · Administration · Battle Companies 2nd CE Manager{{end}}
{{define "content"}}
{{template "admin_head" .}}
<form role="search" action="/admin/users" method="get" class="mt-6 max-w-xl" hx-get="/admin/users" hx-trigger="input changed delay:300ms from:#user-q, submit" hx-target="#user-rows" hx-swap="innerHTML" hx-push-url="false">
  <div class="field"><label for="user-q">Search accounts</label>
    <input id="user-q" name="q" type="search" class="input" value="{{.Q}}" placeholder="Name or email" autocomplete="off"></div>
</form>
<div id="user-rows" class="mt-4" aria-live="polite">{{template "admin_user_rows" .List}}</div>
<p class="mt-6 max-w-xl text-sm text-muted">New people join through an invitation (see Invitations){{if .User.IsSuperuser}}, and a lost password is recovered with a recovery link made on the account's card{{end}}. The service sends no email, so links are handed over by hand. Superusers are set from the command line (<code>make grant</code>).</p>
{{end}}

{{define "admin_user_rows"}}
<p class="text-sm text-muted">{{.Total}} {{if eq .Total 1}}account{{else}}accounts{{end}}{{if .Q}} match “{{.Q}}”{{end}}</p>
<ul class="mt-3 space-y-3">{{template "admin_user_page" .}}</ul>
{{end}}

{{define "admin_user_page"}}
{{range .Rows}}{{template "admin_user_row" .}}{{else}}<li class="text-muted">No accounts match.</li>{{end}}
{{if .Next}}<li id="user-more"><button type="button" class="btn btn-secondary" hx-get="{{.NextURL}}" hx-target="#user-more" hx-swap="outerHTML" hx-push-url="false">Show more</button></li>{{end}}
{{end}}

{{/* One account. Takes an adminUserRow; the permission form swaps this row alone. */}}
{{define "admin_user_row"}}
{{$u := .U}}
<li id="user-{{$u.ID}}" class="card !p-4 {{if $u.Closed}}opacity-60{{end}}">
  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
    <h2 class="!text-lg break-words">{{if $u.DisplayName}}{{$u.DisplayName}}{{else}}Former player{{end}}</h2>
    {{if .Self}}<span class="badge badge-muted">You</span>{{end}}
    {{if $u.Closed}}<span class="badge badge-muted">Closed</span>
    {{else}}
      <span class="badge {{if eq $u.Role "superuser"}}badge-gold{{else if eq $u.Role "admin"}}{{else}}badge-muted{{end}}">{{$u.Role}}</span>
      {{if eq $u.Role "user"}}{{if $u.CanCreateCampaigns}}<span class="badge">Can create campaigns</span>{{end}}{{end}}
    {{end}}
  </div>
  {{if $u.Email}}<p class="break-all text-sm text-muted">{{$u.Email}}</p>{{end}}
  <p class="mt-1 text-sm text-muted">{{$u.Campaigns}} {{if eq $u.Campaigns 1}}campaign{{else}}campaigns{{end}} · account created {{fmtDateShort $u.CreatedAt}}</p>
  {{with .Notice}}<div class="alert alert-success mt-3" role="status">{{.}}</div>{{end}}
  {{if $u.Organises}}
  <details class="mt-3" {{if .HandoverOpen}}open{{end}}>
    <summary class="inline-flex min-h-10 cursor-pointer items-center rounded-md text-sm font-medium text-accent-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">Organises {{len $u.Organises}} campaign{{if ne (len $u.Organises) 1}}s{{end}}</summary>
    {{with .HandoverMsg}}<div class="alert {{if $.HandoverError}}alert-danger{{else}}alert-success{{end}} mt-2" role="{{if $.HandoverError}}alert{{else}}status{{end}}">{{.}}</div>{{end}}
    <ul class="mt-2 divide-y divide-line">
      {{range $u.Organises}}{{$c := .}}
      <li class="space-y-2 py-2">
        <p class="break-words"><span class="font-medium">{{.Name}}</span> <span class="badge badge-muted">{{.Status}}</span> <span class="text-sm text-muted">{{.Players}} player{{if ne .Players 1}}s{{end}}</span></p>
        {{with index $.Candidates $c.ID}}
        <form hx-post="/admin/users/{{$u.ID}}/handover" hx-target="#user-{{$u.ID}}" hx-swap="outerHTML" class="flex flex-wrap items-end gap-2">
          <input type="hidden" name="campaign" value="{{$c.ID}}"><input type="hidden" name="email" value="{{$u.Email}}">
          <div class="field min-w-0 flex-1"><label for="ho-{{$u.ID}}-{{$c.ID}}">New organiser</label>
            <select id="ho-{{$u.ID}}-{{$c.ID}}" name="organiser" class="input" required><option value="">Choose a player</option>{{range .}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select></div>
          <button class="btn btn-secondary">Hand over</button>
        </form>
        {{else}}<p class="text-sm text-muted">No other player has a company in this campaign yet.</p>{{end}}
      </li>
      {{end}}
    </ul>
  </details>
  {{end}}
  {{if .HasForm}}
  <details class="mt-3" {{if .Open}}open{{end}}>
    <summary class="inline-flex min-h-11 cursor-pointer items-center rounded-md text-sm font-medium text-accent-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">Edit permissions</summary>
    <form hx-post="/admin/users/{{$u.ID}}/permissions" hx-target="#user-{{$u.ID}}" hx-swap="outerHTML" class="mt-3 space-y-3" x-data="{ admin: {{if eq (print .Role) "admin"}}true{{else}}false{{end}}, can: {{if .CanCreate}}true{{else}}false{{end}} }" novalidate>
      <input type="hidden" name="email" value="{{$u.Email}}">
      {{with .Err}}<div class="alert alert-danger" role="alert">{{.}}</div>{{end}}
      {{if .CanAdministrator}}
      <label class="flex min-h-11 items-start gap-3 text-sm">
        <input type="checkbox" role="switch" name="role" value="admin" x-model="admin" {{if eq (print .Role) "admin"}}checked{{end}} class="mt-1 h-5 w-5 accent-[var(--accent)]">
        <span><span class="font-medium">Administrator</span><span class="block text-muted">Sees this section and makes organisers; also edits any match or aftermath.</span></span>
      </label>
      {{end}}
      <label class="flex min-h-11 items-start gap-3 text-sm">
        <input type="checkbox" role="switch" name="can_create" {{if or .CanCreate (eq (print .Role) "admin")}}checked{{end}} {{if eq (print .Role) "admin"}}disabled{{end}} :disabled="admin" :checked="admin || can" @change="can = $event.target.checked" class="mt-1 h-5 w-5 accent-[var(--accent)]">
        <span><span class="font-medium">Organiser</span><span class="block text-muted">Can create campaigns.{{if .CanAdministrator}} Administrators always can.{{end}}</span></span>
      </label>
      <button class="btn btn-primary">Save</button>
    </form>
  </details>
  {{else if .PermissionNote}}<p class="mt-3 text-sm text-muted">{{.PermissionNote}}</p>
  {{end}}
  {{if .CanRecover}}{{template "admin_recovery" .}}{{end}}
</li>
{{end}}

{{/* The recovery link card of one account (superusers). Takes the adminUserRow. */}}
{{define "admin_recovery"}}
{{$u := .U}}
<details class="mt-3" {{if or .RecoveryOpen .Link}}open{{end}} x-data="{ askNew: false, askRevoke: false }">
  <summary class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-md text-sm font-medium text-accent-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">Recovery link{{if .RecoveryPending}} <span class="badge badge-warn">Pending</span>{{end}}</summary>
  <div class="mt-2 space-y-3">
    {{with .RecoveryMsg}}<div class="alert {{if $.RecoveryErr}}alert-danger{{else}}alert-success{{end}}" role="{{if $.RecoveryErr}}alert{{else}}status{{end}}">{{.}}</div>{{end}}
    {{with .Link}}
    {{template "copy_message" (dict "ID" (print "recovery-" $u.ID) "Label" "Message to send" "Message" .Message "Hint" (print "Shown only now. Lost it? Revoke the link and make another. It expires " (fmtDate .Expires) "."))}}
    {{end}}
    {{with $u.Recovery}}
    <p class="text-sm text-muted" data-recovery-state="{{.State}}">
      {{if eq (print .State) "pending"}}Link pending until {{fmtDateTime .ExpiresAt}}, made by {{.CreatedByName}}.
      {{else if eq (print .State) "used"}}Link used on {{fmtDateTime .UsedAt}}.
      {{else if eq (print .State) "expired"}}Link expired on {{fmtDateTime .ExpiresAt}}.
      {{else if eq (print .State) "revoked"}}Link revoked by {{.RevokedByName}} on {{fmtDateTime .RevokedAt}}.
      {{else}}Link invalidated on {{fmtDateTime .InvalidatedAt}}:
        {{if eq (print .Reason) "login"}}the person signed in.{{else if eq (print .Reason) "access"}}the person opened the app.{{else if eq (print .Reason) "replaced"}}a newer link replaced it.{{else}}the account was closed.{{end}}
      {{end}}
    </p>
    {{else}}<p class="text-sm text-muted">No recovery link was made for this account.</p>{{end}}
    <form hx-post="/admin/users/{{$u.ID}}/recovery" hx-target="#user-{{$u.ID}}" hx-swap="outerHTML" class="space-y-2">
      <input type="hidden" name="email" value="{{$u.Email}}"><input type="hidden" name="nonce" value="{{.Nonce}}">
      <div class="field"><label for="rec-hours-{{$u.ID}}">Link works for</label>
        <select id="rec-hours-{{$u.ID}}" name="hours" class="input"><option value="24" selected>1 day</option><option value="72">3 days</option><option value="168">7 days</option></select></div>
      <button type="button" class="btn btn-secondary" x-show="!askNew" @click="askNew = true">Generate link</button>
      <div x-show="askNew" x-cloak class="alert alert-info space-y-2" role="alertdialog" aria-label="Generate a recovery link?">
        <p class="text-sm">This replaces any earlier link for {{if $u.DisplayName}}{{$u.DisplayName}}{{else}}this account{{end}}. Generate a link?</p>
        <div class="flex flex-wrap gap-2"><button type="button" class="btn btn-secondary" @click="askNew = false">Cancel</button><button class="btn btn-primary">Confirm</button></div>
      </div>
    </form>
    {{if .RecoveryPending}}
    <form hx-post="/admin/users/{{$u.ID}}/recovery/revoke" hx-target="#user-{{$u.ID}}" hx-swap="outerHTML" class="space-y-2">
      <input type="hidden" name="email" value="{{$u.Email}}"><input type="hidden" name="nonce" value="{{.Nonce}}">
      <button type="button" class="btn btn-secondary" x-show="!askRevoke" @click="askRevoke = true">Revoke link</button>
      <div x-show="askRevoke" x-cloak class="alert alert-info space-y-2" role="alertdialog" aria-label="Revoke the recovery link?">
        <p class="text-sm">The pending link stops working. Revoke it?</p>
        <div class="flex flex-wrap gap-2"><button type="button" class="btn btn-secondary" @click="askRevoke = false">Cancel</button><button class="btn btn-danger">Revoke</button></div>
      </div>
    </form>
    {{end}}
  </div>
</details>
{{end}}
